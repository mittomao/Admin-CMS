# ------------------------------------------------------------------------------
# TREECRAFT CMS - CẤU HÌNH PRODUCTION
# ------------------------------------------------------------------------------
APP_ENV=production
NODE_ENV=production
PORT=3000
APP_NAME="Treecraft Production"
APP_URL=https://example.com

# Cơ sở dữ liệu MongoDB Production (DEC-052)
MONGO_URI=mongodb+srv://prod_user:password@cluster.mongodb.net/prod_master?retryWrites=true&w=majority
MONGO_URI_WEB=mongodb+srv://prod_user:password@cluster.mongodb.net/prod_web?retryWrites=true&w=majority
ALLOW_REMOTE_DB_IN_DEV=false

# Mật mã phiên làm việc và mã hóa sao lưu an toàn (Tối thiểu 32 bytes Hex)
SESSION_SECRET=
BACKUP_ENCRYPTION_KEY=

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=treecraft_prod

