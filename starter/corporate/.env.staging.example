# ------------------------------------------------------------------------------
# TREECRAFT CMS - CẤU HÌNH STAGING
# ------------------------------------------------------------------------------
APP_ENV=staging
NODE_ENV=production
PORT=3000
APP_NAME="Treecraft Staging"
APP_URL=https://staging.example.com

# Cơ sở dữ liệu MongoDB Staging (DEC-052)
MONGO_URI=mongodb+srv://staging_user:password@cluster.mongodb.net/staging_master?retryWrites=true&w=majority
MONGO_URI_WEB=mongodb+srv://staging_user:password@cluster.mongodb.net/staging_web?retryWrites=true&w=majority
ALLOW_REMOTE_DB_IN_DEV=false

# Mật mã phiên làm việc và mã hóa sao lưu an toàn (Tối thiểu 32 bytes Hex)
SESSION_SECRET=
BACKUP_ENCRYPTION_KEY=

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=treecraft_staging

