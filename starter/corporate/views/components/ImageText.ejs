<section class="py-12 sm:py-16 lg:py-20 bg-slate-50/60 border-b border-slate-100">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col <%= (fields && fields.Alignment === 'right') ? 'md:flex-row-reverse' : 'md:flex-row' %> items-center gap-8 lg:gap-14">
      <% if (fields && fields.Image) { %>
        <div class="w-full md:w-1/2 flex justify-center">
          <div class="relative group max-w-lg w-full">
            <div class="absolute -inset-1 bg-gradient-to-r from-red-600 to-rose-600 rounded-2xl blur opacity-20 group-hover:opacity-30 transition duration-300"></div>
            <img 
              src="<%= fields.Image %>" 
              alt="<%= (fields && fields.Title) || '' %>" 
              class="relative w-full h-auto object-cover rounded-xl shadow-lg ring-1 ring-slate-900/5 transition duration-300"
              loading="lazy"
            />
          </div>
        </div>
      <% } %>
      <div class="w-full <%= (fields && fields.Image) ? 'md:w-1/2' : 'max-w-3xl mx-auto' %> flex flex-col justify-center">
        <% if (fields && fields.Title) { %>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 mb-4">
            <%= fields.Title %>
          </h2>
        <% } %>
        <% if (fields && fields.Body) { %>
          <div class="text-base sm:text-lg text-slate-600 leading-relaxed space-y-4">
            <%- fields.Body %>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</section>
