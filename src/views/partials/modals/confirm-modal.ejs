<!-- Global Destructive Action Confirmation Modal -->
<div class="modal modal-blur fade" id="adminConfirmModal" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
    <div class="modal-content shadow-2xl rounded-2xl border border-slate-200 overflow-hidden">
      <button type="button" class="btn-close absolute top-3 right-3 text-slate-400 hover:text-slate-600 transition-colors p-1 z-10" data-bs-dismiss="modal" aria-label="Close"></button>
      <div class="modal-status bg-rose-500 h-1.5 w-full"></div>
      <div class="modal-body text-center py-6 px-4 text-xs">
        <div class="w-12 h-12 rounded-full bg-rose-50 border border-rose-100 flex items-center justify-center text-rose-500 mx-auto mb-3">
          <i class="ti ti-alert-triangle text-2xl"></i>
        </div>
        <h3 id="adminConfirmModalTitle" class="fw-bold text-slate-800 text-base font-bold mb-1">Bạn có chắc chắn?</h3>
        <div class="text-slate-500 text-xs mt-1" id="adminConfirmModalMessage">
          Thao tác này sẽ xóa bản ghi và không thể hoàn tác nếu không có quyền khôi phục.
        </div>
      </div>
      <div class="modal-footer bg-slate-50/70 p-3 border-t border-slate-200">
        <div class="w-100 w-full">
          <div class="row g-2 flex items-center gap-2">
            <div class="col flex-1">
              <button type="button" class="btn btn-outline-secondary w-100 w-full btn-sm py-2 text-xs font-medium rounded-lg border border-slate-300 hover:bg-slate-100 text-slate-700 transition-all duration-150 active:scale-95" data-bs-dismiss="modal" id="adminConfirmModalCancelBtn">
                Hủy Bỏ
              </button>
            </div>
            <div class="col flex-1">
              <button type="button" class="btn btn-danger w-100 w-full btn-sm py-2 text-xs font-semibold rounded-lg shadow-xs hover:bg-rose-600 transition-all duration-150 active:scale-95" id="adminConfirmModalConfirmBtn">
                Đồng Ý Xóa
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

