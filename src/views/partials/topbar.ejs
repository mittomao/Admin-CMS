<header class="navbar navbar-expand-lg d-print-none border-bottom sticky-top bg-body shadow-sm">
  <div class="container-xl">
    <!-- Left: Brand, Waffle App Switcher, Breadcrumb -->
    <div class="d-flex align-items-center gap-3">
      <!-- Brand Logo -->
      <a href="/admin/launchpad" class="navbar-brand d-flex align-items-center gap-2 text-decoration-none">
        <div style="width: 28px; height: 28px; background-color: var(--sc-red); color: #ffffff; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 16px;">
          S
        </div>
        <span class="fw-bold fs-2 text-heading">Sitecore</span>
      </a>

      <!-- Direct Launchpad Link -->
      <a href="/admin/launchpad" class="btn btn-sm btn-ghost-primary d-none d-sm-inline-flex align-items-center gap-1 <%= typeof activeApp !== 'undefined' && activeApp === 'launchpad' ? 'active' : '' %>" title="Về Launchpad">
        <i class="ti ti-layout-grid fs-2"></i>
        <span>Launchpad</span>
      </a>

      <!-- Waffle Menu (App Switcher 9 Chấm) -->
      <div class="dropdown">
        <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-inline-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Menu ứng dụng nhanh">
          <i class="ti ti-apps fs-2"></i>
          <span class="d-none d-md-inline">Ứng Dụng</span>
        </button>
        <div class="dropdown-menu dropdown-menu-card p-3 shadow-lg" style="min-width: 340px;">
          <div class="row g-3">
            <!-- Group 1: Content -->
            <div class="col-12">
              <div class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.6875rem; letter-spacing: 0.08em;">
                Biên Tập Nội Dung
              </div>
              <div class="d-flex flex-column gap-1">
                <a href="/admin/content-editor" class="d-flex align-items-center gap-2 p-2 rounded text-decoration-none text-reset bg-hover-light">
                  <span class="avatar avatar-xs bg-primary-lt text-primary rounded"><i class="ti ti-article"></i></span>
                  <div>
                    <div class="fw-semibold small">Content Editor</div>
                    <div class="text-muted" style="font-size: 11px;">Quản lý cây nội dung và trường dữ liệu</div>
                  </div>
                </a>
                <a href="#" onclick="alert('Experience Editor sẽ có trong các giai đoạn tiếp theo'); return false;" class="d-flex align-items-center gap-2 p-2 rounded text-decoration-none text-reset bg-hover-light">
                  <span class="avatar avatar-xs bg-indigo-lt text-indigo rounded"><i class="ti ti-device-desktop"></i></span>
                  <div>
                    <div class="fw-semibold small">Experience Editor</div>
                    <div class="text-muted" style="font-size: 11px;">Soạn thảo WYSIWYG trực quan</div>
                  </div>
                </a>
              </div>
            </div>

            <!-- Group 2: Media & Workflow -->
            <div class="col-12 border-top pt-2">
              <div class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.6875rem; letter-spacing: 0.08em;">
                Tài Nguyên & Duyệt Bài
              </div>
              <div class="d-flex flex-column gap-1">
                <a href="#" onclick="alert('Media Library sẽ có trong GĐ 5'); return false;" class="d-flex align-items-center gap-2 p-2 rounded text-decoration-none text-reset bg-hover-light">
                  <span class="avatar avatar-xs bg-success-lt text-success rounded"><i class="ti ti-photo"></i></span>
                  <div>
                    <div class="fw-semibold small">Media Library</div>
                    <div class="text-muted" style="font-size: 11px;">Quản lý hình ảnh và tệp tài nguyên</div>
                  </div>
                </a>
                <a href="#" onclick="alert('Workbox sẽ có trong GĐ 7'); return false;" class="d-flex align-items-center gap-2 p-2 rounded text-decoration-none text-reset bg-hover-light">
                  <span class="avatar avatar-xs bg-warning-lt text-warning rounded"><i class="ti ti-inbox"></i></span>
                  <div>
                    <div class="fw-semibold small">Workbox</div>
                    <div class="text-muted" style="font-size: 11px;">Kiểm duyệt và phê duyệt workflow</div>
                  </div>
                </a>
              </div>
            </div>

            <!-- Group 3: System & Security -->
            <div class="col-12 border-top pt-2">
              <div class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.6875rem; letter-spacing: 0.08em;">
                Hệ Thống & Bảo Mật
              </div>
              <div class="d-flex flex-column gap-1">
                <a href="#" onclick="alert('Bảo mật người dùng sẽ có trong GĐ 6'); return false;" class="d-flex align-items-center gap-2 p-2 rounded text-decoration-none text-reset bg-hover-light">
                  <span class="avatar avatar-xs bg-purple-lt text-purple rounded"><i class="ti ti-users"></i></span>
                  <div>
                    <div class="fw-semibold small">Bảo Mật (Security)</div>
                    <div class="text-muted" style="font-size: 11px;">Quản lý User, Role và Item ACL</div>
                  </div>
                </a>
                <a href="#" onclick="alert('Control Panel sẽ có trong GĐ 10'); return false;" class="d-flex align-items-center gap-2 p-2 rounded text-decoration-none text-reset bg-hover-light">
                  <span class="avatar avatar-xs bg-danger-lt text-danger rounded"><i class="ti ti-settings"></i></span>
                  <div>
                    <div class="fw-semibold small">Control Panel</div>
                    <div class="text-muted" style="font-size: 11px;">Cấu hình hệ thống và Re-index</div>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Context Breadcrumb -->
      <div class="d-none d-lg-flex align-items-center border-start ps-3 text-muted small">
        <i class="ti ti-chevron-right me-1 fs-3"></i>
        <span class="fw-medium text-heading">
          <%= typeof activeApp !== 'undefined' && activeApp === 'content-editor' ? 'Content Editor' : 'Launchpad' %>
        </span>
      </div>
    </div>

    <!-- Right: Global Search, Theme Switcher, Notifications, User Menu -->
    <div class="navbar-nav flex-row align-items-center gap-2">
      <!-- Global Quick Search with Ctrl+K shortcut -->
      <div class="d-none d-md-block" style="width: 220px;">
        <div class="input-icon">
          <span class="input-icon-addon"><i class="ti ti-search"></i></span>
          <input type="text" id="globalSearchInput" class="form-control form-control-sm" placeholder="Tìm kiếm nhanh...">
          <span class="input-icon-addon end-0 pe-2" style="left: auto;">
            <kbd class="kbd kbd-sm" style="font-size: 10px; padding: 2px 4px; border: 1px solid var(--tblr-border-color); border-radius: 3px; background: var(--tblr-bg-surface-secondary); color: var(--tblr-muted);">Ctrl K</kbd>
          </span>
        </div>
      </div>

      <!-- Theme Switcher (Dark / Light Mode) -->
      <a href="javascript:void(0);" class="nav-link px-2 text-muted" data-theme-toggle title="Đổi giao diện Sáng / Tối">
        <i class="ti ti-sun theme-icon-sun fs-2"></i>
        <i class="ti ti-moon theme-icon-moon fs-2"></i>
      </a>

      <!-- Notifications Bell -->
      <div class="nav-item dropdown">
        <a href="javascript:void(0);" class="nav-link px-2 text-muted position-relative" data-bs-toggle="dropdown" aria-expanded="false" title="Thông báo hệ thống">
          <i class="ti ti-bell fs-2"></i>
          <span class="badge badge-sm bg-red badge-blink position-absolute top-0 end-0 mt-1 me-1 p-1 rounded-circle"></span>
        </a>
        <div class="dropdown-menu dropdown-menu-end dropdown-menu-card p-3 shadow-lg" style="width: 300px;">
          <div class="fw-bold mb-2 small text-heading">Thông Báo Mới</div>
          <div class="text-muted small py-3 text-center">
            <i class="ti ti-check text-success fs-1 mb-1 d-block"></i>
            Hệ thống đang hoạt động ổn định.
          </div>
        </div>
      </div>

      <!-- User Profile Dropdown -->
      <div class="nav-item dropdown ms-2">
        <a href="javascript:void(0);" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Mở thực đơn người dùng">
          <span class="avatar avatar-sm rounded-circle bg-primary-lt text-primary fw-bold">
            <%= typeof user !== 'undefined' && user && user.fullName ? user.fullName.charAt(0).toUpperCase() : 'A' %>
          </span>
          <div class="d-none d-xl-block ps-2">
            <div class="fw-semibold small"><%= typeof user !== 'undefined' && user && user.fullName ? user.fullName : 'System Administrator' %></div>
            <div class="text-muted" style="font-size: 11px;">
              <%= typeof user !== 'undefined' && user && user.roleNames && user.roleNames.length > 0 ? user.roleNames.join(', ') : 'Administrator' %>
            </div>
          </div>
        </a>
        <div class="dropdown-menu dropdown-menu-end shadow-sm">
          <div class="dropdown-header">Tài khoản</div>
          <a class="dropdown-item" href="/admin/launchpad"><i class="ti ti-layout-grid me-2 text-muted"></i> Launchpad</a>
          <a class="dropdown-item" href="/admin/content-editor"><i class="ti ti-article me-2 text-muted"></i> Content Editor</a>
          <div class="dropdown-divider"></div>
          <form action="/admin/logout" method="POST" class="m-0 p-0">
            <button type="submit" class="dropdown-item text-danger">
              <i class="ti ti-logout me-2"></i> Đăng xuất
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</header>
