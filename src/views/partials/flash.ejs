<% if (typeof flashMessages !== 'undefined' && flashMessages.length > 0) { %>
  <div class="sc-flash-container" style="padding: 10px 16px; background-color: #fef3c7; border-bottom: 1px solid #fde68a; color: #92400e;">
    <% flashMessages.forEach(function(msg) { %>
      <div class="sc-flash-message"><%= msg %></div>
    <% }); %>
  </div>
<% } %>

