<%
  const qi = locals.quickInfo || {};
  const currentItem = locals.item || locals.selectedItem || null;
  const currentTpl = locals.template || locals.activeTemplate || null;

  const itemId = qi.itemId || (currentItem && currentItem._id ? `{${currentItem._id.toString().toUpperCase()}}` : '{UNKNOWN}');
  const rawId = qi.rawId || (currentItem && currentItem._id ? currentItem._id.toString() : '');
  const itemName = qi.name || (currentItem ? currentItem.name : '');
  const itemPath = qi.path || (currentItem ? currentItem.path : '');

  const templateInfo = qi.template || {};
  const templatePath = templateInfo.path || (currentTpl ? currentTpl.path : '');
  const templateId = templateInfo.id || (currentTpl && currentTpl._id ? `{${currentTpl._id.toString().toUpperCase()}}` : '');
  const templateRawId = templateInfo.rawId || (currentTpl && currentTpl._id ? currentTpl._id.toString() : '');

  const createdFrom = qi.createdFrom || {};
  const createdFromText = createdFrom.displayText || '[unknown]';

  const itemOwner = qi.itemOwner || {};
  const itemOwnerText = itemOwner.displayText || '[unknown]';
%>
<div class="sc-quick-info mb-4 rounded-xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden shadow-xs" id="scQuickInfoSection">
  <!-- Section Bar Header (Treecraft Style) -->
  <div class="sc-section-bar" id="scQuickInfoToggle" role="button" tabindex="0" title="Click to collapse / expand" style="display: flex; align-items: center; justify-content: space-between; user-select: none; cursor: pointer; background-color: #334155; color: #ffffff; border-left: 4px solid #e03131; padding: 8px 16px; border-radius: 8px 8px 0 0; transition: background-color 0.15s ease;">
    <div class="sc-section-title" style="display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #ffffff; margin: 0;">
      <i class="ti ti-info-circle text-rose-400 text-base" style="color: #fb7185; font-size: 15px;"></i>
      <span>Quick Info</span>
    </div>
    <div class="sc-section-toggle" style="color: #cbd5e1; font-size: 14px; display: flex; align-items: center; transition: transform 0.2s ease;">
      <i class="ti ti-chevron-down text-sm" id="scQuickInfoChevron"></i>
    </div>
  </div>

  <!-- Section Body -->
  <div class="sc-quick-info-body" id="scQuickInfoBody" style="padding: 12px 18px; background-color: rgba(248, 250, 252, 0.7); font-size: 12px; display: flex; flex-direction: column; gap: 4px;">
    <!-- Row 1: Item ID -->
    <div class="sc-quick-info-row flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 py-1.5 border-b border-slate-200/60 dark:border-slate-800/80">
      <div class="sc-quick-info-label sm:w-28 text-slate-500 font-semibold flex-shrink-0">Item ID:</div>
      <div class="sc-quick-info-value font-mono flex items-center gap-2 text-slate-800 dark:text-slate-200">
        <span class="user-select-all" id="quickInfoItemIdVal"><%= itemId %></span>
        <button type="button" class="sc-copy-btn inline-flex items-center justify-center w-6 h-6 rounded border border-slate-300/80 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 shadow-2xs transition-all active:scale-90" style="padding: 0; min-width: 24px; min-height: 24px; max-width: 24px; max-height: 24px;" onclick="if(navigator.clipboard){navigator.clipboard.writeText('<%= itemId %>');}" title="Copy Item ID">
          <i class="ti ti-copy text-xs"></i>
        </button>
      </div>
    </div>

    <!-- Row 2: Item name -->
    <div class="sc-quick-info-row flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 py-1.5 border-b border-slate-200/60 dark:border-slate-800/80">
      <div class="sc-quick-info-label sm:w-28 text-slate-500 font-semibold flex-shrink-0">Item name:</div>
      <div class="sc-quick-info-value text-slate-800 dark:text-slate-200">
        <span class="font-mono font-medium"><%= itemName %></span>
      </div>
    </div>

    <!-- Row 3: Item path -->
    <div class="sc-quick-info-row flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 py-1.5 border-b border-slate-200/60 dark:border-slate-800/80">
      <div class="sc-quick-info-label sm:w-28 text-slate-500 font-semibold flex-shrink-0">Item path:</div>
      <div class="sc-quick-info-value font-mono flex items-center gap-2 text-slate-800 dark:text-slate-200 break-all">
        <span class="user-select-all" id="quickInfoItemPathVal"><%= itemPath %></span>
        <button type="button" class="sc-copy-btn inline-flex items-center justify-center w-6 h-6 rounded border border-slate-300/80 dark:border-slate-700 bg-white dark:bg-slate-800 hover:bg-slate-100 dark:hover:bg-slate-700 text-slate-500 hover:text-slate-800 dark:hover:text-slate-200 shadow-2xs transition-all active:scale-90 flex-shrink-0" style="padding: 0; min-width: 24px; min-height: 24px; max-width: 24px; max-height: 24px;" onclick="if(navigator.clipboard){navigator.clipboard.writeText('<%= itemPath %>');}" title="Copy Item Path">
          <i class="ti ti-copy text-xs"></i>
        </button>
      </div>
    </div>

    <!-- Row 4: Template -->
    <div class="sc-quick-info-row flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 py-1.5 border-b border-slate-200/60 dark:border-slate-800/80">
      <div class="sc-quick-info-label sm:w-28 text-slate-500 font-semibold flex-shrink-0">Template:</div>
      <div class="sc-quick-info-value font-mono flex items-center flex-wrap gap-1.5 text-slate-800 dark:text-slate-200">
        <% if (templateRawId) { %>
          <a href="/admin/content-editor/<%= templateRawId %>" class="sc-quick-info-link text-blue-600 dark:text-blue-400 hover:underline font-medium" data-template-id="<%= templateRawId %>" title="Navigate to template">
            <%= templatePath || '/root/templates/System/Template' %>
          </a>
          <span class="text-slate-400 text-[11px]">- <%= templateId %></span>
        <% } else { %>
          <span><%= templatePath || '[unknown]' %></span>
          <% if (templateId) { %><span class="text-slate-400 text-[11px]">- <%= templateId %></span><% } %>
        <% } %>
      </div>
    </div>

    <!-- Row 5: Created from -->
    <div class="sc-quick-info-row flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 py-1.5 border-b border-slate-200/60 dark:border-slate-800/80">
      <div class="sc-quick-info-label sm:w-28 text-slate-500 font-semibold flex-shrink-0">Created from:</div>
      <div class="sc-quick-info-value font-mono">
        <% if (createdFrom.rawId) { %>
          <a href="/admin/content-editor/<%= createdFrom.rawId %>" class="sc-quick-info-link text-blue-600 dark:text-blue-400 hover:underline font-medium" data-source-id="<%= createdFrom.rawId %>" title="Open source item">
            <%= createdFromText %>
          </a>
        <% } else { %>
          <span class="text-slate-400"><%= createdFromText %></span>
        <% } %>
      </div>
    </div>

    <!-- Row 6: Item owner -->
    <div class="sc-quick-info-row flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 py-1.5 border-b border-slate-200/60 dark:border-slate-800/80">
      <div class="sc-quick-info-label sm:w-28 text-slate-500 font-semibold flex-shrink-0">Item owner:</div>
      <div class="sc-quick-info-value font-mono text-slate-800 dark:text-slate-200">
        <span class="<%= itemOwnerText === '[unknown]' ? 'text-slate-400' : '' %>"><%= itemOwnerText %></span>
      </div>
    </div>

    <!-- Row 7: Database (GĐ 8.1) -->
    <div class="sc-quick-info-row flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 py-1.5 <%= qi.database === 'web' ? 'border-b border-slate-200/60 dark:border-slate-800/80' : '' %>">
      <div class="sc-quick-info-label sm:w-28 text-slate-500 font-semibold flex-shrink-0">Database:</div>
      <div class="sc-quick-info-value font-mono text-slate-800 dark:text-slate-200 flex items-center gap-2">
        <span class="badge <%= qi.database === 'web' ? 'bg-amber-100 text-amber-800 border-amber-300 dark:bg-amber-950 dark:text-amber-300' : 'bg-slate-100 text-slate-700 border-slate-300 dark:bg-slate-800 dark:text-slate-300' %> border text-[11px] font-bold">
          <%= qi.database || 'master' %>
        </span>
      </div>
    </div>

    <% if (qi.database === 'web') { %>
      <!-- Row 8: Published at -->
      <div class="sc-quick-info-row flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 py-1.5 border-b border-slate-200/60 dark:border-slate-800/80">
        <div class="sc-quick-info-label sm:w-28 text-slate-500 font-semibold flex-shrink-0">Published at:</div>
        <div class="sc-quick-info-value font-mono text-slate-800 dark:text-slate-200">
          <%= qi.publishedAt ? new Date(qi.publishedAt).toLocaleString('vi-VN') : '[unknown]' %>
        </div>
      </div>

      <!-- Row 9: Published by -->
      <div class="sc-quick-info-row flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 py-1.5 border-b border-slate-200/60 dark:border-slate-800/80">
        <div class="sc-quick-info-label sm:w-28 text-slate-500 font-semibold flex-shrink-0">Published by:</div>
        <div class="sc-quick-info-value font-mono text-slate-800 dark:text-slate-200">
          <%= qi.publishedBy || '[system]' %>
        </div>
      </div>

      <!-- Row 10: Source version -->
      <div class="sc-quick-info-row flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 py-1.5">
        <div class="sc-quick-info-label sm:w-28 text-slate-500 font-semibold flex-shrink-0">Source version:</div>
        <div class="sc-quick-info-value font-mono text-slate-800 dark:text-slate-200">
          <span class="badge bg-blue-50 text-blue-700 border border-blue-200 dark:bg-blue-950 dark:text-blue-300 font-bold text-[11px]">
            v<%= qi.sourceVersion || 1 %>
          </span>
        </div>
      </div>
    <% } %>
  </div>
</div>

<script>
  (function() {
    var toggle = document.getElementById('scQuickInfoToggle');
    var body = document.getElementById('scQuickInfoBody');
    if (!toggle || !body) return;

    var storageKey = 'sc_quickinfo_collapsed';
    try {
      var isCollapsed = localStorage.getItem(storageKey) === 'true';
      if (isCollapsed) {
        body.classList.add('d-none');
        toggle.classList.add('collapsed');
      }
    } catch (e) {
      // Ignore localStorage access errors
    }

    toggle.addEventListener('click', function() {
      var willCollapse = !body.classList.contains('d-none');
      if (willCollapse) {
        body.classList.add('d-none');
        toggle.classList.add('collapsed');
      } else {
        body.classList.remove('d-none');
        toggle.classList.remove('collapsed');
      }
      try {
        localStorage.setItem(storageKey, willCollapse ? 'true' : 'false');
      } catch (e) {
        // Ignore localStorage access errors
      }
    });

    // Handle template hyperlink click in tree without full reload if supported
    var tplLinks = document.querySelectorAll('.sc-quick-info-link[data-template-id], .sc-quick-info-link[data-source-id]');
    tplLinks.forEach(function(link) {
      link.addEventListener('click', function(e) {
        var targetId = this.getAttribute('data-template-id') || this.getAttribute('data-source-id');
        if (targetId && typeof window.activateTreeNodeById === 'function') {
          e.preventDefault();
          window.activateTreeNodeById(targetId);
        } else if (targetId && typeof window.navigateToItem === 'function') {
          e.preventDefault();
          window.navigateToItem(targetId, true);
        }
      });
    });
  })();
</script>
