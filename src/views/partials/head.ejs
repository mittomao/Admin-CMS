<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
<title><%= typeof title !== 'undefined' ? title : 'Sitecore Experience Management' %></title>

<!-- Anti-FOUC Theme Engine Script (Executes before DOM render to prevent white flash) -->
<script>
  (function () {
    var theme = localStorage.getItem('tablerTheme');
    if (!theme) {
      theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }
    document.documentElement.setAttribute('data-bs-theme', theme);
  })();
</script>

<!-- 1. Google Font Inter -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<!-- 2. Tabler Core CSS & Tabler Icons Webfont CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta20/dist/css/tabler.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@2.47.0/tabler-icons.min.css">

<!-- 3. Production Admin Custom Extensions -->
<link rel="stylesheet" href="/css/admin.css">
<link rel="stylesheet" href="/css/components.css">
<link rel="stylesheet" href="/css/presentation-details.css">

<!-- 4. CMS Icons Registry Client Library -->
<script src="/js/admin/icons.js"></script>
