<footer class="sc-taskbar">
  <div class="sc-taskbar-apps">
    <a href="/admin/launchpad" class="sc-taskbar-item <%= typeof activeApp !== 'undefined' && activeApp === 'launchpad' ? 'active' : '' %>" title="Launchpad">
      <i class="ti ti-layout-grid fs-3"></i>
      <span>Launchpad</span>
    </a>
    <a href="/admin/content-editor" class="sc-taskbar-item <%= typeof activeApp !== 'undefined' && activeApp === 'content-editor' ? 'active' : '' %>" title="Content Editor">
      <i class="ti ti-article fs-3"></i>
      <span>Content Editor</span>
    </a>
    <a href="/admin/template-manager" class="sc-taskbar-item <%= typeof activeApp !== 'undefined' && activeApp === 'template-manager' ? 'active' : '' %>" title="Template Manager">
      <i class="ti ti-layout-grid-add fs-3"></i>
      <span>Template Manager</span>
    </a>
    <a href="#" class="sc-taskbar-item <%= typeof activeApp !== 'undefined' && activeApp === 'media-library' ? 'active' : '' %>" onclick="alert('Media Library sẽ có trong GĐ 5'); return false;" title="Media Library">
      <i class="ti ti-photo fs-3"></i>
      <span class="d-none d-sm-inline">Media Library</span>
    </a>
    <a href="#" class="sc-taskbar-item <%= typeof activeApp !== 'undefined' && activeApp === 'workbox' ? 'active' : '' %>" onclick="alert('Workbox sẽ có trong GĐ 7'); return false;" title="Workbox">
      <i class="ti ti-inbox fs-3"></i>
      <span class="d-none d-sm-inline">Workbox</span>
    </a>
  </div>

  <div class="sc-taskbar-info d-none d-md-flex">
    <span>Sitecore XM Experience</span>
    <span class="badge bg-secondary-lt text-white" title="Connected Database">db: master</span>
  </div>
</footer>
