<div class="content-editor-container d-flex flex-column h-100" style="min-height: calc(100vh - 120px);">
  <!-- 1. Sitecore Data-driven Ribbon Toolbar -->
  <%- include('../partials/ribbon') %>

  <!-- 2. Main Content Editor Layout (Split Pane: Left Tree + Center Workspace) -->
  <div class="d-flex flex-fill overflow-hidden border-t border-slate-200 dark:border-slate-800">
    <!-- Left Pane: Content Tree Navigation -->
    <aside
      class="content-tree-pane bg-white dark:bg-slate-900 border-e border-slate-200 dark:border-slate-800 d-flex flex-column flex-shrink-0"
      id="contentTreePane"
      style="width: 320px; min-width: 260px; max-width: 500px;"
    >
      <!-- Tree Filter / Search Bar -->
      <div class="p-2.5 border-b border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900">
        <div class="input-icon relative">
          <span class="input-icon-addon">
            <i class="ti ti-search text-slate-400"></i>
          </span>
          <input
            type="text"
            class="form-control form-control-sm rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-xs transition-all duration-150 hover:border-slate-400 focus:border-sc-red focus:ring-2 focus:ring-sc-red/20 focus:outline-none"
            id="treeSearchInput"
            placeholder="Search items in tree..."
            autocomplete="off"
          />
          <span class="input-icon-addon cursor-pointer d-none end-0 pe-2" id="clearTreeSearch">
            <i class="ti ti-x text-slate-400 hover:text-slate-600 transition"></i>
          </span>
        </div>
      </div>

      <!-- Quick Action Toolbar for Tree -->
      <div class="px-3 py-1.5 border-b border-slate-100 dark:border-slate-800 bg-white dark:bg-slate-900 d-flex align-items-center justify-content-between small text-slate-500 select-none">
        <span class="font-bold text-uppercase font-monospace text-slate-400 dark:text-slate-500" style="font-size: 0.65rem; letter-spacing: 0.08em;">
          Content Tree
        </span>
        <div class="d-flex align-items-center gap-1">
          <button
            type="button"
            class="btn btn-sm btn-ghost-secondary p-1 rounded hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-90 transition-all duration-150"
            id="btnCollapseAllTree"
            title="Collapse All"
          >
            <i class="ti ti-arrows-collapse fs-3 text-slate-500"></i>
          </button>
          <button
            type="button"
            class="btn btn-sm btn-ghost-secondary p-1 rounded hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-90 transition-all duration-150"
            id="btnReloadTree"
            title="Reload Tree"
          >
            <i class="ti ti-refresh fs-3 text-slate-500"></i>
          </button>
        </div>
      </div>

      <!-- Search Results Dropdown List (Overlay when searching) -->
      <div id="treeSearchResults" class="list-group list-group-flush border-b border-slate-200 dark:border-slate-800 d-none overflow-auto shadow-md" style="max-height: 220px;"></div>

      <!-- Fancytree Container -->
      <div class="p-2 flex-fill overflow-auto tree-scrollable-container sc-scrollbar bg-white dark:bg-slate-900" id="fancytreeContainer">
        <div id="contentTree" class="fancytree-plain"></div>
      </div>

      <!-- Tree Footer Status -->
      <div class="p-2 px-3 border-t border-slate-100 dark:border-slate-800 bg-slate-50/70 dark:bg-slate-900 d-flex align-items-center justify-content-between text-slate-400 text-[11px] select-none">
        <span id="treeStatusText" class="font-medium">Ready</span>
        <% const isWebDb = typeof currentDb !== 'undefined' && currentDb === 'web'; %>
        <div class="dropdown">
          <button class="badge <%= isWebDb ? 'bg-amber-100 text-amber-800 border-amber-300 dark:bg-amber-950 dark:text-amber-300' : 'bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border-slate-300 dark:border-slate-700' %> font-monospace border text-[10px] dropdown-toggle cursor-pointer d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" id="treeDbSwitcherBtn">
            <i class="ti <%= isWebDb ? 'ti-world text-amber-600 dark:text-amber-400' : 'ti-database text-blue-600 dark:text-blue-400' %>"></i>
            <span><%= isWebDb ? 'Web (Read-Only)' : 'Master DB' %></span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end shadow-md rounded-lg text-xs py-1 border border-slate-200 dark:border-slate-800" style="min-width: 170px;">
            <li>
              <a class="dropdown-item d-flex align-items-center justify-content-between px-3 py-1.5 <%= !isWebDb ? 'active font-bold' : '' %>" href="javascript:void(0)" id="switchDbMasterLink">
                <span class="d-flex align-items-center gap-1.5"><i class="ti ti-database text-blue-500"></i> Master DB</span>
                <% if (!isWebDb) { %><i class="ti ti-check text-xs"></i><% } %>
              </a>
            </li>
            <li>
              <a class="dropdown-item d-flex align-items-center justify-content-between px-3 py-1.5 <%= isWebDb ? 'active font-bold' : '' %>" href="javascript:void(0)" id="switchDbWebLink">
                <span class="d-flex align-items-center gap-1.5"><i class="ti ti-world text-amber-500"></i> Web DB (Chỉ đọc)</span>
                <% if (isWebDb) { %><i class="ti ti-check text-xs"></i><% } %>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </aside>

    <!-- Center Workspace Pane: Breadcrumbs + View Mode + Form/Folder View -->
    <main class="content-workspace-pane flex-fill d-flex flex-column bg-slate-50/70 dark:bg-slate-950 overflow-hidden">
      <!-- Workspace Action Bar (Breadcrumbs + Mode Toggle) -->
      <div class="workspace-top-bar bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 px-4 py-2 d-flex align-items-center justify-content-between gap-2 flex-wrap shadow-2xs">
        <!-- Breadcrumb Path Trail -->
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb m-0 font-medium text-xs text-slate-500" id="workspaceBreadcrumb">
            <% if (breadcrumbs && breadcrumbs.length > 0) { %>
              <% breadcrumbs.forEach((bItem, bIdx) => { %>
                <% if (bIdx === breadcrumbs.length - 1) { %>
                  <li class="breadcrumb-item active fw-bold text-slate-900 dark:text-white" aria-current="page">
                    <%= bItem.displayName || bItem.name %>
                  </li>
                <% } else { %>
                  <li class="breadcrumb-item">
                    <a href="#" class="breadcrumb-jump-link text-slate-500 hover:text-sc-red dark:text-slate-400 dark:hover:text-sc-red text-decoration-none transition-colors duration-150" data-item-id="<%= bItem._id %>">
                      <%= bItem.displayName || bItem.name %>
                    </a>
                  </li>
                <% } %>
              <% }) %>
            <% } else { %>
              <li class="breadcrumb-item active text-slate-400">/sitecore</li>
            <% } %>
          </ol>
        </nav>

        <!-- View Mode Switcher (Content / Folder) -->
        <div class="d-flex align-items-center gap-1">
          <div class="btn-group btn-group-sm rounded-lg border border-slate-200 dark:border-slate-700 p-0.5 bg-slate-100 dark:bg-slate-800" role="group" aria-label="View Mode">
            <button
              type="button"
              class="btn btn-sm border-0 rounded-md active d-flex align-items-center gap-1.5 px-2.5 py-1 text-xs font-semibold active:scale-95 transition-all duration-150"
              id="btnModeContent"
              data-mode="content"
              title="Content Editing Form"
            >
              <i class="ti ti-forms"></i>
              <span>Content</span>
            </button>
            <button
              type="button"
              class="btn btn-sm border-0 rounded-md d-flex align-items-center gap-1.5 px-2.5 py-1 text-xs font-semibold active:scale-95 transition-all duration-150"
              id="btnModeFolder"
              data-mode="folder"
              title="Child Items Grid"
            >
              <i class="ti ti-layout-grid"></i>
              <span>Folder</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Workspace Body (Dynamic Fragment Content Swapped via AJAX) -->
      <div class="workspace-content-body flex-fill overflow-auto p-3" id="editorWorkspace">
        <% if (typeof isTemplate !== 'undefined' && isTemplate && typeof activeTemplate !== 'undefined' && activeTemplate) { %>
          <%- include('./template-workspace', {
            activeTemplate,
            resolvedTemplate: typeof resolvedTemplate !== 'undefined' ? resolvedTemplate : activeTemplate,
            usage: typeof usage !== 'undefined' ? usage : null,
            allTemplates: typeof allTemplates !== 'undefined' ? allTemplates : [],
            quickInfo: typeof quickInfo !== 'undefined' ? quickInfo : null
          }) %>
        <% } else if (selectedItem && typeof schemaData !== 'undefined' && schemaData) { %>
          <%- include('./item-form', {
            item: schemaData.item,
            template: schemaData.resolvedTemplate,
            breadcrumbs: breadcrumbs,
            currentLang: typeof currentLang !== 'undefined' ? currentLang : 'vi',
            currentVersion: typeof currentVersion !== 'undefined' ? currentVersion : 1,
            languagesList: schemaData.languagesList,
            versionsList: schemaData.versionsList,
            hasLanguage: schemaData.hasLanguage,
            hasVersion: schemaData.hasVersion,
            versionInfo: schemaData.versionInfo,
            componentTemplates: schemaData.componentTemplates || [],
            quickInfo: typeof quickInfo !== 'undefined' ? quickInfo : null,
            workflowStateInfo: typeof workflowStateInfo !== 'undefined' ? workflowStateInfo : null,
            availableCommands: typeof availableCommands !== 'undefined' ? availableCommands : [],
            isPublishedOnWeb: typeof isPublishedOnWeb !== 'undefined' ? isPublishedOnWeb : false,
            publishStatus: typeof publishStatus !== 'undefined' ? publishStatus : 'UNPUBLISHED'
          }) %>
        <% } else if (selectedItem) { %>
          <%- include('./item-form', {
            item: selectedItem,
            template: selectedItem.templateId,
            breadcrumbs: breadcrumbs,
            currentLang: typeof currentLang !== 'undefined' ? currentLang : 'vi',
            currentVersion: typeof currentVersion !== 'undefined' ? currentVersion : 1,
            componentTemplates: [],
            quickInfo: typeof quickInfo !== 'undefined' ? quickInfo : null,
            workflowStateInfo: typeof workflowStateInfo !== 'undefined' ? workflowStateInfo : null,
            availableCommands: typeof availableCommands !== 'undefined' ? availableCommands : [],
            isPublishedOnWeb: typeof isPublishedOnWeb !== 'undefined' ? isPublishedOnWeb : false,
            publishStatus: typeof publishStatus !== 'undefined' ? publishStatus : 'UNPUBLISHED'
          }) %>
        <% } else { %>
          <div class="empty py-5 text-center">
            <div class="empty-icon text-muted">
              <i class="ti ti-pointer fs-1"></i>
            </div>
            <p class="empty-title">No Item Selected</p>
            <p class="empty-subtitle text-muted">
              Select an item from the content tree on the left to view or edit its fields.
            </p>
          </div>
        <% } %>
      </div>
    </main>
  </div>
</div>

<!-- Modals for Ribbon Operations -->
<%- include('./modals/insert-modal') %>
<%- include('./modals/rename-modal') %>
<%- include('./modals/move-modal') %>
<%- include('./modals/delete-modal') %>
<%- include('./modals/add-version-modal') %>
<%- include('./modals/add-language-modal') %>
<%- include('./modals/delete-version-modal') %>
<%- include('./modals/dirty-confirm-modal') %>
<%- include('../admin/media/modals/media-picker-modal') %>
<%- include('../admin/content-editor/modals/item-picker-modal') %>
<!-- GĐ 8: Workflow & Publishing Modals -->
<%- include('./modals/publish-dialog') %>
<%- include('./modals/workflow-execute-modal') %>
<%- include('./modals/unpublish-modal') %>
<div id="dynamicModalsContainer"></div>
<div id="presentationModalContainer"></div>

<!-- Template Designer Modals -->
<%- include('../admin/templates/modals/template-modal', { activeTemplate: typeof activeTemplate !== 'undefined' ? activeTemplate : null }) %>
<%- include('../admin/templates/modals/section-modal') %>
<%- include('../admin/templates/modals/field-modal') %>
<%- include('../admin/templates/modals/preview-modal') %>

<!-- Pass Selected Item Initial ID and DB Context to Client Script -->
<script>
  window.__INITIAL_ITEM_ID__ = "<%= selectedItem ? selectedItem._id : '' %>";
  window.__CURRENT_DB__ = "<%= typeof currentDb !== 'undefined' ? currentDb : 'master' %>";
  window.__CAN_READ_WEB__ = <%= typeof canReadWeb !== 'undefined' ? canReadWeb : false %>;
</script>

<!-- External TinyMCE 6 Community Edition via CDN -->
<script src="https://cdn.jsdelivr.net/npm/tinymce@6.8.3/tinymce.min.js"></script>

<!-- SortableJS via CDN (for Presentation Details drag & drop) -->
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

<!-- External Fancytree Dependencies via CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/jquery.fancytree@2.38.3/dist/skin-win8/ui.fancytree.min.css">
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jquery.fancytree@2.38.3/dist/jquery.fancytree-all-deps.min.js"></script>

<!-- Reusable Presentation & Picker Scripts -->
<script src="/js/admin/item-picker.js"></script>
<script src="/js/admin/presentation-details.js"></script>
<script src="/js/admin/template-manager.js"></script>

<!-- Content Editor Client Script -->
<script type="module" src="/js/admin/content-editor.js?v=<%= Date.now() %>"></script>
