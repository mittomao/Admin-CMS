<div class="sc-editor-container">
  <!-- Ribbon Tabs -->
  <div class="sc-ribbon-tabs">
    <div class="sc-ribbon-tab active">Home</div>
    <div class="sc-ribbon-tab">Navigate</div>
    <div class="sc-ribbon-tab">Review</div>
    <div class="sc-ribbon-tab">Publish</div>
