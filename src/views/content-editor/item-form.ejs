<%
  const itemFields = item.fields instanceof Map ? Object.fromEntries(item.fields) : (item.fields || {});
  const sections = template && template.sections ? template.sections : [];
  const tplIcon = template && template.icon ? template.icon : 'ti ti-file-text';
  const tplName = template && template.displayName ? template.displayName : (template ? template.name : 'Unknown');
  const lang = typeof currentLang !== 'undefined' ? currentLang : 'vi';
  const ver = typeof currentVersion !== 'undefined' ? currentVersion : 1;
  const langs = typeof languagesList !== 'undefined' ? languagesList : [{ code: 'vi', name: 'Tiếng Việt', hasContent: true }];
  const vers = typeof versionsList !== 'undefined' ? versionsList : [{ version: 1 }];
%>
<form id="itemEditForm" class="d-flex flex-column h-100" data-item-id="<%= item._id %>" data-lang="<%= lang %>" data-version="<%= ver %>">
  <!-- Hidden Form Metadata -->
  <input type="hidden" name="id" id="formItemId" value="<%= item._id %>" />
  <input type="hidden" name="lang" id="formCurrentLang" value="<%= lang %>" />
  <input type="hidden" name="version" id="formCurrentVersion" value="<%= ver %>" />
  <input type="hidden" name="expectedUpdatedAt" id="formExpectedUpdatedAt" value="<%= item.updatedAt ? new Date(item.updatedAt).toISOString() : '' %>" />

  <!-- 1. Item Header Overview Bar with Language & Version Switchers -->
  <div class="card-header bg-white border-bottom py-2 px-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div class="d-flex align-items-center gap-2">
      <span class="avatar avatar-sm bg-blue-lt rounded">
        <i class="<%= tplIcon %> fs-2"></i>
      </span>
      <div>
        <div class="d-flex align-items-center gap-2">
          <h3 class="card-title m-0 fw-bold fs-3 text-dark" id="headerDisplayName">
            <%= item.displayName || item.name %>
          </h3>
          <span class="badge bg-secondary-lt font-monospace text-muted" id="headerTechnicalName">
            <%= item.name %>
          </span>
          <span class="badge bg-azure-lt">
            <i class="<%= tplIcon %> me-1"></i><%= tplName %>
          </span>
        </div>
        <div class="text-muted small mt-1 font-monospace" style="font-size: 0.75rem;">
          <i class="ti ti-folder me-1"></i><%= item.path %>
        </div>
      </div>
    </div>

    <!-- Right Controls: Language & Version Selector + Action Badges -->
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <!-- Language Switcher Dropdown -->
      <div class="dropdown">
        <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" id="langDropdownBtn">
          <i class="ti ti-world text-primary"></i>
          <span class="fw-semibold text-uppercase"><%= lang %></span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="min-width: 200px;">
          <li class="dropdown-header text-uppercase text-muted small py-1">Ngôn ngữ hệ thống</li>
          <% langs.forEach(l => { %>
            <li>
              <a class="dropdown-item d-flex align-items-center justify-content-between lang-switcher-item <%= l.code === lang ? 'active' : '' %>" 
                 href="#" data-lang-code="<%= l.code %>">
                <span class="d-flex align-items-center gap-2">
                  <i class="<%= l.icon || 'ti ti-world' %> text-muted"></i>
                  <span><%= l.name %> (<%= l.code %>)</span>
                </span>
                <% if (l.hasContent) { %>
                  <span class="badge bg-green-lt text-green small" title="Đã có nội dung"><i class="ti ti-check"></i></span>
                <% } else { %>
                  <span class="badge bg-secondary-lt text-muted small" title="Chưa có nội dung">Trống</span>
                <% } %>
              </a>
            </li>
          <% }) %>
          <li><hr class="dropdown-divider my-1"></li>
          <li>
            <a class="dropdown-item d-flex align-items-center gap-2 text-primary" href="#" id="btnHeaderAddLanguage">
              <i class="ti ti-world-plus"></i> Thêm ngôn ngữ mới...
            </a>
          </li>
        </ul>
      </div>

      <!-- Version Switcher Dropdown -->
      <div class="dropdown">
        <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-1" type="button" data-bs-toggle="dropdown" id="versionDropdownBtn">
          <i class="ti ti-stack-2 text-azure"></i>
          <span class="fw-semibold">v<%= ver %></span>
          <span class="text-muted small">(<%= vers.length %>)</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="min-width: 220px;">
          <li class="dropdown-header text-uppercase text-muted small py-1">Phiên bản (<%= lang.toUpperCase() %>)</li>
          <% if (vers.length === 0) { %>
            <li class="px-3 py-2 text-muted small">Chưa có phiên bản nào.</li>
          <% } else { %>
            <% vers.forEach(v => { %>
              <li>
                <a class="dropdown-item d-flex align-items-center justify-content-between version-switcher-item <%= v.version === ver ? 'active' : '' %>" 
                   href="#" data-version="<%= v.version %>">
                  <div>
                    <span class="fw-bold">Version <%= v.version %></span>
                    <% if (v.note) { %>
                      <div class="text-muted small text-truncate" style="max-width: 130px;"><%= v.note %></div>
                    <% } %>
                  </div>
                  <% if (v.version === ver) { %>
                    <span class="badge bg-primary text-white"><i class="ti ti-check"></i></span>
                  <% } %>
                </a>
              </li>
            <% }) %>
          <% } %>
          <li><hr class="dropdown-divider my-1"></li>
          <li>
            <a class="dropdown-item d-flex align-items-center gap-2 text-primary" href="#" id="btnHeaderAddVersion">
              <i class="ti ti-file-plus"></i> Thêm phiên bản mới...
            </a>
          </li>
          <li>
            <a class="dropdown-item d-flex align-items-center gap-2 text-secondary" href="#" id="btnHeaderViewHistory">
              <i class="ti ti-history"></i> Lịch sử phiên bản...
            </a>
          </li>
        </ul>
      </div>

      <!-- Quick Status Badges -->
      <span id="dirtyIndicator" class="badge bg-warning-lt d-none">
        <i class="ti ti-pencil me-1"></i>Unsaved Changes
      </span>

      <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-1" id="quickSaveBtn">
        <i class="ti ti-device-floppy"></i>
        <span>Save</span>
      </button>
    </div>
  </div>



  <!-- 2. Form Body (Scrollable Sections) -->
  <div class="card-body p-3 overflow-auto flex-fill" style="max-height: calc(100vh - 280px);">
    <% if (sections.length === 0 || sections.every(s => !s.fields || s.fields.length === 0)) { %>
      <div class="empty py-4 text-center">
        <div class="empty-icon text-muted">
          <i class="ti ti-folder-open fs-1"></i>
        </div>
        <p class="empty-title">No Editable Fields</p>
        <p class="empty-subtitle text-muted">
          This item template (<%= tplName %>) does not define any content fields. You can create subitems or organize nodes under it.
        </p>
        <div class="empty-action mt-3">
          <button type="button" class="btn btn-outline-primary btn-sm" id="btnSwitchToFolderView">
            <i class="ti ti-layout-grid me-1"></i>View Subitems
          </button>
        </div>
      </div>
    <% } else { %>
      <div class="accordion" id="itemSectionsAccordion">
        <% sections.forEach((section, sIndex) => { %>
          <% if (section.fields && section.fields.length > 0) { %>
            <div class="accordion-item mb-2 border rounded shadow-2xs">
              <h2 class="accordion-header" id="heading-<%= section._id %>">
                <button
                  class="accordion-button <%= sIndex === 0 ? '' : 'collapsed' %> py-2 px-3 fw-semibold bg-light-subtle"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#collapse-<%= section._id %>"
                  aria-expanded="<%= sIndex === 0 ? 'true' : 'false' %>"
                  aria-controls="collapse-<%= section._id %>"
                >
                  <i class="ti ti-layout-navbar-expand me-2 text-primary"></i>
                  <span><%= section.name %></span>
                  <span class="badge bg-secondary-lt ms-2 font-monospace" style="font-size: 0.65rem;">
                    <%= section.fields.length %> <%= section.fields.length === 1 ? 'field' : 'fields' %>
                  </span>
                </button>
              </h2>
              <div
                id="collapse-<%= section._id %>"
                class="accordion-collapse collapse <%= sIndex === 0 ? 'show' : '' %>"
                aria-labelledby="heading-<%= section._id %>"
              >
                <div class="accordion-body p-3">
                  <% section.fields.forEach(field => { %>
                    <%
                      const val = field.effectiveValue !== undefined
                        ? field.effectiveValue
                        : (itemFields[field._id ? field._id.toString() : ''] !== undefined
                            ? itemFields[field._id.toString()]
                            : itemFields[field.name]);
                      const fieldType = field.type;
                    %>
                    <% if (fieldType === 'Single-Line Text') { %>
                      <%- include('./fields/single-line-text', { field, value: val }) %>
                    <% } else if (fieldType === 'Multi-Line Text') { %>
                      <%- include('./fields/multi-line-text', { field, value: val }) %>
                    <% } else if (fieldType === 'Rich Text') { %>
                      <%- include('./fields/rich-text', { field, value: val }) %>
                    <% } else if (fieldType === 'Checkbox') { %>
                      <%- include('./fields/checkbox', { field, value: val }) %>
                    <% } else if (fieldType === 'Date') { %>
                      <%- include('./fields/date', { field, value: val }) %>
                    <% } else if (fieldType === 'Number') { %>
                      <%- include('./fields/number', { field, value: val }) %>
                    <% } else if (fieldType === 'Droplist') { %>
                      <%- include('./fields/droplist', { field, value: val }) %>
                    <% } else if (fieldType === 'Image') { %>
                      <%- include('./fields/image', { field, value: val }) %>
                    <% } else { %>
                      <%- include('./fields/single-line-text', { field, value: val }) %>
                    <% } %>
                  <% }) %>
                </div>
              </div>
            </div>
          <% } %>
        <% }) %>
      </div>
    <% } %>
  </div>

  <!-- 3. Form Footer Bar -->
  <div class="card-footer bg-light-subtle py-2 px-3 border-top d-flex align-items-center justify-content-between">
    <div class="text-muted small">
      <i class="ti ti-clock me-1"></i>Last updated:
      <span class="font-monospace" id="footerUpdatedAt">
        <%= item.updatedAt ? new Date(item.updatedAt).toLocaleString() : 'N/A' %>
      </span>
      <% if (typeof versionInfo !== 'undefined' && versionInfo && versionInfo.note) { %>
        <span class="ms-2 badge bg-azure-lt text-azure">
          <i class="ti ti-note me-1"></i><%= versionInfo.note %>
        </span>
      <% } %>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button type="button" class="btn btn-outline-secondary btn-sm" id="btnDiscardChanges">
        Discard
      </button>
      <button type="submit" class="btn btn-primary btn-sm d-flex align-items-center gap-1" id="btnFooterSave">
        <i class="ti ti-device-floppy"></i>
        <span>Save Changes</span>
      </button>
    </div>
  </div>
</form>
