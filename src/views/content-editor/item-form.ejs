<% const itemFields=item.fields instanceof Map ? Object.fromEntries(item.fields) : (item.fields || {}); const
  sections=template && template.sections ? template.sections : []; const resolvedIcon=typeof
  resolveItemIcon==='function' ? resolveItemIcon(item, template) : (item.icon || (template && template.icon) || 'page'
  ); const tplIcon=resolvedIcon; const tplName=template && template.displayName ? template.displayName : (template ?
  template.name : 'Unknown' ); const lang=typeof currentLang !=='undefined' ? currentLang : 'vi' ; const ver=typeof
  currentVersion !=='undefined' ? currentVersion : 1; const langs=typeof languagesList !=='undefined' ? languagesList :
  [{ code: 'vi' , name: 'Tiếng Việt' , hasContent: true }]; const vers=typeof versionsList !=='undefined' ? versionsList
  : [{ version: 1 }]; %>
  <form id="itemEditForm" class="d-flex flex-column h-100" data-item-id="<%= item._id %>" data-lang="<%= lang %>"
    data-version="<%= ver %>" data-db="<%= typeof currentDb !== 'undefined' ? currentDb : 'master' %>">
    <!-- Hidden Form Metadata -->
      <input type="hidden" name="id" id="formItemId" value="<%= item._id %>" />
      <input type="hidden" name="lang" id="formCurrentLang" value="<%= lang %>" />
      <input type="hidden" name="version" id="formCurrentVersion" value="<%= ver %>" />
      <input type="hidden" name="db" id="formCurrentDb"
        value="<%= typeof currentDb !== 'undefined' ? currentDb : 'master' %>" />
      <input type="hidden" name="expectedUpdatedAt" id="formExpectedUpdatedAt"
        value="<%= item.updatedAt ? new Date(item.updatedAt).toISOString() : '' %>" />

      <% if (typeof currentDb !=='undefined' && currentDb==='web' ) { %>
        <!-- Yellow/Amber Alert Banner for Web Read-Only Database (GĐ 8.1) -->
        <div
          class="alert alert-warning m-3 mb-0 border-amber-300 dark:border-amber-700/60 bg-amber-50 dark:bg-amber-950/60 text-amber-900 dark:text-amber-200 d-flex align-items-center justify-content-between p-3 rounded-xl shadow-xs"
          role="alert">
          <div class="d-flex align-items-center gap-2.5">
            <span
              class="w-8 h-8 rounded-lg bg-amber-100 dark:bg-amber-900/60 text-amber-700 dark:text-amber-300 d-flex align-items-center justify-content-center flex-shrink-0">
              <i class="ti ti-lock text-lg"></i>
            </span>
            <div>
              <span class="fw-bold fs-4">Đang xem WEB database (chỉ đọc)</span>
              <div class="small text-amber-800 dark:text-amber-300">
                Dữ liệu được nạp trực tiếp từ kho xuất bản công khai. Toàn bộ thao tác chỉnh sửa bị khóa.
                <% if (typeof isOrphan !=='undefined' && isOrphan) { %>
                  <span class="badge bg-danger text-white ms-1 font-monospace">MỒ CÔI (ORPHAN) - Đã xóa trên
                    Master</span>
                  <% } %>
              </div>
            </div>
          </div>
          <div class="d-flex align-items-center gap-2">
            <% if (typeof isOrphan !=='undefined' && isOrphan) { %>
              <button type="button" class="btn btn-sm btn-danger d-flex align-items-center gap-1.5 shadow-2xs font-bold" id="btnRemoveOrphanFromWeb" data-item-id="<%= item._id %>" data-item-name="<%= item.displayName || item.name %>">
                <i class="ti ti-trash"></i>
                <span>Gỡ khỏi Web</span>
              </button>
            <% } %>
            <a href="/admin/content-editor/<%= item._id %>?db=master&lang=<%= lang %>"
              class="btn btn-sm btn-outline-warning text-slate-800 dark:text-slate-100 bg-white dark:bg-slate-900 border-amber-300 dark:border-amber-700 font-bold d-flex align-items-center gap-1.5 shadow-2xs">
              <i class="ti ti-arrow-back-up"></i>
              <span>Open in Master</span>
            </a>
          </div>
        </div>
        <% } %>

          <!-- 1. Item Header Overview Bar with Language & Version Switchers -->
          <div
            class="card-header bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 py-2.5 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2 select-none shadow-2xs">
            <div class="d-flex align-items-center gap-2.5">
              <span
                class="avatar avatar-sm bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg d-flex align-items-center justify-content-center p-1 shadow-2xs">
                <%- typeof renderIconHtml==='function' ? renderIconHtml(resolvedIcon, 20) : `<img
                  src="/img/icons/page.svg" width="20" height="20" />` %>
              </span>
              <div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                  <h3 class="card-title m-0 fw-bold fs-3 text-slate-900 dark:text-white" id="headerDisplayName">
                    <%= item.displayName || item.name %>
                  </h3>
                  <span
                    class="badge bg-slate-100 dark:bg-slate-800 font-monospace text-slate-500 border border-slate-200 dark:border-slate-700 text-xs"
                    id="headerTechnicalName">
                    <%= item.name %>
                  </span>
                  <span
                    class="badge bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/50 text-xs">
                    <i class="<%= tplIcon %> me-1"></i>
                    <%= tplName %>
                  </span>
                  <% if (typeof workflowStateInfo !=='undefined' && workflowStateInfo && workflowStateInfo.state) { %>
                    <button type="button"
                      id="btnWorkflowTriggerBadge"
                      data-action="workflow:execute-command"
                      data-item-id="<%= item._id %>"
                      class="badge <%= workflowStateInfo.isFinal ? 'bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950 dark:text-emerald-400' : 'bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-950 dark:text-amber-400 hover:bg-amber-100 cursor-pointer' %> border text-xs d-inline-flex align-items-center gap-1 transition"
                      onclick="if(typeof window.openWorkflowExecuteModal === 'function') { window.openWorkflowExecuteModal('<%= item._id %>'); } else { document.getElementById('btn-workflow-execute')?.click(); }"
                      title="Quy trình: <%= workflowStateInfo.workflow.displayName || workflowStateInfo.workflow.name %> — Bấm để chuyển bước duyệt">
                      <i class="<%= workflowStateInfo.state.icon || 'ti ti-clock' %> me-1 pointer-events-none"></i>
                      <span class="pointer-events-none"><%= workflowStateInfo.state.displayName || workflowStateInfo.state.name %></span>
                      <% if (!workflowStateInfo.isFinal && typeof currentDb !== 'undefined' && currentDb !== 'web') { %>
                        <i class="ti ti-arrow-right text-[10px] text-amber-600 pointer-events-none"></i>
                        <span class="text-indigo-600 font-semibold underline ms-0.5 pointer-events-none">Chuyển bước...</span>
                      <% } %>
                    </button>
                  <% } %>
                    <% if (typeof isPublishedOnWeb !=='undefined' ) { %>
                      <span
                        class="badge <%= isPublishedOnWeb ? 'bg-emerald-600 text-white' : 'bg-slate-100 text-slate-500 border-slate-200 dark:bg-slate-800' %> border text-xs"
                        title="<%= isPublishedOnWeb ? 'Đã xuất bản trên Web' : 'Chưa xuất bản trên Web' %>">
                        <i class="ti <%= isPublishedOnWeb ? 'ti-world' : 'ti-world-off' %> me-1"></i>
                        <%= isPublishedOnWeb ? 'Live on Web' : 'Unpublished' %>
                      </span>
                    <% } %>
                    <% if (typeof currentDb !=='undefined' && currentDb==='web' ) { %>
                      <span class="badge bg-amber-500 text-white border-none text-xs"
                        title="Đang xem trên Web Database">
                        <i class="ti ti-world me-1"></i>Web Store (Chỉ đọc)
                      </span>
                    <% } else { %>
                      <!-- Publish Status Badge on Master -->
                      <% const pStatus=typeof publishStatus !=='undefined' ? publishStatus : 'UNPUBLISHED'; %>
                      <% if (pStatus==='PUBLISHED' ) { %>
                        <span class="badge bg-emerald-600 text-white text-xs border-none"
                          title="Đã xuất bản và khớp phiên bản">
                          <i class="ti ti-circle-check me-1"></i>Đã xuất bản
                        </span>
                      <% } else if (pStatus==='CHANGED' ) { %>
                        <span class="badge bg-amber-500 text-white text-xs border-none"
                          title="Đã sửa trên Master nhưng chưa xuất bản lại">
                          <i class="ti ti-refresh-alert me-1"></i>Có thay đổi chưa xuất bản
                        </span>
                      <% } else { %>
                        <span
                          class="badge bg-slate-200 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-xs border border-slate-300 dark:border-slate-700"
                          title="Chưa từng xuất bản sang Web">
                          <i class="ti ti-cloud-off me-1"></i>Chưa xuất bản
                        </span>
                      <% } %>
                    <% } %>
                </div>
                <div class="text-slate-400 dark:text-slate-500 small mt-0.5 font-monospace text-xs">
                  <i class="ti ti-folder me-1"></i>
                  <%= item.path %>
                </div>
              </div>
            </div>

            <!-- Right Controls: Language & Version Selector + Action Badges -->
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <!-- Language Switcher Dropdown -->
              <div class="dropdown">
                <button
                  class="btn btn-sm bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 dropdown-toggle d-flex align-items-center gap-1.5 px-2.5 py-1 rounded-lg shadow-2xs active:scale-95 transition-all duration-150"
                  type="button" data-bs-toggle="dropdown" id="langDropdownBtn">
                  <i class="ti ti-world text-primary"></i>
                  <span class="fw-bold text-uppercase text-slate-800 dark:text-slate-100">
                    <%= lang %>
                  </span>
                </button>
                <ul
                  class="dropdown-menu dropdown-menu-end shadow-lg rounded-xl border border-slate-200 dark:border-slate-800"
                  style="min-width: 200px;">
                  <li class="dropdown-header text-uppercase text-muted small py-1 font-bold">Ngôn ngữ hệ thống</li>
                  <% langs.forEach(l=> { %>
                    <li>
                      <a class="dropdown-item d-flex align-items-center justify-content-between lang-switcher-item transition-colors px-3 py-1.5 <%= l.code === lang ? 'active font-bold' : '' %>"
                        href="#" data-lang-code="<%= l.code %>">
                        <span class="d-flex align-items-center gap-2">
                          <i class="<%= l.icon || 'ti ti-world' %> text-muted"></i>
                          <span>
                            <%= l.name %> (<%= l.code %>)
                          </span>
                        </span>
                        <% if (l.hasContent) { %>
                          <span class="badge bg-green-lt text-green small" title="Đã có nội dung"><i
                              class="ti ti-check"></i></span>
                          <% } else { %>
                            <span class="badge bg-secondary-lt text-muted small" title="Chưa có nội dung">Trống</span>
                            <% } %>
                      </a>
                    </li>
                    <% }) %>
                    <% if (typeof currentDb==='undefined' || currentDb==='master' ) { %>
                      <li>
                        <hr class="dropdown-divider my-1">
                      </li>
                      <li>
                        <a class="dropdown-item d-flex align-items-center gap-2 text-primary font-medium" href="#"
                          id="btnHeaderAddLanguage">
                          <i class="ti ti-world-plus"></i> Thêm ngôn ngữ mới...
                        </a>
                      </li>
                    <% } %>
                </ul>
              </div>

              <!-- Version Switcher Dropdown -->
              <div class="dropdown">
                <button
                  class="btn btn-sm bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-50 dark:hover:bg-slate-700 dropdown-toggle d-flex align-items-center gap-1.5 px-2.5 py-1 rounded-lg shadow-2xs active:scale-95 transition-all duration-150"
                  type="button" data-bs-toggle="dropdown" id="versionDropdownBtn">
                  <i class="ti ti-stack-2 text-azure"></i>
                  <span class="fw-bold text-slate-800 dark:text-slate-100">v<%= ver %></span>
                  <span class="text-slate-500 dark:text-slate-400 small">(<%= vers.length %>)</span>
                </button>
                <ul
                  class="dropdown-menu dropdown-menu-end shadow-lg rounded-xl border border-slate-200 dark:border-slate-800"
                  style="min-width: 220px;">
                  <li class="dropdown-header text-uppercase text-muted small py-1 font-bold">Phiên bản (<%=
                      lang.toUpperCase() %>)</li>
                  <% if (vers.length===0) { %>
                    <li class="px-3 py-2 text-muted small">Chưa có phiên bản nào.</li>
                    <% } else { %>
                      <% vers.forEach(v=> { %>
                        <li>
                          <a class="dropdown-item d-flex align-items-center justify-content-between version-switcher-item transition-colors px-3 py-1.5 <%= v.version === ver ? 'active font-bold' : '' %>"
                            href="#" data-version="<%= v.version %>">
                            <div>
                              <span class="fw-bold">Version <%= v.version %></span>
                              <% if (v.note) { %>
                                <div class="text-muted small text-truncate" style="max-width: 130px;">
                                  <%= v.note %>
                                </div>
                                <% } %>
                            </div>
                            <% if (v.version===ver) { %>
                              <span class="badge bg-primary text-white"><i class="ti ti-check"></i></span>
                              <% } %>
                          </a>
                        </li>
                        <% }) %>
                      <% } %>
                      <li>
                        <hr class="dropdown-divider my-1">
                      </li>
                      <% if (typeof currentDb==='undefined' || currentDb==='master' ) { %>
                        <li>
                          <a class="dropdown-item d-flex align-items-center gap-2 text-primary font-medium"
                            href="#" id="btnHeaderAddVersion">
                            <i class="ti ti-file-plus"></i> Thêm phiên bản mới...
                          </a>
                        </li>
                      <% } %>
                      <li>
                        <a class="dropdown-item d-flex align-items-center gap-2 text-secondary font-medium"
                          href="#" id="btnHeaderViewHistory">
                          <i class="ti ti-history"></i> Lịch sử phiên bản...
                        </a>
                      </li>
                </ul>
              </div>

              <!-- Quick Status Badges -->
              <span id="dirtyIndicator"
                class="badge bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-400 border border-amber-300 dark:border-amber-800 d-none text-xs">
                <i class="ti ti-pencil me-1"></i>Unsaved Changes
              </span>

              <!-- Preview & Public Site Links (GĐ 10) -->
              <a href="/admin/preview?id=<%= item._id %>&lang=<%= (typeof currentLang !== 'undefined' ? currentLang : 'vi') %>"
                target="_blank"
                class="btn btn-sm btn-ghost-secondary border border-slate-200 dark:border-slate-700 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition d-flex align-items-center gap-1.5 px-2.5 py-1"
                title="Xem trước trang với dữ liệu Master">
                <i class="ti ti-eye text-sm"></i>
                <span class="d-none d-md-inline text-xs">Preview</span>
              </a>

              <% const publicSlug=item.path==='/sitecore/content/Home' ? '' :
                item.name.toLowerCase().replace(/\s+/g, '-' ); const publicUrl='/' + publicSlug; %>
                <a href="<%= publicUrl %>" target="_blank"
                  class="btn btn-sm btn-ghost-secondary border border-slate-200 dark:border-slate-700 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition d-flex align-items-center gap-1.5 px-2.5 py-1"
                  title="Mở trang đã publish trên Public Site">
                  <i class="ti ti-external-link text-sm"></i>
                  <span class="d-none d-md-inline text-xs">Public Site</span>
                </a>

                <% if (typeof currentDb !=='undefined' && currentDb==='web' ) { %>
                  <!-- Web Mode: Open in Master Button -->
                  <a href="/admin/content-editor/<%= item._id %>?db=master&lang=<%= lang %>"
                    class="btn btn-sm btn-primary bg-blue-600 hover:bg-blue-700 text-white rounded-lg shadow-sm d-flex align-items-center gap-1.5 px-3 py-1 font-semibold"
                    title="Mở item này trên Master Database để chỉnh sửa">
                    <i class="ti ti-database"></i>
                    <span>Open in Master</span>
                  </a>
                  <% } else { %>
                    <!-- Master Mode: View in Web Button if published -->
                    <% if (typeof isPublishedOnWeb !=='undefined' && isPublishedOnWeb) { %>
                      <a href="/admin/content-editor/<%= item._id %>?db=web&lang=<%= lang %>"
                        class="btn btn-sm btn-ghost-secondary border border-slate-200 dark:border-slate-700 rounded-lg text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition d-flex align-items-center gap-1.5 px-2.5 py-1"
                        title="Xem item này trên Web Database (Chỉ đọc)">
                        <i class="ti ti-world text-sm text-amber-500"></i>
                        <span class="d-none d-md-inline text-xs">View in Web</span>
                      </a>
                      <% } %>
                        <button type="button"
                          class="btn btn-sm btn-primary bg-sc-red hover:bg-sc-red-hover active:bg-red-800 border-none font-bold text-white rounded-lg shadow-sm hover:shadow active:scale-95 transition-all duration-150 d-flex align-items-center gap-1.5 px-3 py-1 cursor-pointer"
                          id="quickSaveBtn">
                          <i class="ti ti-device-floppy"></i>
                          <span>Save</span>
                        </button>
                        <% } %>
            </div>
          </div>



          <!-- 2. Form Body (Scrollable Sections) -->
          <div class="card-body p-3 overflow-auto flex-fill" style="max-height: calc(100vh - 280px);">
            <fieldset class="border-0 p-0 m-0 card-body p-3 overflow-auto flex-fill" style="max-height: calc(100vh - 280px);" <%= (typeof currentDb !== 'undefined' && currentDb === 'web') ? 'disabled' : '' %>>
              <!-- Quick Info Section (DEC-037 / GĐ 6.3) -->
              <%- include('../partials/quick-info', { quickInfo: locals.quickInfo, item: locals.item, template:
                locals.template }) %>

                <% if (tplName==='Image' || tplName==='File' ) { %>
                  <% const shared=item.sharedFields instanceof Map ? Object.fromEntries(item.sharedFields) :
                    (item.sharedFields || {}); const isImg=tplName==='Image' ; const fileUrl=shared.secureUrl ||
                    itemFields.secureUrl || '' ; const thumbUrl=shared.thumbnailUrl || fileUrl; const width=shared.width
                    || itemFields.width; const height=shared.height || itemFields.height; const fileSize=shared.fileSize
                    || itemFields.fileSize; const format=(shared.format || shared.extension || itemFields.extension
                    || '' ).toUpperCase(); const baseThumb=thumbUrl || fileUrl; const cbTs=item.updatedAt ? new
                    Date(item.updatedAt).getTime() : '' ; const previewImgSrc=baseThumb && cbTs ?
                    `${baseThumb}${baseThumb.includes('?') ? '&' : '?' }_t=${cbTs}` : baseThumb; %>
                    <div class="card mb-3 border border-azure-subtle bg-azure-lt shadow-2xs">
                      <div class="card-body p-3">
                        <div class="row align-items-center g-3">
                          <div class="col-auto">
                            <div
                              class="border rounded bg-white p-1 d-flex align-items-center justify-content-center shadow-xs cursor-pointer js-media-upload-dropzone"
                              style="width: 140px; height: 140px; overflow: hidden;"
                              title="<%= fileUrl ? 'Click to replace file' : 'Click to upload file' %>">
                              <% if (isImg && fileUrl) { %>
                                <img src="<%= previewImgSrc %>" alt="<%= item.displayName %>"
                                  class="img-fluid object-cover rounded" style="max-height: 100%; max-width: 100%;"
                                  onerror="if(this.src!=='<%= fileUrl %>' && '<%= fileUrl %>'){this.src='<%= fileUrl %>';}else{this.onerror=null;this.parentElement.innerHTML='<div class=\'text-center text-muted\'><i class=\'ti ti-photo-off fs-1 text-secondary\'></i><div class=\'small mt-1\'>Preview unavailable</div></div>';}" />
                                <% } else { %>
                                  <div class="text-center text-muted p-2">
                                    <i
                                      class="ti <%= isImg ? 'ti-photo-up text-azure' : 'ti-file-upload text-primary' %> fs-1"></i>
                                    <div class="small fw-bold text-uppercase mt-1">
                                      <%= fileUrl ? (format || 'FILE' ) : 'CHỌN TỆP' %>
                                    </div>
                                    <div class="small text-muted" style="font-size: 0.68rem;">
                                      <%= fileUrl ? '' : 'Bấm để tải lên' %>
                                    </div>
                                  </div>
                                  <% } %>
                            </div>
                          </div>
                          <div class="col">
                            <div class="d-flex align-items-center gap-2 mb-1">
                              <span class="badge bg-primary text-white">
                                <%= format || (isImg ? 'IMAGE' : 'FILE' ) %>
                              </span>
                              <% if (width && height) { %>
                                <span class="badge bg-secondary-lt font-monospace">
                                  <%= width %> &times; <%= height %> px
                                </span>
                                <% } %>
                                  <% if (fileSize) { %>
                                    <span class="badge bg-secondary-lt">
                                      <%= (fileSize / 1024).toFixed(1) %> KB
                                    </span>
                                    <% } %>
                            </div>
                            <div class="text-truncate font-monospace small text-muted mb-2" title="<%= fileUrl %>">
                              <i class="ti ti-link me-1"></i>
                              <%= fileUrl || 'No Cloudinary URL (Tệp chưa được tải lên)' %>
                            </div>
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                              <% if (fileUrl) { %>
                                <a href="<%= fileUrl %>" target="_blank" download class="btn btn-sm btn-white">
                                  <i class="ti ti-download me-1"></i>Download
                                </a>
                                <button type="button" class="btn btn-sm btn-white js-btn-copy-url"
                                  data-url="<%= fileUrl %>"
                                  onclick="navigator.clipboard.writeText('<%= fileUrl %>'); alert('Đã sao chép URL!');">
                                  <i class="ti ti-copy me-1"></i>Copy URL
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-primary" id="btnReplaceMediaAsset"
                                  data-media-id="<%= item._id %>">
                                  <i class="ti ti-refresh me-1"></i>Replace File
                                </button>
                                <% } else { %>
                                  <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-1"
                                    id="btnReplaceMediaAsset" data-media-id="<%= item._id %>">
                                    <i class="ti ti-upload"></i>
                                    <span>Tải lên <%= isImg ? 'Hình ảnh' : 'Tệp tin' %></span>
                                  </button>
                                  <% } %>
                                    <input type="file" id="mediaAssetFileInput" class="d-none"
                                      accept="<%= isImg ? 'image/*' : '*/*' %>" />
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <% } %>

                      <% if (sections.length===0 || sections.every(s=> !s.fields || s.fields.length === 0)) { %>
                        <div class="empty py-4 text-center">
                          <div class="empty-icon text-muted">
                            <i class="ti ti-folder-open fs-1"></i>
                          </div>
                          <p class="empty-title">No Editable Fields</p>
                          <p class="empty-subtitle text-muted">
                            This item template (<%= tplName %>) does not define any content fields. You can create
                              subitems or organize nodes under it.
                          </p>
                          <div class="empty-action mt-3">
                            <button type="button" class="btn btn-outline-primary btn-sm" id="btnSwitchToFolderView">
                              <i class="ti ti-layout-grid me-1"></i>View Subitems
                            </button>
                          </div>
                        </div>
                        <% } else { %>
                          <div class="accordion" id="itemSectionsAccordion">
                            <% sections.forEach((section, sIndex)=> { %>
                              <% if (section.fields && section.fields.length> 0) { %>
                                <div
                                  class="accordion-item mb-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden shadow-2xs">
                                  <h2 class="accordion-header" id="heading-<%= section._id %>">
                                    <button
                                      class="accordion-button <%= sIndex === 0 ? '' : 'collapsed' %> py-2.5 px-4 font-bold text-xs bg-slate-50/80 dark:bg-slate-800/60 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 transition-colors"
                                      type="button" data-bs-toggle="collapse"
                                      data-bs-target="#collapse-<%= section._id %>"
                                      aria-expanded="<%= sIndex === 0 ? 'true' : 'false' %>"
                                      aria-controls="collapse-<%= section._id %>">
                                      <% if (section.origin && section.origin.isComponent) { %>
                                        <i class="ti ti-components me-2 text-purple-600 dark:text-purple-400 fs-3"></i>
                                        <span>
                                          <%= section.displayName || section.name %>
                                        </span>
                                        <span
                                          class="badge bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-900/50 ms-2 font-medium"
                                          title="Trường được tự động suy ra từ rendering component">
                                          <i class="ti ti-puzzle me-1"></i>từ rendering <%= section.origin.renderingName
                                            || section.name %>
                                        </span>
                                        <% } else { %>
                                          <i class="ti ti-layout-navbar-expand me-2 text-primary fs-3"></i>
                                          <span>
                                            <%= section.displayName || section.name %>
                                          </span>
                                          <% } %>
                                            <span
                                              class="badge bg-slate-100 dark:bg-slate-800 text-slate-500 border border-slate-200 dark:border-slate-700 ms-2 font-monospace"
                                              style="font-size: 0.65rem;">
                                              <%= section.fields.length %>
                                                <%= section.fields.length===1 ? 'field' : 'fields' %>
                                            </span>
                                    </button>
                                  </h2>
                                  <div id="collapse-<%= section._id %>"
                                    class="accordion-collapse collapse <%= sIndex === 0 ? 'show' : '' %>"
                                    aria-labelledby="heading-<%= section._id %>">
                                    <div class="accordion-body p-4 bg-white dark:bg-slate-900">
                                      <% section.fields.forEach(field=> { %>
                                        <% const val=field.effectiveValue !==undefined ? field.effectiveValue :
                                          (itemFields[field._id ? field._id.toString() : '' ] !==undefined ?
                                          itemFields[field._id.toString()] : itemFields[field.name]); const
                                          fieldType=field.type; %>
                                          <% if (field.name==='componentTemplate' ||
                                            field.source==='/sitecore/templates/Feature/Components' ) { %>
                                            <div class="mb-3 field-container" data-field-name="<%= field.name %>"
                                              data-field-id="<%= field._id %>">
                                              <%- include('./fields/field-header', { field }) %>
                                                <div class="input-group">
                                                  <span class="input-group-text bg-purple-lt text-purple">
                                                    <i class="ti ti-puzzle"></i>
                                                  </span>
                                                  <select class="form-select item-field-input"
                                                    name="fields[<%= field.name %>]" <%=field.required ? 'required' : ''
                                                    %>>
                                                    <option value="">-- Chọn Component Template --</option>
                                                    <% (typeof componentTemplates !=='undefined' && componentTemplates ?
                                                      componentTemplates : []).forEach(ct=> { %>
                                                      <option value="<%= ct._id %>" <%=String(val)===String(ct._id)
                                                        ? 'selected' : '' %>>
                                                        <%= ct.displayName || ct.name %> (<%= ct.name %>)
                                                      </option>
                                                      <% }) %>
                                                  </select>
                                                </div>
                                                <% if (field.helpText) { %>
                                                  <div class="form-hint text-muted mt-1"><i
                                                      class="ti ti-info-circle me-1"></i>
                                                    <%= field.helpText %>
                                                  </div>
                                                  <% } %>
                                                    <div class="invalid-feedback"></div>
                                            </div>
                                            <% } else if (fieldType==='Single-Line Text' ) { %>
                                              <%- include('./fields/single-line-text', { field, value: val }) %>
                                                <% } else if (fieldType==='Multi-Line Text' ) { %>
                                                  <%- include('./fields/multi-line-text', { field, value: val }) %>
                                                    <% } else if (fieldType==='Rich Text' ) { %>
                                                      <%- include('./fields/rich-text', { field, value: val }) %>
                                                        <% } else if (fieldType==='Checkbox' ) { %>
                                                          <%- include('./fields/checkbox', { field, value: val }) %>
                                                            <% } else if (fieldType==='Date' ) { %>
                                                              <%- include('./fields/date', { field, value: val }) %>
                                                                <% } else if (fieldType==='Number' ) { %>
                                                                  <%- include('./fields/number', { field, value: val })
                                                                    %>
                                                                    <% } else if (fieldType==='Droplist' ) { %>
                                                                      <%- include('./fields/droplist', { field, value:
                                                                        val }) %>
                                                                        <% } else if (fieldType==='Image' ) { %>
                                                                          <%- include('./fields/image', { field, value:
                                                                            val }) %>
                                                                            <% } else { %>
                                                                              <%- include('./fields/single-line-text', {
                                                                                field, value: val }) %>
                                                                                <% } %>
                                                                                  <% }) %>
                                    </div>
                                  </div>
                                </div>
                                <% } %>
                                  <% }) %>
                          </div>
                          <% } %>
          </div>
          </fieldset>

          <!-- 3. Form Footer Bar -->
          <div
            class="card-footer bg-slate-50 dark:bg-slate-900 py-2.5 px-4 border-t border-slate-200 dark:border-slate-800 d-flex align-items-center justify-content-between select-none">
            <div class="text-slate-500 text-xs d-flex align-items-center flex-wrap gap-2">
              <span>
                <i class="ti ti-clock me-1 text-slate-400"></i>Last updated:
                <span class="font-monospace font-medium text-slate-700 dark:text-slate-300" id="footerUpdatedAt">
                  <%= item.updatedAt ? new Date(item.updatedAt).toLocaleString() : 'N/A' %>
                </span>
              </span>
              <% if (typeof versionInfo !=='undefined' && versionInfo && versionInfo.note) { %>
                <span
                  class="badge bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/50">
                  <i class="ti ti-note me-1"></i>
                  <%= versionInfo.note %>
                </span>
                <% } %>
            </div>
            <div class="d-flex align-items-center gap-2">
              <% if (typeof currentDb !=='undefined' && currentDb==='web' ) { %>
                <span class="text-slate-400 dark:text-slate-500 text-xs italic">
                  <i class="ti ti-lock me-1"></i>Web database là kho dữ liệu chỉ đọc
                </span>
              <% } else { %>
                <button type="button"
                  class="btn btn-outline-secondary btn-sm px-3 py-1 rounded-lg border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-95 transition-all duration-150"
                  id="btnDiscardChanges">
                  Discard
                </button>
                <button type="submit"
                  class="btn btn-primary btn-sm bg-sc-red hover:bg-sc-red-hover active:bg-red-800 border-none font-bold text-white rounded-lg shadow-sm hover:shadow active:scale-95 transition-all duration-150 d-flex align-items-center gap-1.5 px-3.5 py-1 cursor-pointer"
                  id="btnFooterSave">
                  <i class="ti ti-device-floppy"></i>
                  <span>Save Changes</span>
                </button>
              <% } %>
            </div>
          </div>
    </form>