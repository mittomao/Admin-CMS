<%
  const tpl = locals.activeTemplate || locals.template || null;
  const resolved = locals.resolvedTemplate || tpl;
  const usageData = locals.usage || null;
%>
<div class="template-editor-wrapper d-flex flex-column h-100 bg-light-subtle" id="templateEditorWrapper" data-template-id="<%= tpl ? tpl._id : '' %>">
  <!-- Template Header Bar -->
  <div class="bg-white border-bottom px-3 pt-3 pb-0 shadow-2xs">
    <div class="d-flex align-items-center justify-content-between mb-3">
      <div class="d-flex align-items-center gap-3">
        <span class="avatar avatar-md bg-purple-lt rounded-2 shadow-2xs">
          <i class="<%= tpl ? (tpl.icon || 'ti ti-template') : 'ti ti-template' %> fs-2"></i>
        </span>
        <div>
          <div class="d-flex align-items-center gap-2">
            <h2 class="m-0 fw-bold fs-2 text-dark"><%= tpl ? (tpl.displayName || tpl.name) : '' %></h2>
            <span class="badge bg-secondary-lt font-monospace"><%= tpl ? tpl.name : '' %></span>
            <% if (tpl && tpl.isSystem) { %>
              <span class="badge bg-azure-lt"><i class="ti ti-lock me-1"></i>System</span>
            <% } %>
            <span class="badge bg-purple-lt"><i class="ti ti-template me-1"></i>Template Definition</span>
          </div>
          <div class="text-muted small mt-1"><%= tpl ? (tpl.description || 'Định nghĩa cấu trúc schema và các trường dữ liệu của Item.') : '' %></div>
        </div>
      </div>

      <div class="d-flex align-items-center gap-2">
        <span id="tplDirtyIndicator" class="badge bg-warning-lt d-none">
          <i class="ti ti-pencil me-1"></i>Unsaved Changes
        </span>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnEditTemplateMeta">
          <i class="ti ti-pencil me-1"></i>Edit Details
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="btnPreviewForm" title="Preview Form">
          <i class="ti ti-eye me-1"></i>Preview
        </button>
        <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-1" id="btnSaveTemplate">
          <i class="ti ti-device-floppy"></i>
          <span>Save (Ctrl+S)</span>
        </button>
      </div>
    </div>

    <!-- Tab Navigation -->
    <ul class="nav nav-tabs border-0" id="templateWorkspaceTabs" role="tablist">
      <li class="nav-item">
        <button class="nav-link active fw-semibold" id="tab-builder-btn" data-tab="builder" type="button">
          <i class="ti ti-layout-grid me-1"></i>Builder
        </button>
      </li>
      <li class="nav-item">
        <button class="nav-link fw-semibold" id="tab-standard-values-btn" data-tab="standard-values" type="button">
          <i class="ti ti-forms me-1"></i>Standard Values
        </button>
      </li>
      <li class="nav-item">
        <button class="nav-link fw-semibold" id="tab-insert-options-btn" data-tab="insert-options" type="button">
          <i class="ti ti-file-plus me-1"></i>Insert Options
        </button>
      </li>
      <li class="nav-item">
        <button class="nav-link fw-semibold" id="tab-inheritance-btn" data-tab="inheritance" type="button">
          <i class="ti ti-git-fork me-1"></i>Inheritance
        </button>
      </li>
      <li class="nav-item">
        <button class="nav-link fw-semibold" id="tab-usage-btn" data-tab="usage" type="button">
          <i class="ti ti-chart-bar me-1"></i>Usage
        </button>
      </li>
    </ul>
  </div>

  <!-- Dynamic Tab Content Body -->
  <div class="flex-fill overflow-auto p-3" id="templateTabContent">
    <%- include('../admin/templates/partials/tab-builder', { template: tpl, resolved, quickInfo: locals.quickInfo }) %>
  </div>
</div>

<script>
  window.__ACTIVE_TEMPLATE_ID__ = "<%= tpl ? tpl._id : '' %>";
  window.__ACTIVE_TEMPLATE_UPDATED_AT__ = "<%= tpl && tpl.updatedAt ? new Date(tpl.updatedAt).toISOString() : '' %>";
</script>
