<div class="d-flex align-items-center justify-content-between mb-1.5 select-none">
  <label class="form-label m-0 text-xs font-bold text-slate-700 dark:text-slate-300 tracking-wide <%= field.required ? 'required' : '' %>">
    <%= field.title || field.name %>
  </label>
  <div class="d-flex align-items-center gap-1.5">
    <% if (field.shared) { %>
      <span class="badge bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/50" style="font-size: 0.65rem;" title="Shared Field: Dùng chung cho mọi ngôn ngữ và phiên bản.">
        <i class="ti ti-world me-1"></i>[shared]
      </span>
    <% } else if (field.unversioned) { %>
      <span class="badge bg-amber-50 dark:bg-amber-950/60 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-900/50" style="font-size: 0.65rem;" title="Unversioned Field: Dùng chung cho tất cả các phiên bản của ngôn ngữ này.">
        <i class="ti ti-language me-1"></i>[unversioned]
      </span>
    <% } %>
    <% if (field.origin && field.origin.isInherited) { %>
      <span class="badge bg-purple-50 dark:bg-purple-950/60 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-900/50" style="font-size: 0.65rem;" title="Inherited from <%= field.origin.templateName %>">
        <i class="ti ti-git-fork me-1"></i><%= field.origin.templateName %>
      </span>
    <% } %>
    <% if (field.isUsingStandardValue) { %>
      <span class="badge bg-teal-50 dark:bg-teal-950/60 text-teal-600 dark:text-teal-400 border border-teal-200 dark:border-teal-900/50" style="font-size: 0.65rem;" title="Using dynamic Standard Value from template">
        <i class="ti ti-sparkles me-1"></i>Standard Value
      </span>
    <% } else if (field.hasExplicitValue) { %>
      <button type="button" 
              class="btn btn-ghost-secondary btn-icon btn-sm p-1 rounded-md btn-reset-std-val hover:bg-slate-100 dark:hover:bg-slate-800 active:scale-90 transition-all duration-150" 
              data-field-id="<%= field._id %>" 
              data-field-name="<%= field.name %>"
              title="Reset to Standard Value"
              style="height: 22px; width: 22px;">
        <i class="ti ti-rotate-2 text-warning fs-3"></i>
      </button>
    <% } %>
    <% if (typeof isReadOnly !== 'undefined' && isReadOnly) { %>
      <span class="badge bg-slate-100 dark:bg-slate-800 text-slate-500 border border-slate-200 dark:border-slate-700" style="font-size: 0.65rem;" title="Chỉ đọc (Read-only)">
        <i class="ti ti-lock me-1"></i>Read-only
      </span>
    <% } %>
  </div>
</div>

