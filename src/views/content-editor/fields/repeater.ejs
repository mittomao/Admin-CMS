<%
  const { fieldRegistry } = require('../../../../fields');
  let items = [];
  if (Array.isArray(value)) {
    items = value;
  } else if (typeof value === 'string' && value.trim()) {
    try {
      const parsed = JSON.parse(value);
      if (Array.isArray(parsed)) items = parsed;
    } catch {
      items = [];
    }
  }

  const subFields = (field.config && Array.isArray(field.config.subFields)) ? field.config.subFields : [
    { name: 'title', title: 'Tiêu đề', type: 'Single-Line Text', required: true },
    { name: 'description', title: 'Mô tả', type: 'Multi-Line Text', required: false }
  ];

  const minItems = field.config?.minItems || 0;
  const maxItems = field.config?.maxItems || null;
  const addBtnText = field.config?.addBtnText || 'Thêm mục mới';
  const readOnlyAttr = (typeof isReadOnly !== 'undefined' && isReadOnly) ? 'disabled' : '';
%>

<div class="mb-4 field-container repeater-container" 
     id="repeater-container-<%= field._id %>"
     data-field-name="<%= field.name %>" 
     data-field-id="<%= field._id %>"
     data-min-items="<%= minItems %>"
     data-max-items="<%= maxItems || '' %>">
  
  <%- include('./field-header', { field }) %>

  <!-- Hidden payload input storing the serialized JSON array -->
  <input type="hidden" 
         name="fields[<%= field.name %>]" 
         id="repeater-payload-<%= field._id %>" 
         class="item-field-input repeater-payload-input" 
         value='<%= JSON.stringify(items) %>' />

  <!-- Repeater items list -->
  <div class="repeater-list d-flex flex-column gap-2 mb-2" id="repeater-list-<%= field._id %>">
    <% if (items.length === 0) { %>
      <div class="repeater-empty text-center py-4 px-3 bg-slate-50 dark:bg-slate-800/40 rounded-xl border border-dashed border-slate-300 dark:border-slate-700 select-none">
        <i class="ti ti-list-details text-2xl text-slate-400 mb-1 d-block"></i>
        <div class="text-xs text-slate-500 font-medium">Chưa có mục nào được thêm vào danh sách</div>
        <div class="text-[11px] text-slate-400 mt-0.5">Bấm nút bên dưới để bắt đầu thêm mục đầu tiên.</div>
      </div>
    <% } %>

    <% items.forEach((item, index) => { %>
      <div class="card repeater-row border border-slate-200 dark:border-slate-700/80 shadow-2xs rounded-xl overflow-hidden mb-0" 
           data-uid="<%= item._uid || ('item-' + index) %>">
        <!-- Row Header Bar -->
        <div class="card-header bg-slate-50/80 dark:bg-slate-800/60 px-3 py-2 border-b border-slate-200/80 dark:border-slate-700/80 d-flex align-items-center justify-content-between select-none">
          <div class="d-flex align-items-center gap-2">
            <span class="repeater-drag-handle cursor-grab text-slate-400 hover:text-slate-600 transition-colors p-1" title="Kéo thả để sắp xếp">
              <i class="ti ti-grip-vertical"></i>
            </span>
            <span class="badge bg-slate-200/80 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-mono text-[10px] px-1.5 py-0.5 rounded">
              #<span class="repeater-row-index"><%= index + 1 %></span>
            </span>
            <span class="text-xs font-bold text-slate-700 dark:text-slate-200 repeater-row-title text-truncate" style="max-width: 250px;">
              <%= item[subFields[0]?.name] || 'Mục #' + (index + 1) %>
            </span>
          </div>

          <div class="d-flex align-items-center gap-1">
            <button type="button" class="btn btn-ghost-secondary btn-icon btn-sm p-1 rounded-md btn-toggle-collapse" title="Thu gọn / Mở rộng">
              <i class="ti ti-chevron-down text-xs"></i>
            </button>
            <% if (!isReadOnly) { %>
              <button type="button" class="btn btn-ghost-secondary btn-icon btn-sm p-1 rounded-md btn-clone-row" title="Nhân bản mục này">
                <i class="ti ti-copy text-xs"></i>
              </button>
              <button type="button" class="btn btn-ghost-danger btn-icon btn-sm p-1 rounded-md text-red-500 hover:bg-red-50 btn-remove-row" title="Xóa mục này">
                <i class="ti ti-trash text-xs"></i>
              </button>
            <% } %>
          </div>
        </div>

        <!-- Row Body with Subfields -->
        <div class="card-body p-3 bg-white dark:bg-slate-900 repeater-row-body">
          <div class="row g-2.5">
            <% subFields.forEach(sub => { %>
              <% 
                const subVal = item[sub.name] !== undefined ? item[sub.name] : '';
                const subType = sub.type || 'Single-Line Text';
              %>
              <div class="col-12">
                <label class="form-label text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1 <%= sub.required ? 'required' : '' %>">
                  <%= sub.title || sub.name %>
                </label>
                
                <% if (subType === 'Multi-Line Text') { %>
                  <textarea class="form-control form-control-sm text-xs rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 repeater-subfield-input" 
                            data-subfield-name="<%= sub.name %>" 
                            rows="2" 
                            <%= sub.required ? 'required' : '' %> 
                            <%= readOnlyAttr %>><%= subVal %></textarea>
                <% } else if (subType === 'Checkbox' || subType === 'Toggle Switch') { %>
                  <label class="form-check form-switch mb-0 cursor-pointer pt-1">
                    <input type="checkbox" 
                           class="form-check-input repeater-subfield-input cursor-pointer" 
                           data-subfield-name="<%= sub.name %>" 
                           value="true" 
                           <%= (subVal === true || subVal === 'true' || subVal === '1') ? 'checked' : '' %> 
                           <%= readOnlyAttr %> />
                    <span class="form-check-label text-xs text-slate-600 dark:text-slate-400 font-medium">Bật</span>
                  </label>
                <% } else if (subType === 'Number') { %>
                  <input type="number" 
                         class="form-control form-control-sm text-xs rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 repeater-subfield-input" 
                         data-subfield-name="<%= sub.name %>" 
                         value="<%= subVal %>" 
                         <%= sub.required ? 'required' : '' %> 
                         <%= readOnlyAttr %> />
                <% } else if (subType === 'Color Picker') { %>
                  <div class="input-group input-group-sm">
                    <input type="color" 
                           class="form-control form-control-color p-0.5 rounded-s-lg border-slate-300 dark:border-slate-700" 
                           value="<%= subVal.startsWith && subVal.startsWith('#') ? subVal : '#000000' %>" 
                           <%= readOnlyAttr %> 
                           oninput="this.nextElementSibling.value = this.value; this.nextElementSibling.dispatchEvent(new Event('input', { bubbles: true }));" 
                           style="width: 36px; height: 30px;" />
                    <input type="text" 
                           class="form-control form-control-sm font-mono text-xs rounded-e-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 repeater-subfield-input" 
                           data-subfield-name="<%= sub.name %>" 
                           value="<%= subVal %>" 
                           placeholder="#000000" 
                           <%= readOnlyAttr %> />
                  </div>
                <% } else { %>
                  <input type="text" 
                         class="form-control form-control-sm text-xs rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 repeater-subfield-input" 
                         data-subfield-name="<%= sub.name %>" 
                         value="<%= subVal %>" 
                         <%= sub.required ? 'required' : '' %> 
                         <%= readOnlyAttr %> />
                <% } %>
              </div>
            <% }) %>
          </div>
        </div>
      </div>
    <% }) %>
  </div>

  <!-- Repeater Action Bar -->
  <% if (!isReadOnly) { %>
    <div class="d-flex align-items-center justify-content-between pt-1">
      <button type="button" 
              class="btn btn-outline-primary btn-sm rounded-lg d-inline-flex align-items-center gap-1.5 px-3 py-1 text-xs font-semibold btn-add-repeater-row"
              data-field-id="<%= field._id %>">
        <i class="ti ti-plus"></i>
        <span><%= addBtnText %></span>
      </button>

      <span class="text-[11px] text-slate-400 font-medium">
        Đang có <strong class="text-slate-700 dark:text-slate-300 repeater-count"><%= items.length %></strong>
        <% if (maxItems) { %> / tối đa <%= maxItems %> <% } %> mục
      </span>
    </div>
  <% } %>

  <!-- Row Template for Client Cloning -->
  <template id="repeater-row-tpl-<%= field._id %>">
    <div class="card repeater-row border border-slate-200 dark:border-slate-700/80 shadow-2xs rounded-xl overflow-hidden mb-0" data-uid="">
      <div class="card-header bg-slate-50/80 dark:bg-slate-800/60 px-3 py-2 border-b border-slate-200/80 dark:border-slate-700/80 d-flex align-items-center justify-content-between select-none">
        <div class="d-flex align-items-center gap-2">
          <span class="repeater-drag-handle cursor-grab text-slate-400 hover:text-slate-600 transition-colors p-1" title="Kéo thả để sắp xếp">
            <i class="ti ti-grip-vertical"></i>
          </span>
          <span class="badge bg-slate-200/80 dark:bg-slate-700 text-slate-700 dark:text-slate-300 font-mono text-[10px] px-1.5 py-0.5 rounded">
            #<span class="repeater-row-index">0</span>
          </span>
          <span class="text-xs font-bold text-slate-700 dark:text-slate-200 repeater-row-title text-truncate" style="max-width: 250px;">
            Mục mới
          </span>
        </div>
        <div class="d-flex align-items-center gap-1">
          <button type="button" class="btn btn-ghost-secondary btn-icon btn-sm p-1 rounded-md btn-toggle-collapse" title="Thu gọn / Mở rộng">
            <i class="ti ti-chevron-down text-xs"></i>
          </button>
          <button type="button" class="btn btn-ghost-secondary btn-icon btn-sm p-1 rounded-md btn-clone-row" title="Nhân bản mục này">
            <i class="ti ti-copy text-xs"></i>
          </button>
          <button type="button" class="btn btn-ghost-danger btn-icon btn-sm p-1 rounded-md text-red-500 hover:bg-red-50 btn-remove-row" title="Xóa mục này">
            <i class="ti ti-trash text-xs"></i>
          </button>
        </div>
      </div>
      <div class="card-body p-3 bg-white dark:bg-slate-900 repeater-row-body">
        <div class="row g-2.5">
          <% subFields.forEach(sub => { %>
            <% const subType = sub.type || 'Single-Line Text'; %>
            <div class="col-12">
              <label class="form-label text-[11px] font-semibold text-slate-600 dark:text-slate-400 mb-1 <%= sub.required ? 'required' : '' %>">
                <%= sub.title || sub.name %>
              </label>
              <% if (subType === 'Multi-Line Text') { %>
                <textarea class="form-control form-control-sm text-xs rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 repeater-subfield-input" 
                          data-subfield-name="<%= sub.name %>" 
                          rows="2" 
                          <%= sub.required ? 'required' : '' %>></textarea>
              <% } else if (subType === 'Checkbox' || subType === 'Toggle Switch') { %>
                <label class="form-check form-switch mb-0 cursor-pointer pt-1">
                  <input type="checkbox" 
                         class="form-check-input repeater-subfield-input cursor-pointer" 
                         data-subfield-name="<%= sub.name %>" 
                         value="true" />
                  <span class="form-check-label text-xs text-slate-600 dark:text-slate-400 font-medium">Bật</span>
                </label>
              <% } else if (subType === 'Number') { %>
                <input type="number" 
                       class="form-control form-control-sm text-xs rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 repeater-subfield-input" 
                       data-subfield-name="<%= sub.name %>" 
                       value="" 
                       <%= sub.required ? 'required' : '' %> />
              <% } else if (subType === 'Color Picker') { %>
                <div class="input-group input-group-sm">
                  <input type="color" 
                         class="form-control form-control-color p-0.5 rounded-s-lg border-slate-300 dark:border-slate-700" 
                         value="#000000" 
                         oninput="this.nextElementSibling.value = this.value; this.nextElementSibling.dispatchEvent(new Event('input', { bubbles: true }));" 
                         style="width: 36px; height: 30px;" />
                  <input type="text" 
                         class="form-control form-control-sm font-mono text-xs rounded-e-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 repeater-subfield-input" 
                         data-subfield-name="<%= sub.name %>" 
                         value="#000000" 
                         placeholder="#000000" />
                </div>
              <% } else { %>
                <input type="text" 
                       class="form-control form-control-sm text-xs rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 repeater-subfield-input" 
                       data-subfield-name="<%= sub.name %>" 
                       value="" 
                       <%= sub.required ? 'required' : '' %> />
              <% } %>
            </div>
          <% }) %>
        </div>
      </div>
    </div>
  </template>

  <% if (field.helpText) { %>
    <div class="form-hint text-muted mt-1.5"><i class="ti ti-info-circle me-1"></i><%= field.helpText %></div>
  <% } %>
  <div class="invalid-feedback text-xs mt-1"></div>
</div>

