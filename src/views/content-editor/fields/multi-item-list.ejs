<% 
  const readOnlyAttr = (typeof isReadOnly !== 'undefined' && isReadOnly) ? 'readonly' : '';
  let items = [];
  if (Array.isArray(value)) {
    items = value;
  } else if (typeof value === 'string' && value.trim()) {
    try {
      const parsed = JSON.parse(value);
      items = Array.isArray(parsed) ? parsed : value.split(',').map(s => s.trim()).filter(Boolean);
    } catch {
      items = value.split(',').map(s => s.trim()).filter(Boolean);
    }
  }
%>
<div class="mb-3 field-container" data-field-name="<%= field.name %>" data-field-id="<%= field._id %>">
  <%- include('./field-header', { field }) %>
  <div class="input-icon relative">
    <span class="input-icon-addon">
      <i class="ti ti-list-details text-slate-400"></i>
    </span>
    <input
      type="text"
      class="form-control form-control-sm item-field-input rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-xs font-mono"
      name="fields[<%= field.name %>]"
      value="<%= items.join(', ') %>"
      placeholder="<%= field.config?.placeholder || 'ID hoặc Path của các item, phân tách bằng dấu phẩy (,)...' %>"
      <%= field.required ? 'required' : '' %>
      <%= readOnlyAttr %>
    />
  </div>
  <% if (items.length > 0) { %>
    <div class="d-flex flex-wrap gap-1 mt-1.5">
      <% items.forEach(it => { %>
        <span class="badge bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700 font-mono text-[11px]">
          <i class="ti ti-link me-0.5"></i><%= it %>
        </span>
      <% }) %>
    </div>
  <% } %>
  <% if (field.helpText) { %>
    <div class="form-text text-slate-500 text-xs mt-1"><%= field.helpText %></div>
  <% } %>
  <div class="invalid-feedback text-xs mt-1"></div>
</div>

