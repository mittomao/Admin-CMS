<div class="mb-3 field-container" data-field-name="<%= field.name %>">
  <div class="d-flex justify-content-between align-items-center mb-1">
    <label class="form-label mb-0 <%= field.required ? 'required' : '' %>">
      <%= field.title || field.name %>
    </label>
    <span class="badge bg-blue-lt text-uppercase font-monospace" style="font-size: 0.65rem;">Rich Text</span>
  </div>
  <textarea
    class="form-control item-field-input rich-editor"
    name="fields[<%= field.name %>]"
    rows="8"
    <%= field.required ? 'required' : '' %>
    placeholder="Write content..."
  ><%= typeof value !== 'undefined' && value !== null ? value : (field.defaultValue || '') %></textarea>
  <div class="invalid-feedback"></div>
</div>

