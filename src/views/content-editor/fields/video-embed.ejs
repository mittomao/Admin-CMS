<% 
  const readOnlyAttr = (typeof isReadOnly !== 'undefined' && isReadOnly) ? 'readonly' : '';
  const currentVal = typeof value !== 'undefined' && value !== null ? value : (field.defaultValue || '');
  let embedUrl = '';
  if (currentVal) {
    if (currentVal.includes('youtube.com/watch?v=')) {
      const vid = currentVal.split('v=')[1]?.split('&')[0];
      embedUrl = `https://www.youtube-nocookie.com/embed/${vid}`;
    } else if (currentVal.includes('youtu.be/')) {
      const vid = currentVal.split('youtu.be/')[1]?.split('?')[0];
      embedUrl = `https://www.youtube-nocookie.com/embed/${vid}`;
    } else if (currentVal.includes('vimeo.com/')) {
      const vid = currentVal.split('vimeo.com/')[1]?.split('?')[0];
      embedUrl = `https://player.vimeo.com/video/${vid}`;
    }
  }
%>
<div class="mb-3 field-container" data-field-name="<%= field.name %>" data-field-id="<%= field._id %>">
  <%- include('./field-header', { field }) %>
  <div class="input-group input-group-sm rounded-lg overflow-hidden border border-slate-300 dark:border-slate-700">
    <span class="input-group-text bg-slate-50 dark:bg-slate-800 text-slate-400 border-0">
      <i class="ti ti-video"></i>
    </span>
    <input
      type="text"
      class="form-control form-control-sm item-field-input text-xs border-0 dark:bg-slate-800 dark:text-slate-100"
      name="fields[<%= field.name %>]"
      value="<%= currentVal %>"
      placeholder="<%= field.config?.placeholder || 'https://www.youtube.com/watch?v=...' %>"
      <%= field.required ? 'required' : '' %>
      <%= readOnlyAttr %>
    />
  </div>
  <% if (embedUrl) { %>
    <div class="mt-2 rounded-xl overflow-hidden border border-slate-200 dark:border-slate-700 aspect-video max-w-sm bg-black">
      <iframe src="<%= embedUrl %>" class="w-full h-full border-0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
    </div>
  <% } %>
  <% if (field.helpText) { %>
    <div class="form-text text-slate-500 text-xs mt-1"><%= field.helpText %></div>
  <% } %>
  <div class="invalid-feedback text-xs mt-1"></div>
</div>

