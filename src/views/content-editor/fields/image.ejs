<div class="mb-3 field-container" data-field-name="<%= field.name %>" data-field-id="<%= field._id %>">
  <%- include('./field-header', { field }) %>
  <div class="input-group shadow-xs rounded-lg overflow-hidden">
    <span class="input-group-text bg-slate-50 dark:bg-slate-800 border-slate-300 dark:border-slate-700 text-slate-400">
      <i class="ti ti-photo"></i>
    </span>
    <input
      type="text"
      class="form-control form-control-sm item-field-input js-image-field-input border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm focus:border-sc-red focus:ring-1 focus:ring-sc-red"
      name="fields[<%= field.name %>]"
      value="<%= typeof value !== 'undefined' && value !== null ? value : (field.defaultValue || '') %>"
      <%= field.required ? 'required' : '' %>
      placeholder="Select an image from Media Library or enter URL..."
    />
    <button class="btn btn-sm btn-outline-primary js-image-browse-btn active:scale-95 transition-all duration-150" type="button" title="Browse Media Library">
      <i class="ti ti-folder-search me-1"></i>Browse...
    </button>
    <button class="btn btn-sm btn-outline-secondary js-image-clear-btn active:scale-95 transition-all duration-150" type="button" title="Clear image">
      <i class="ti ti-x me-1"></i>Clear
    </button>
  </div>

  <% 
    let previewSrc = '';
    if (value) {
      if (typeof value === 'string' && (value.startsWith('http') || value.startsWith('/'))) {
        previewSrc = value;
      } else {
        previewSrc = '/media/file/' + value + '?thumb=1';
      }
    }
  %>
  <div class="mt-2.5 p-1.5 border border-slate-200 dark:border-slate-700 rounded-xl bg-slate-50 dark:bg-slate-800 text-center js-image-preview-box shadow-xs <%= previewSrc ? '' : 'd-none' %>" style="max-width: 220px;">
    <img src="<%= previewSrc %>" alt="Preview" class="img-fluid rounded-lg js-image-preview-img shadow-2xs" style="max-height: 110px;" onerror="this.onerror=null;this.closest('.js-image-preview-box').classList.add('d-none');" />
  </div>
  <div class="invalid-feedback text-xs mt-1"></div>
</div>
