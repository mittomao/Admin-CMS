<div class="mb-3 field-container" data-field-name="<%= field.name %>" data-field-id="<%= field._id %>">
  <%- include('./field-header', { field }) %>
  <div class="input-group">
    <span class="input-group-text">
      <i class="ti ti-photo text-muted"></i>
    </span>
    <input
      type="text"
      class="form-control item-field-input js-image-field-input"
      name="fields[<%= field.name %>]"
      value="<%= typeof value !== 'undefined' && value !== null ? value : (field.defaultValue || '') %>"
      <%= field.required ? 'required' : '' %>
      placeholder="Select an image from Media Library or enter URL..."
    />
    <button class="btn btn-outline-primary js-image-browse-btn" type="button" title="Browse Media Library">
      Browse...
    </button>
    <button class="btn btn-outline-secondary js-image-clear-btn" type="button" title="Clear image">
      Clear
    </button>
  </div>

  <% 
    let previewSrc = '';
    if (value) {
      if (typeof value === 'string' && (value.startsWith('http') || value.startsWith('/'))) {
        previewSrc = value;
      } else {
        previewSrc = '/media/file/' + value + '?thumb=1';
      }
    }
  %>
  <div class="mt-2 p-1 border rounded bg-light text-center js-image-preview-box <%= previewSrc ? '' : 'd-none' %>" style="max-width: 200px;">
    <img src="<%= previewSrc %>" alt="Preview" class="img-fluid rounded js-image-preview-img" style="max-height: 100px;" onerror="this.src=''" />
  </div>
  <div class="invalid-feedback"></div>
</div>
