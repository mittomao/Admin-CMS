<div class="d-flex flex-column h-100 p-3">
  <!-- Folder Header -->
  <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom">
    <div class="d-flex align-items-center gap-2">
      <span class="avatar avatar-sm bg-blue-lt rounded">
        <i class="ti ti-folder fs-2"></i>
      </span>
      <div>
        <h3 class="m-0 fw-bold fs-3 text-dark"><%= item.displayName || item.name %></h3>
        <span class="text-muted small font-monospace"><%= item.path %></span>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" id="folderViewInsertBtn">
        <i class="ti ti-plus"></i>
        <span>Insert Subitem</span>
      </button>
    </div>
  </div>

  <!-- Quick Info Section (DEC-037 / GĐ 6.3) -->
  <%- include('../partials/quick-info', { quickInfo: locals.quickInfo, item: locals.item }) %>

  <!-- Children Grid -->
  <div class="overflow-auto flex-fill">
    <% if (!children || children.length === 0) { %>
      <div class="empty py-5 text-center">
        <div class="empty-icon text-muted">
          <i class="ti ti-folder-off fs-1"></i>
        </div>
        <p class="empty-title">This folder is currently empty</p>
        <p class="empty-subtitle text-muted">
          Click the "Insert from template" button on the ribbon or above to create your first subitem.
        </p>
      </div>
    <% } else { %>
      <div class="row row-cards g-3">
        <% children.forEach(child => { %>
          <%
            const tpl = child.templateId || {};
            const resolvedIcon = typeof resolveItemIcon === 'function' ? resolveItemIcon(child, tpl) : (tpl.icon || 'page');
            const tplName = tpl.displayName || tpl.name || 'Item';
          %>
          <div class="col-sm-6 col-md-4 col-lg-3">
            <div
              class="card card-link card-link-pop h-100 folder-child-tile cursor-pointer shadow-2xs border"
              data-item-id="<%= child._id %>"
              title="Open <%= child.displayName || child.name %>"
            >
              <div class="card-body p-3 d-flex align-items-start gap-3">
                <span class="avatar bg-light border rounded flex-shrink-0 d-flex align-items-center justify-content-center p-1" style="width: 40px; height: 40px;">
                  <%- typeof renderIconHtml === 'function' ? renderIconHtml(resolvedIcon, 28) : `<img src="/img/icons/page.svg" width="28" height="28" />` %>
                </span>
                <div class="flex-fill overflow-hidden">
                  <div class="fw-bold text-truncate text-dark" title="<%= child.displayName || child.name %>">
                    <%= child.displayName || child.name %>
                  </div>
                  <div class="text-muted small font-monospace text-truncate" style="font-size: 0.72rem;">
                    <%= child.name %>
                  </div>
                  <div class="mt-2 d-flex align-items-center gap-1">
                    <span class="badge bg-secondary-lt" style="font-size: 0.65rem;">
                      <%= tplName %>
                    </span>
                    <% if (child.hasChildren) { %>
                      <span class="badge bg-azure-lt" style="font-size: 0.65rem;">
                        <%= child.childrenCount %> subitems
                      </span>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

