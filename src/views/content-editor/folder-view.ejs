<div class="d-flex flex-column h-100 p-3">
  <!-- Folder Header -->
  <div class="d-flex align-items-center justify-content-between mb-3 pb-2.5 border-b border-slate-200 dark:border-slate-800">
    <div class="d-flex align-items-center gap-2.5">
      <span class="avatar avatar-sm bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 rounded-lg border border-blue-200 dark:border-blue-900/50">
        <i class="ti ti-folder fs-2"></i>
      </span>
      <div>
        <h3 class="m-0 fw-bold fs-3 text-slate-900 dark:text-white"><%= item.displayName || item.name %></h3>
        <span class="text-slate-400 text-xs font-monospace"><%= item.path %></span>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <% 
        const isMediaFolder = (item.path && item.path.startsWith('/sitecore/media library')) || 
                              (item.templateId && (item.templateId.name === 'Media Folder' || item.templateId.displayName === 'Media Folder')); 
      %>
      <% if (isMediaFolder) { %>
        <button type="button" class="btn btn-sm btn-primary bg-sc-red hover:bg-sc-red-hover active:bg-red-800 border-none font-bold text-white rounded-lg shadow-sm hover:shadow active:scale-95 transition-all duration-150 d-flex align-items-center gap-1.5 px-3 py-1" id="folderViewUploadBtn" title="Upload files to this media folder">
          <i class="ti ti-upload"></i>
          <span>Upload Media</span>
        </button>
        <input type="file" id="folderViewFileInput" class="d-none" multiple accept="image/*,application/pdf" />
      <% } %>
      <button type="button" class="btn btn-sm btn-outline-primary rounded-lg active:scale-95 transition-all duration-150 d-flex align-items-center gap-1.5 px-3 py-1 font-medium" id="folderViewInsertBtn">
        <i class="ti ti-plus"></i>
        <span>Insert Subitem</span>
      </button>
    </div>
  </div>

  <!-- Quick Info Section (DEC-037 / GĐ 6.3) -->
  <%- include('../partials/quick-info', { quickInfo: locals.quickInfo, item: locals.item }) %>

  <!-- Children Grid -->
  <div class="overflow-auto flex-fill sc-scrollbar">
    <% if (!children || children.length === 0) { %>
      <div class="empty py-8 text-center bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800">
        <div class="empty-icon text-slate-300 dark:text-slate-600 mb-2">
          <i class="ti ti-folder-off fs-1"></i>
        </div>
        <p class="empty-title font-bold text-slate-800 dark:text-slate-200">This folder is currently empty</p>
        <p class="empty-subtitle text-slate-400 text-xs max-w-sm mx-auto">
          Click the "Insert from template" button on the ribbon or above to create your first subitem.
        </p>
      </div>
    <% } else { %>
      <div class="row row-cards g-3">
        <% children.forEach(child => { %>
          <%
            const tpl = child.templateId || {};
            const resolvedIcon = typeof resolveItemIcon === 'function' ? resolveItemIcon(child, tpl) : (tpl.icon || 'page');
            const tplName = tpl.displayName || tpl.name || 'Item';
            const childShared = (child.sharedFields instanceof Map) ? Object.fromEntries(child.sharedFields) : (child.sharedFields || {});
            const childFileUrl = childShared.secureUrl || (child.fields && child.fields.secureUrl) || null;
            const isChildImage = tplName === 'Image' || (childFileUrl && /\.(jpg|jpeg|png|webp|gif|svg|avif)$/i.test(childFileUrl));
          %>
          <div class="col-sm-6 col-md-4 col-lg-3">
            <div
              class="card card-link card-link-pop h-100 folder-child-tile cursor-pointer shadow-2xs border border-slate-200 dark:border-slate-800 rounded-xl bg-white dark:bg-slate-900 hover:border-sc-red dark:hover:border-sc-red hover:shadow-md hover:-translate-y-0.5 active:scale-[0.98] transition-all duration-150"
              data-item-id="<%= child._id %>"
              title="Open <%= child.displayName || child.name %>"
            >
              <div class="card-body p-3 d-flex align-items-start gap-3">
                <% if (isChildImage && childFileUrl) { %>
                  <span class="avatar bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg flex-shrink-0 p-0 overflow-hidden shadow-2xs" style="width: 40px; height: 40px;">
                    <img src="<%= childFileUrl %>" alt="<%= child.displayName || child.name %>" style="width: 100%; height: 100%; object-fit: cover;" onerror="this.onerror=null;this.parentElement.innerHTML='<i class=\'ti ti-photo fs-2 text-muted\'></i>';" />
                  </span>
                <% } else { %>
                  <span class="avatar bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg flex-shrink-0 d-flex align-items-center justify-content-center p-1 shadow-2xs" style="width: 40px; height: 40px;">
                    <%- typeof renderIconHtml === 'function' ? renderIconHtml(resolvedIcon, 28) : `<img src="/img/icons/page.svg" width="28" height="28" />` %>
                  </span>
                <% } %>
                <div class="flex-fill overflow-hidden">
                  <div class="fw-bold text-truncate text-slate-800 dark:text-slate-100" title="<%= child.displayName || child.name %>">
                    <%= child.displayName || child.name %>
                  </div>
                  <div class="text-slate-400 font-monospace text-truncate" style="font-size: 0.72rem;">
                    <%= child.name %>
                  </div>
                  <div class="mt-2 d-flex align-items-center gap-1.5 flex-wrap">
                    <span class="badge bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200 dark:border-slate-700" style="font-size: 0.65rem;">
                      <%= tplName %>
                    </span>
                    <% if (child.hasChildren) { %>
                      <span class="badge bg-blue-50 dark:bg-blue-950/60 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-900/50" style="font-size: 0.65rem;">
                        <%= child.childrenCount %> subitems
                      </span>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

