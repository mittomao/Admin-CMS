<div class="modal fade" id="moveItemModal" tabindex="-1" aria-labelledby="moveItemModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-xl shadow-2xl border border-slate-200 overflow-hidden">
      <div class="modal-header py-3 px-4 bg-slate-50/80 border-b border-slate-200 flex items-center justify-between">
        <h5 class="modal-title d-flex align-items-center gap-2 text-sm font-bold text-slate-800 m-0 flex items-center gap-2" id="moveItemModalLabel">
          <i class="ti ti-arrows-move text-primary text-base"></i>
          <span>Move Item</span>
        </h5>
        <button type="button" class="btn-close text-slate-400 hover:text-slate-600 transition-colors p-1" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="moveItemForm">
        <div class="modal-body p-4 text-xs space-y-3.5">
          <input type="hidden" id="moveItemId" name="id" />

          <div>
            <label class="form-label text-slate-500 font-medium block mb-1">Moving Item</label>
            <div class="p-2.5 bg-slate-50 rounded-lg border border-slate-200 d-flex align-items-center gap-2 flex items-center gap-2">
              <i class="ti ti-file-text text-sky-600 text-sm"></i>
              <span class="fw-semibold font-mono text-slate-700 text-xs truncate" id="moveItemCurrentPath">/path</span>
            </div>
          </div>

          <div>
            <label class="form-label required font-semibold text-slate-700 block mb-1">Select Destination Parent</label>
            <div id="moveTreePickerContainer" class="border border-slate-200 rounded-lg p-2.5 bg-white shadow-2xs" style="max-height: 220px; overflow-y: auto;">
              <!-- Mini Tree for picking destination -->
              <div id="movePickerTree"></div>
            </div>
            <input type="hidden" id="moveTargetParentId" name="targetParentId" required />
            <div class="form-text small text-slate-400 text-[10px] mt-1.5">
              Note: An item cannot be moved into itself or into one of its own subitems.
            </div>
          </div>
        </div>
        <div class="modal-footer bg-slate-50/70 px-4 py-3 border-t border-slate-200 flex items-center justify-end gap-2">
          <button type="button" class="btn btn-outline-secondary px-3 py-1.5 text-xs font-medium rounded-md border border-slate-300 hover:bg-slate-100 transition-all duration-150 active:scale-95" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary d-flex align-items-center gap-1.5 inline-flex items-center px-4 py-1.5 text-xs font-semibold rounded-md shadow-xs transition-all duration-150 active:scale-95 hover:shadow-sm focus:ring-2 focus:ring-primary/40 focus:outline-none" id="btnSubmitMove">
            <i class="ti ti-arrows-move text-xs"></i>
            <span>Move</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

