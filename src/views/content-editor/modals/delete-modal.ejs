<div class="modal fade" id="deleteItemModal" tabindex="-1" aria-labelledby="deleteItemModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <div class="modal-status bg-danger"></div>
      <div class="modal-body text-center py-4">
        <i class="ti ti-alert-triangle fs-1 text-danger mb-2"></i>
        <h3>Delete Item?</h3>
        <div class="text-muted" id="deleteModalMessage">
          Are you sure you want to delete this item? All of its subitems will also be deleted.
        </div>
        <div class="mt-2 font-monospace small bg-light-subtle p-1 rounded text-truncate" id="deleteModalItemPath">
          /sitecore/path
        </div>
        <input type="hidden" id="deleteItemId" />
      </div>
      <div class="modal-footer">
        <div class="w-100">
          <div class="row">
            <div class="col">
              <button type="button" class="btn btn-outline-secondary w-100" data-bs-dismiss="modal">
                Cancel
              </button>
            </div>
            <div class="col">
              <button type="button" class="btn btn-danger w-100 d-flex align-items-center justify-content-center gap-1" id="btnConfirmDelete">
                <i class="ti ti-trash"></i>
                <span>Delete</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

