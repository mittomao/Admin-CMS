<div class="modal fade" id="deleteItemModal" tabindex="-1" aria-labelledby="deleteItemModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content shadow-2xl rounded-2xl border border-slate-200 overflow-hidden">
      <div class="modal-status bg-rose-500 h-1.5 w-full"></div>
      <div class="modal-body text-center py-6 px-4 text-xs">
        <div class="w-12 h-12 rounded-full bg-rose-50 border border-rose-100 flex items-center justify-center text-rose-500 mx-auto mb-3">
          <i class="ti ti-alert-triangle text-2xl"></i>
        </div>
        <h3 class="fw-bold text-slate-800 text-base font-bold mb-1">Delete Item?</h3>
        <div class="text-slate-500 text-xs" id="deleteModalMessage">
          Are you sure you want to delete this item? All of its subitems will also be deleted.
        </div>
        <div class="mt-2.5 font-mono text-[11px] bg-slate-100 text-slate-600 p-2 rounded-lg text-truncate truncate" id="deleteModalItemPath">
          /root/path
        </div>
        <input type="hidden" id="deleteItemId" />
      </div>
      <div class="modal-footer bg-slate-50/70 p-3 border-t border-slate-200">
        <div class="w-100 w-full">
          <div class="row g-2 flex items-center gap-2">
            <div class="col flex-1">
              <button type="button" class="btn btn-outline-secondary w-100 w-full btn-sm py-2 text-xs font-medium rounded-lg border border-slate-300 hover:bg-slate-100 text-slate-700 transition-all duration-150 active:scale-95" data-bs-dismiss="modal">
                Cancel
              </button>
            </div>
            <div class="col flex-1">
              <button type="button" class="btn btn-danger w-100 w-full btn-sm py-2 text-xs font-semibold rounded-lg shadow-xs hover:bg-rose-600 transition-all duration-150 active:scale-95 d-flex align-items-center justify-content-center gap-1.5 inline-flex items-center justify-center" id="btnConfirmDelete">
                <i class="ti ti-trash text-xs"></i>
                <span>Delete</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

