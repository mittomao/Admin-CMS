<div class="modal fade" id="addLanguageModal" tabindex="-1" aria-labelledby="addLanguageModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header py-2 px-3 bg-light border-bottom">
        <h5 class="modal-title d-flex align-items-center gap-2" id="addLanguageModalLabel">
          <i class="ti ti-world-plus text-primary fs-3"></i>
          <span>Thêm Bản Dịch Ngôn Ngữ</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form id="addLanguageForm">
        <div class="modal-body p-3">
          <div class="mb-3">
            <label class="form-label required">Chọn ngôn ngữ cần thêm:</label>
            <select class="form-select" id="addLanguageSelect" name="lang" required>
              <!-- Dynamically populated from /api/languages -->
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label">Sao chép nội dung từ ngôn ngữ gốc:</label>
            <select class="form-select" id="addLanguageCopyFrom" name="copyFromLang">
              <option value="">(Không sao chép - Tạo bản dịch trống)</option>
              <option value="vi" selected>Tiếng Việt (vi)</option>
              <option value="en">English (en)</option>
            </select>
            <div class="form-text small">Sao chép dữ liệu các trường và bố cục trang để dịch thuật nhanh hơn.</div>
          </div>

          <div class="mb-3">
            <label class="form-label">Ghi chú (Tùy chọn):</label>
            <input type="text" class="form-control" id="addLanguageNote" name="note" placeholder="Ví dụ: Khởi tạo bản dịch tiếng Việt..." />
          </div>
        </div>

        <div class="modal-footer py-2 px-3 bg-light">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-primary btn-sm d-flex align-items-center gap-1" id="btnSubmitAddLanguage">
            <i class="ti ti-plus"></i> Thêm Ngôn Ngữ
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

