<div class="modal fade" id="versionHistoryModal" tabindex="-1" aria-labelledby="versionHistoryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content rounded-xl shadow-2xl border border-slate-200 overflow-hidden">
      <div class="modal-header py-3 px-4 bg-slate-50/80 border-b border-slate-200 flex items-center justify-between">
        <h5 class="modal-title d-flex align-items-center gap-2 text-sm font-bold text-slate-800 m-0 flex items-center gap-2" id="versionHistoryModalLabel">
          <i class="ti ti-timeline text-primary text-base"></i>
          <span>Lịch sử Phiên bản — <%= item.displayName || item.name %></span>
          <span class="badge bg-indigo-50 text-indigo-700 border border-indigo-200 text-uppercase font-mono text-[10px] px-2 py-0.5 rounded">[<%= currentLang %>]</span>
        </h5>
        <button type="button" class="btn-close text-slate-400 hover:text-slate-600 transition-colors p-1" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4 text-xs">
        <div class="d-flex align-items-center justify-content-between mb-3.5 flex-wrap gap-2.5 flex items-center justify-between">
          <div class="text-slate-500 text-xs">
            Tổng cộng: <strong class="font-bold text-slate-800"><%= versions.length %></strong> phiên bản nội dung trong ngôn ngữ này.
          </div>
          <div class="d-flex align-items-center gap-2 flex items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1.5 inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-md border border-primary/30 text-primary bg-primary/5 hover:bg-primary/10 transition-all duration-150 active:scale-95" id="btnModalAddVersionFromHistory">
              <i class="ti ti-file-plus text-xs"></i> Thêm phiên bản mới
            </button>
            <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1.5 inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-md border border-slate-300 text-slate-700 hover:bg-slate-50 transition-all duration-150 active:scale-95" id="btnModalCompareFromHistory">
              <i class="ti ti-columns text-xs"></i> So sánh phiên bản
            </button>
          </div>
        </div>

        <div class="table-responsive border border-slate-200 rounded-xl overflow-hidden shadow-2xs">
          <table class="table table-vcenter table-hover table-striped card-table mb-0 w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-500 font-mono text-[11px] border-b border-slate-200">
              <tr>
                <th class="py-2.5 px-3" style="width: 80px;">Version</th>
                <th class="py-2.5 px-3">Người tạo / sửa</th>
                <th class="py-2.5 px-3">Ngày cập nhật</th>
                <th class="py-2.5 px-3">Ghi chú</th>
                <th class="py-2.5 px-3 text-right" style="width: 180px;">Thao tác</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% if (versions.length === 0) { %>
                <tr>
                  <td colspan="5" class="text-center py-6 text-slate-400 italic">Chưa có phiên bản nào.</td>
                </tr>
              <% } else { %>
                <% versions.forEach(v => { %>
                  <tr class="hover:bg-slate-50/80 transition-colors">
                    <td class="py-2.5 px-3">
                      <span class="badge <%= v.version === 1 ? 'bg-slate-100 text-slate-600 border border-slate-200' : 'bg-primary text-white' %> font-mono text-xs px-2 py-0.5 rounded">
                        v<%= v.version %>
                      </span>
                    </td>
                    <td class="py-2.5 px-3">
                      <div class="d-flex align-items-center gap-2 flex items-center gap-2">
                        <span class="avatar avatar-xs rounded bg-blue-50 text-primary border border-blue-100 w-6 h-6 flex items-center justify-center">
                          <i class="ti ti-user text-xs"></i>
                        </span>
                        <div>
                          <div class="fw-semibold text-slate-800 text-xs"><%= v.updatedBy ? (v.updatedBy.fullName || v.updatedBy.username) : 'System' %></div>
                          <div class="text-slate-400 font-mono text-[10px]"><%= v.updatedBy ? v.updatedBy.username : '' %></div>
                        </div>
                      </div>
                    </td>
                    <td class="py-2.5 px-3">
                      <div class="text-slate-500 text-xs">
                        <i class="ti ti-calendar me-1 text-slate-400"></i><%= v.updatedAt ? new Date(v.updatedAt).toLocaleString() : 'N/A' %>
                      </div>
                    </td>
                    <td class="py-2.5 px-3">
                      <span class="text-slate-500 text-xs"><%= v.note || '—' %></span>
                    </td>
                    <td class="py-2.5 px-3 text-right">
                      <div class="btn-group btn-group-sm inline-flex rounded-md overflow-hidden border border-slate-200 shadow-2xs">
                        <button type="button" class="btn btn-outline-primary btn-action-view-version px-2.5 py-1 text-xs font-medium bg-white hover:bg-primary/5 text-primary transition-all duration-150 active:scale-95" 
                                data-version="<%= v.version %>" title="Xem phiên bản này">
                          <i class="ti ti-eye"></i> Xem
                        </button>
                        <button type="button" class="btn btn-outline-warning btn-action-restore-version px-2.5 py-1 text-xs font-medium bg-white hover:bg-amber-50 text-amber-600 border-l border-slate-200 transition-all duration-150 active:scale-95" 
                                data-version="<%= v.version %>" title="Khôi phục thành version mới">
                          <i class="ti ti-history"></i> Khôi phục
                        </button>
                        <% if (versions.length > 1) { %>
                          <button type="button" class="btn btn-outline-danger btn-action-delete-version px-2 py-1 text-xs font-medium bg-white hover:bg-rose-50 text-rose-500 border-l border-slate-200 transition-all duration-150 active:scale-95" 
                                  data-version="<%= v.version %>" title="Xóa phiên bản này">
                            <i class="ti ti-trash"></i>
                          </button>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <div class="modal-footer py-3 px-4 bg-slate-50/70 border-t border-slate-200 flex justify-end">
        <button type="button" class="btn btn-secondary btn-sm px-3.5 py-1.5 text-xs font-medium rounded-md border border-slate-300 hover:bg-slate-100 transition-all duration-150 active:scale-95" data-bs-dismiss="modal">Đóng</button>
      </div>
    </div>
  </div>
</div>

