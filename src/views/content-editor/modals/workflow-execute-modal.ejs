<!-- Workflow Command Execution Modal for Content Editor (GĐ 8) -->
<div class="modal fade" id="ceWorkflowExecuteModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow border-0">
      <div class="modal-header bg-slate-50 border-b border-slate-200">
        <h5 class="modal-title text-sm font-semibold text-slate-800 flex items-center gap-2">
          <i class="ti ti-send text-indigo-600"></i>
          <span>Chuyển bước Quy trình Phê duyệt</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4 space-y-3">
        <div class="p-2.5 bg-slate-50 border border-slate-100 rounded text-xs space-y-1">
          <div class="text-slate-500">Mục: <strong class="text-slate-800" id="ceWfItemName">-</strong></div>
          <div class="text-slate-500">Trạng thái hiện tại: <span class="badge bg-indigo-50 text-indigo-700 font-mono" id="ceWfCurrentState">-</span></div>
        </div>

        <div>
          <label class="form-label text-xs font-semibold text-slate-700">Chọn lệnh chuyển bước khả dụng</label>
          <div id="ceWfCommandsContainer" class="space-y-1.5">
            <!-- Dynamically populated commands radio/buttons -->
          </div>
          <div id="ceWfNoCommandsMsg" class="text-xs text-slate-400 italic py-2 d-none">
            Không có lệnh nào khả dụng cho vai trò của bạn hoặc trạng thái hiện tại đã là trạng thái cuối cùng.
          </div>
        </div>

        <div>
          <label class="form-label text-xs font-semibold text-slate-700">
            Lý do / Nhận xét <span id="ceWfCommentStar" class="text-rose-500 d-none">*</span>
          </label>
          <textarea id="ceWfCommentInput" rows="3" class="form-control text-xs" placeholder="Ghi chú nhận xét phê duyệt..."></textarea>
          <div id="ceWfCommentError" class="text-[11px] text-rose-500 mt-1 d-none">Lệnh này bắt buộc phải nhập lý do/nhận xét.</div>
        </div>
      </div>

      <div class="modal-footer bg-slate-50 border-t border-slate-200 px-4 py-2 flex justify-end gap-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn btn-sm btn-primary" id="btnCeWfSubmit" onclick="submitCeWorkflowCommand()">
          Thực thi lệnh
        </button>
      </div>
    </div>
  </div>
</div>

