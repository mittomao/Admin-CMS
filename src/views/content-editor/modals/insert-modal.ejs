<div class="modal fade" id="insertItemModal" tabindex="-1" aria-labelledby="insertItemModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title d-flex align-items-center gap-2" id="insertItemModalLabel">
          <i class="ti ti-file-plus text-primary"></i>
          <span>Insert from Template</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="insertItemForm">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label text-muted small">Parent Item</label>
            <div class="p-2 bg-light-subtle rounded border d-flex align-items-center gap-2">
              <i class="ti ti-folder text-azure"></i>
              <span class="fw-semibold font-monospace" id="modalParentItemPath">/sitecore</span>
            </div>
            <input type="hidden" id="modalParentItemId" name="parentId" value="" />
          </div>

          <div class="mb-3">
            <label class="form-label required">Select Template</label>
            <div id="modalInsertOptionsContainer" class="list-group" style="max-height: 180px; overflow-y: auto;">
              <!-- Insert Options dynamic list populated via AJAX -->
              <div class="text-center py-3 text-muted">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <span class="ms-2">Loading templates...</span>
              </div>
            </div>
            <input type="hidden" id="modalSelectedTemplateId" name="templateId" required />
            <div class="invalid-feedback d-block text-danger small mt-1" id="templateSelectionError" style="display: none;"></div>
          </div>

          <div class="mb-3">
            <label class="form-label required" for="modalItemName">Technical Name</label>
            <input
              type="text"
              class="form-control font-monospace"
              id="modalItemName"
              name="name"
              required
              placeholder="e.g. about-us, products, contact"
              pattern="^[a-zA-Z0-9_-]+$"
            />
            <div class="form-text small text-muted">
              Only alphanumeric characters, dashes, and underscores allowed (used in path and slug).
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" for="modalItemDisplayName">Display Name (optional)</label>
            <input
              type="text"
              class="form-control"
              id="modalItemDisplayName"
              name="displayName"
              placeholder="e.g. About Us, Our Products"
            />
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary d-flex align-items-center gap-1" id="btnSubmitInsert">
            <i class="ti ti-plus"></i>
            <span>Insert</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

