<div class="modal fade" id="insertItemModal" tabindex="-1" aria-labelledby="insertItemModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-xl shadow-2xl border border-slate-200 overflow-hidden">
      <div class="modal-header py-3 px-4 bg-slate-50/80 border-b border-slate-200 flex items-center justify-between">
        <h5 class="modal-title d-flex align-items-center gap-2 text-sm font-bold text-slate-800 m-0 flex items-center gap-2" id="insertItemModalLabel">
          <i class="ti ti-file-plus text-primary text-base"></i>
          <span>Insert from Template</span>
        </h5>
        <button type="button" class="btn-close text-slate-400 hover:text-slate-600 transition-colors p-1" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="insertItemForm">
        <div class="modal-body p-4 text-xs space-y-3.5">
          <div>
            <label class="form-label text-slate-500 font-medium block mb-1">Parent Item</label>
            <div class="p-2.5 bg-slate-50 rounded-lg border border-slate-200 d-flex align-items-center gap-2 flex items-center gap-2">
              <i class="ti ti-folder text-sky-600 text-sm"></i>
              <span class="fw-semibold font-mono text-slate-700 text-xs truncate" id="modalParentItemPath">/root</span>
            </div>
            <input type="hidden" id="modalParentItemId" name="parentId" value="" />
          </div>

          <div>
            <label class="form-label required font-semibold text-slate-700 block mb-1">Select Template</label>
            <div id="modalInsertOptionsContainer" class="list-group border border-slate-200 rounded-lg overflow-hidden bg-white shadow-2xs divide-y divide-slate-100" style="max-height: 180px; overflow-y: auto;">
              <!-- Insert Options dynamic list populated via AJAX -->
              <div class="text-center py-6 text-slate-400 flex flex-col items-center justify-center">
                <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
                <span>Loading templates...</span>
              </div>
            </div>
            <input type="hidden" id="modalSelectedTemplateId" name="templateId" required />
            <div class="invalid-feedback d-block text-rose-500 text-[11px] mt-1" id="templateSelectionError" style="display: none;"></div>
          </div>

          <div>
            <label class="form-label required font-semibold text-slate-700 block mb-1" for="modalItemName">Technical Name</label>
            <input
              type="text"
              class="form-control font-mono text-xs rounded-md border-slate-300 py-1.5 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-150 w-full"
              id="modalItemName"
              name="name"
              required
              placeholder="e.g. about-us, products, contact"
              pattern="^[a-zA-Z0-9_-]+$"
            />
            <div class="form-text small text-slate-400 text-[10px] mt-1">
              Only alphanumeric characters, dashes, and underscores allowed (used in path and slug).
            </div>
          </div>

          <div>
            <label class="form-label font-semibold text-slate-700 block mb-1" for="modalItemDisplayName">Display Name (optional)</label>
            <input
              type="text"
              class="form-control text-xs rounded-md border-slate-300 py-1.5 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-150 w-full"
              id="modalItemDisplayName"
              name="displayName"
              placeholder="e.g. About Us, Our Products"
            />
          </div>
        </div>
        <div class="modal-footer bg-slate-50/70 px-4 py-3 border-t border-slate-200 flex items-center justify-end gap-2">
          <button type="button" class="btn btn-outline-secondary px-3 py-1.5 text-xs font-medium rounded-md border border-slate-300 hover:bg-slate-100 transition-all duration-150 active:scale-95" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary d-flex align-items-center gap-1.5 inline-flex items-center px-4 py-1.5 text-xs font-semibold rounded-md shadow-xs transition-all duration-150 active:scale-95 hover:shadow-sm focus:ring-2 focus:ring-primary/40 focus:outline-none" id="btnSubmitInsert">
            <i class="ti ti-plus text-xs"></i>
            <span>Insert</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

