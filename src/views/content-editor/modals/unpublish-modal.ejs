<!-- Unpublish Modal for Content Editor (GĐ 8) -->
<div class="modal fade" id="unpublishModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow border-0">
      <div class="modal-header bg-rose-50 border-b border-rose-100">
        <h5 class="modal-title text-sm font-semibold text-rose-800 flex items-center gap-2">
          <i class="ti ti-cloud-off text-rose-600"></i>
          <span>Gỡ bỏ khỏi Web công khai (Unpublish)</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4 space-y-3">
        <p class="text-xs text-slate-700 mb-0">
          Bạn có chắc chắn muốn gỡ bỏ mục <strong id="unpubItemName" class="text-slate-900">-</strong> khỏi trang web công khai (kho Web)?
        </p>
        <div class="alert alert-warning text-xs py-2 px-3 mb-0">
          Sau khi gỡ bỏ, khách truy cập website công khai sẽ không thể truy cập trang này (trả về lỗi 404). Bản ghi trên Master vẫn được giữ nguyên vẹn.
        </div>
        <div class="form-check text-xs">
          <input class="form-check-input" type="checkbox" id="unpubIncludeSubitems" checked />
          <label class="form-check-label text-slate-700" for="unpubIncludeSubitems">
            Gỡ bỏ đồng thời toàn bộ các trang con thuộc nhánh này
          </label>
        </div>
      </div>

      <div class="modal-footer bg-slate-50 border-t border-slate-200 px-4 py-2 flex justify-end gap-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn btn-sm btn-danger" id="btnConfirmUnpublish" onclick="submitUnpublishAction()">
          <i class="ti ti-cloud-off"></i> Xác nhận Gỡ bỏ
        </button>
      </div>
    </div>
  </div>
</div>

