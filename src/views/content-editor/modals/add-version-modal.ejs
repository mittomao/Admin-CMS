<div class="modal fade" id="addVersionModal" tabindex="-1" aria-labelledby="addVersionModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-xl shadow-2xl border border-slate-200 overflow-hidden">
      <div class="modal-header py-3 px-4 bg-slate-50/80 border-b border-slate-200 flex items-center justify-between">
        <h5 class="modal-title d-flex align-items-center gap-2 text-sm font-bold text-slate-800 m-0 flex items-center gap-2" id="addVersionModalLabel">
          <i class="ti ti-file-plus text-primary text-base"></i>
          <span>Thêm Phiên Bản Mới</span>
        </h5>
        <button type="button" class="btn-close text-slate-400 hover:text-slate-600 transition-colors p-1" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <form id="addVersionForm">
        <div class="modal-body p-4 text-xs space-y-3.5">
          <div>
            <label class="form-label required font-semibold text-slate-700 block mb-1">Ngôn ngữ áp dụng:</label>
            <input type="text" class="form-control text-xs font-mono rounded-md border-slate-300 py-1.5 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-150 w-full bg-slate-50" id="addVersionLang" name="lang" value="vi" readonly />
            <div class="form-text small text-slate-400 text-[10px] mt-1">Phiên bản mới sẽ được tạo trong ngôn ngữ này.</div>
          </div>

          <div>
            <label class="form-label required font-semibold text-slate-700 block mb-1">Sao chép nội dung từ:</label>
            <select class="form-select text-xs rounded-md border-slate-300 py-1.5 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-150 w-full cursor-pointer bg-white" id="addVersionCopyFrom" name="copyFromVersion">
              <!-- Dynamically populated -->
            </select>
            <div class="form-text small text-slate-400 text-[10px] mt-1">Mặc định sao chép nội dung và cấu hình Presentation từ phiên bản mới nhất.</div>
          </div>

          <div>
            <label class="form-label font-semibold text-slate-700 block mb-1">Ghi chú phiên bản (Tùy chọn):</label>
            <input type="text" class="form-control text-xs rounded-md border-slate-300 py-1.5 focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-150 w-full" id="addVersionNote" name="note" placeholder="Ví dụ: Cập nhật thông tin quý 4, sửa lỗi chính tả..." />
          </div>
        </div>

        <div class="modal-footer bg-slate-50/70 px-4 py-3 border-t border-slate-200 flex items-center justify-end gap-2">
          <button type="button" class="btn btn-secondary btn-sm px-3.5 py-1.5 text-xs font-medium rounded-md border border-slate-300 hover:bg-slate-100 transition-all duration-150 active:scale-95" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-primary btn-sm d-flex align-items-center gap-1.5 inline-flex items-center px-4 py-1.5 text-xs font-semibold rounded-md shadow-xs transition-all duration-150 active:scale-95 hover:shadow-sm focus:ring-2 focus:ring-primary/40 focus:outline-none" id="btnSubmitAddVersion">
            <i class="ti ti-plus text-xs"></i> Tạo Phiên Bản
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

