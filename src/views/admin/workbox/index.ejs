<div class="desktop-window workbox-window flex flex-col h-[calc(100vh-120px)] bg-slate-50 border border-slate-200 shadow-md rounded-lg overflow-hidden">
  <!-- Window Header -->
  <div class="window-header bg-gradient-to-r from-slate-100 via-slate-50 to-slate-100 border-b border-slate-200 px-4 py-2.5 flex items-center justify-between select-none">
    <div class="window-title flex items-center gap-2.5 text-slate-800 font-semibold text-sm">
      <span class="inline-flex items-center justify-center w-6 h-6 rounded bg-indigo-100 text-indigo-700">
        <i class="ti ti-checkbox text-base"></i>
      </span>
      <span class="window-name tracking-tight font-medium">Workbox</span>
      <span class="text-xs px-2 py-0.5 rounded-full bg-slate-200/70 text-slate-600 font-mono">Content Approval & Publishing Queue</span>
    </div>
    <div class="window-actions flex items-center gap-2">
      <a href="/admin/launchpad" class="inline-flex items-center justify-center w-7 h-7 rounded text-slate-400 hover:text-slate-700 hover:bg-slate-200 transition" title="Đóng">✕</a>
    </div>
  </div>

  <!-- Workbox Toolbar / Ribbon -->
  <div class="workbox-toolbar bg-white border-b border-slate-200 px-4 py-2 flex flex-wrap items-center justify-between gap-3 text-xs">
    <div class="flex items-center gap-2">
      <button type="button" class="btn btn-sm btn-outline-secondary d-flex items-center gap-1.5" onclick="window.location.reload()">
        <i class="ti ti-refresh"></i> Refresh
      </button>

      <% if (canBulk && itemsData.items.length > 0 && selectedState && selectedState.commands.length > 0) { %>
        <div class="btn-group" role="group">
          <button type="button" class="btn btn-sm btn-outline-primary" id="selectAllBtn" onclick="toggleSelectAll(true)">
            <i class="ti ti-check-all"></i> Chọn tất cả
          </button>
          <button type="button" class="btn btn-sm btn-outline-secondary" id="deselectAllBtn" onclick="toggleSelectAll(false)">
            Bỏ chọn
          </button>
        </div>

        <div class="dropdown">
          <button class="btn btn-sm btn-primary dropdown-toggle d-flex items-center gap-1.5" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="bulkActionsBtn" disabled>
            <i class="ti ti-bolt"></i> Thao tác hàng loạt (<span id="selectedCountBadge">0</span>)
          </button>
          <ul class="dropdown-menu shadow">
            <% selectedState.commands.forEach(cmd => { %>
              <li>
                <button class="dropdown-item d-flex items-center gap-2" type="button" onclick="openBulkCommandModal('<%= cmd.name %>', '<%= cmd.displayName || cmd.name %>', <%= Boolean(cmd.requireComment) %>)">
                  <i class="<%= cmd.icon || 'ti ti-player-play' %>"></i>
                  Chạy <%= cmd.displayName || cmd.name %> cho các mục đã chọn
                </button>
              </li>
            <% }) %>
          </ul>
        </div>
      <% } %>
    </div>

    <!-- Search & Filter Form -->
    <form method="GET" action="/admin/workbox" class="flex items-center gap-2">
      <% if (selectedStateId) { %>
        <input type="hidden" name="stateId" value="<%= selectedStateId %>" />
      <% } %>
      <div class="input-group input-group-sm w-44">
        <select name="lang" class="form-select text-xs" onchange="this.form.submit()">
          <option value="">Tất cả ngôn ngữ</option>
          <option value="vi" <%= query.lang === 'vi' ? 'selected' : '' %>>Tiếng Việt (vi)</option>
          <option value="en" <%= query.lang === 'en' ? 'selected' : '' %>>English (en)</option>
        </select>
      </div>
      <div class="input-group input-group-sm w-56">
        <input type="text" name="search" value="<%= query.search || '' %>" placeholder="Tìm kiếm tên, path..." class="form-control text-xs" />
        <button class="btn btn-outline-secondary" type="submit"><i class="ti ti-search"></i></button>
      </div>
    </form>
  </div>

  <!-- Workbox Main Split View -->
  <div class="window-body flex-1 overflow-hidden flex">
    <!-- Left Sidebar: Workflows & States -->
    <div class="w-72 bg-white border-r border-slate-200 flex flex-col flex-shrink-0">
      <div class="p-3 border-b border-slate-100 bg-slate-50/50">
        <h6 class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-0">Quy trình & Trạng thái</h6>
      </div>
      <div class="overflow-y-auto flex-1 p-2 space-y-4">
        <% workflows.forEach(wf => { %>
          <div class="workflow-group">
            <div class="flex items-center justify-between px-2 py-1 text-xs font-bold text-slate-700">
              <span class="truncate" title="<%= wf.name %>"><%= wf.displayName || wf.name %></span>
              <span class="badge bg-slate-100 text-slate-600 rounded-pill"><%= wf.totalItems %></span>
            </div>
            <div class="mt-1 space-y-0.5">
              <% wf.states.forEach(st => { 
                   const isSelected = selectedStateId === st.id;
              %>
                <a href="/admin/workbox?stateId=<%= st.id %><%= query.lang ? '&lang=' + query.lang : '' %>"
                   class="flex items-center justify-between px-2.5 py-1.5 rounded-md text-xs transition <%= isSelected ? 'bg-indigo-50 text-indigo-700 font-semibold' : 'text-slate-600 hover:bg-slate-100' %>">
                  <span class="flex items-center gap-2 truncate">
                    <i class="<%= st.icon %> text-slate-400 <%= isSelected ? 'text-indigo-600' : '' %>"></i>
                    <span class="truncate"><%= st.displayName || st.name %></span>
                  </span>
                  <span class="badge <%= isSelected ? 'bg-indigo-600 text-white' : (st.itemCount > 0 ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-500') %> rounded-pill">
                    <%= st.itemCount %>
                  </span>
                </a>
              <% }) %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>

    <!-- Center/Right Area: Items List in Selected State -->
    <div class="flex-1 flex flex-col bg-slate-50/50 overflow-hidden">
      <!-- State Header Banner -->
      <div class="bg-white px-5 py-3 border-b border-slate-200 flex items-center justify-between">
        <div>
          <h5 class="text-sm font-semibold text-slate-800 mb-0 flex items-center gap-2">
            <% if (selectedState) { %>
              <i class="<%= selectedState.icon %> text-indigo-600"></i>
              <span><%= selectedState.displayName || selectedState.name %></span>
              <span class="text-xs font-normal text-slate-500">(Workflow: <%= selectedWorkflow?.displayName || selectedWorkflow?.name %>)</span>
              <% if (selectedState.isFinal) { %>
                <span class="badge bg-emerald-100 text-emerald-700 text-[10px]">Trạng thái Đã duyệt / Sẵn sàng Publish</span>
              <% } else if (selectedState.isInitial) { %>
                <span class="badge bg-slate-100 text-slate-600 text-[10px]">Bản nháp ban đầu</span>
              <% } %>
            <% } else { %>
              <span>Chọn một trạng thái để xem danh sách item</span>
            <% } %>
          </h5>
        </div>
        <div class="text-xs text-slate-500">
          Tổng số: <strong class="text-slate-800"><%= itemsData.total %></strong> mục
        </div>
      </div>

      <!-- Items Table Container -->
      <div class="flex-1 overflow-auto p-4">
        <% if (itemsData.items.length === 0) { %>
          <div class="h-64 flex flex-col items-center justify-center text-center p-6 bg-white border border-dashed border-slate-200 rounded-lg">
            <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mb-3">
              <i class="ti ti-inbox text-2xl"></i>
            </div>
            <h6 class="text-sm font-medium text-slate-700 mb-1">Không có item nào trong trạng thái này</h6>
            <p class="text-xs text-slate-400 mb-0">Tất cả bài viết và trang nội dung đã được xử lý hoặc chưa được gửi duyệt.</p>
          </div>
        <% } else { %>
          <div class="bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden">
            <table class="table table-hover table-vcenter text-xs mb-0">
              <thead class="bg-slate-50 border-b border-slate-200 text-slate-600">
                <tr>
                  <% if (canBulk) { %>
                    <th class="w-1 text-center py-2 px-3">
                      <input type="checkbox" class="form-check-input" id="tableHeaderCheck" onchange="toggleSelectAll(this.checked)" />
                    </th>
                  <% } %>
                  <th class="py-2">Item / Đường dẫn</th>
                  <th class="py-2">Template</th>
                  <th class="py-2">Ngôn ngữ & Phiên bản</th>
                  <th class="py-2">Cập nhật bởi</th>
                  <th class="py-2">Ghi chú / Comment gần nhất</th>
                  <th class="py-2 text-end px-3">Hành động</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                <% itemsData.items.forEach(it => { %>
                  <tr class="hover:bg-indigo-50/30 transition">
                    <% if (canBulk) { %>
                      <td class="text-center px-3">
                        <input type="checkbox" class="form-check-input item-checkbox"
                               data-item-id="<%= it.itemId %>"
                               data-lang="<%= it.lang %>"
                               data-version="<%= it.version %>"
                               onchange="updateBulkSelectionState()" />
                      </td>
                    <% } %>
                    <td>
                      <div class="font-medium text-slate-800 flex items-center gap-1.5">
                        <i class="ti ti-file-text text-slate-400"></i>
                        <span><%= it.displayName || it.name %></span>
                      </div>
                      <div class="text-[11px] text-slate-400 font-mono truncate max-w-xs" title="<%= it.path %>">
                        <%= it.path %>
                      </div>
                    </td>
                    <td>
                      <span class="badge bg-slate-100 text-slate-700 border border-slate-200">
                        <%= it.template?.displayName || it.template?.name || 'Page' %>
                      </span>
                    </td>
                    <td>
                      <span class="badge bg-blue-50 text-blue-700 uppercase font-mono"><%= it.lang %></span>
                      <span class="badge bg-slate-100 text-slate-600 font-mono">v<%= it.version %></span>
                    </td>
                    <td>
                      <div class="text-slate-700"><%= it.updatedBy?.fullName || it.updatedBy?.username || 'admin' %></div>
                      <div class="text-[10px] text-slate-400">
                        <%= it.updatedAt ? new Date(it.updatedAt).toLocaleString('vi-VN') : '-' %>
                      </div>
                    </td>
                    <td>
                      <div class="text-slate-600 italic max-w-xs truncate" title="<%= it.latestComment %>">
                        <%= it.latestComment || it.note || '<Chưa có ghi chú>' %>
                      </div>
                    </td>
                    <td class="text-end px-3">
                      <div class="flex items-center justify-end gap-1.5">
                        <!-- Open in Content Editor -->
                        <a href="/admin/content-editor?id=<%= it.itemId %>&lang=<%= it.lang %>&version=<%= it.version %>"
                           class="btn btn-xs btn-outline-secondary"
                           title="Mở trong Content Editor"
                           target="_blank">
                          <i class="ti ti-external-link"></i>
                        </a>

                        <!-- View History -->
                        <button type="button" class="btn btn-xs btn-outline-secondary" title="Xem lịch sử duyệt"
                                onclick="openHistoryModal('<%= it.itemId %>', '<%= it.lang %>', <%= it.version %>, '<%= it.name %>')">
                          <i class="ti ti-history"></i>
                        </button>

                        <!-- Workflow Command Action Buttons -->
                        <% if (it.availableCommands && it.availableCommands.length > 0) { %>
                          <% it.availableCommands.forEach(cmd => { %>
                            <button type="button" class="btn btn-xs <%= cmd.name.toLowerCase().includes('reject') ? 'btn-outline-danger' : (cmd.name.toLowerCase().includes('approve') ? 'btn-success' : 'btn-primary') %>"
                                    onclick="openSingleCommandModal('<%= it.itemId %>', '<%= it.lang %>', <%= it.version %>, '<%= cmd.name %>', '<%= cmd.displayName || cmd.name %>', <%= Boolean(cmd.requireComment) %>, '<%= it.name %>')">
                              <i class="<%= cmd.icon %>"></i> <%= cmd.displayName || cmd.name %>
                            </button>
                          <% }) %>
                        <% } %>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <!-- Pagination -->
          <% if (itemsData.totalPages > 1) { %>
            <div class="mt-4 flex items-center justify-between">
              <span class="text-xs text-slate-500">
                Hiển thị trang <%= itemsData.page %> / <%= itemsData.totalPages %> (<%= itemsData.total %> kết quả)
              </span>
              <ul class="pagination pagination-sm mb-0">
                <% for (let p = 1; p <= itemsData.totalPages; p++) { %>
                  <li class="page-item <%= p === itemsData.page ? 'active' : '' %>">
                    <a class="page-link" href="/admin/workbox?stateId=<%= selectedStateId %>&page=<%= p %><%= query.search ? '&search=' + query.search : '' %><%= query.lang ? '&lang=' + query.lang : '' %>"><%= p %></a>
                  </li>
                <% } %>
              </ul>
            </div>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Execute Workflow Command (Single) -->
<div class="modal fade" id="workflowCommandModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow border-0">
      <div class="modal-header bg-slate-50 border-b border-slate-200">
        <h5 class="modal-title text-sm font-semibold text-slate-800 flex items-center gap-2">
          <i class="ti ti-player-play text-indigo-600"></i>
          <span id="modalCommandTitle">Thực thi lệnh duyệt</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 space-y-3">
        <p class="text-xs text-slate-600 mb-0">
          Bạn đang thực hiện lệnh <strong id="modalCommandName" class="text-indigo-600"></strong> trên mục: <strong id="modalItemName" class="text-slate-800"></strong>.
        </p>
        <div>
          <label class="form-label text-xs font-medium text-slate-700">
            Lý do / Ghi chú phê duyệt <span id="commentRequiredStar" class="text-rose-500 d-none">*</span>
          </label>
          <textarea id="modalCommentInput" rows="3" class="form-control text-xs" placeholder="Nhập lý do hoặc nhận xét..."></textarea>
          <div id="commentErrorMsg" class="text-[11px] text-rose-500 mt-1 d-none">Lệnh này bắt buộc phải nhập lý do/nhận xét.</div>
        </div>
      </div>
      <div class="modal-footer bg-slate-50 border-t border-slate-200 px-4 py-2 flex justify-end gap-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn btn-sm btn-primary" id="confirmCommandBtn" onclick="submitSingleCommand()">
          Xác nhận thực hiện
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Execute Bulk Workflow Command -->
<div class="modal fade" id="bulkCommandModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content shadow border-0">
      <div class="modal-header bg-slate-50 border-b border-slate-200">
        <h5 class="modal-title text-sm font-semibold text-slate-800 flex items-center gap-2">
          <i class="ti ti-bolt text-indigo-600"></i>
          <span>Thực thi Thao tác Hàng loạt</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 space-y-3">
        <p class="text-xs text-slate-600 mb-0">
          Bạn sắp thực hiện lệnh <strong id="bulkCommandNameLabel" class="text-indigo-600"></strong> trên <strong id="bulkItemsCountLabel" class="text-slate-800"></strong> mục đã chọn.
        </p>
        <div>
          <label class="form-label text-xs font-medium text-slate-700">
            Lý do / Ghi chú thao tác <span id="bulkCommentRequiredStar" class="text-rose-500 d-none">*</span>
          </label>
          <textarea id="bulkCommentInput" rows="3" class="form-control text-xs" placeholder="Nhập ghi chú chung cho đợt duyệt này..."></textarea>
          <div id="bulkCommentErrorMsg" class="text-[11px] text-rose-500 mt-1 d-none">Lệnh này bắt buộc phải nhập lý do/nhận xét.</div>
        </div>
      </div>
      <div class="modal-footer bg-slate-50 border-t border-slate-200 px-4 py-2 flex justify-end gap-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn btn-sm btn-primary" id="confirmBulkCommandBtn" onclick="submitBulkCommand()">
          Chạy tác vụ hàng loạt
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Workflow History Viewer -->
<div class="modal fade" id="workflowHistoryModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content shadow border-0">
      <div class="modal-header bg-slate-50 border-b border-slate-200">
        <h5 class="modal-title text-sm font-semibold text-slate-800 flex items-center gap-2">
          <i class="ti ti-history text-indigo-600"></i>
          <span>Lịch sử Phê duyệt: <span id="historyItemTitle"></span></span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-4 max-h-[60vh] overflow-y-auto" id="historyTimelineContainer">
        <!-- Rendered dynamically -->
      </div>
      <div class="modal-footer bg-slate-50 border-t border-slate-200 px-4 py-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
      </div>
    </div>
  </div>
</div>

<script>
  let currentSingleCmd = null;
  let currentBulkCmd = null;

  function updateBulkSelectionState() {
    const checkboxes = document.querySelectorAll('.item-checkbox:checked');
    const count = checkboxes.length;
    const badge = document.getElementById('selectedCountBadge');
    if (badge) badge.textContent = count;
    const btn = document.getElementById('bulkActionsBtn');
    if (btn) btn.disabled = count === 0;

    const allCheckboxes = document.querySelectorAll('.item-checkbox');
    const headerCheck = document.getElementById('tableHeaderCheck');
    if (headerCheck && allCheckboxes.length > 0) {
      headerCheck.checked = checkboxes.length === allCheckboxes.length;
    }
  }

  function toggleSelectAll(checked) {
    document.querySelectorAll('.item-checkbox').forEach(cb => {
      cb.checked = checked;
    });
    updateBulkSelectionState();
  }

  function openSingleCommandModal(itemId, lang, version, commandName, displayName, requireComment, itemName) {
    currentSingleCmd = { itemId, lang, version, commandName, requireComment };
    document.getElementById('modalCommandName').textContent = displayName;
    document.getElementById('modalItemName').textContent = itemName;
    document.getElementById('modalCommentInput').value = '';
    document.getElementById('commentErrorMsg').classList.add('d-none');
    
    const star = document.getElementById('commentRequiredStar');
    if (star) {
      if (requireComment) star.classList.remove('d-none');
      else star.classList.add('d-none');
    }

    const modal = new bootstrap.Modal(document.getElementById('workflowCommandModal'));
    modal.show();
  }

  async function submitSingleCommand() {
    if (!currentSingleCmd) return;
    const comment = document.getElementById('modalCommentInput').value.trim();
    if (currentSingleCmd.requireComment && !comment) {
      document.getElementById('commentErrorMsg').classList.remove('d-none');
      return;
    }

    const btn = document.getElementById('confirmCommandBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Đang xử lý...';

    try {
      const resp = await fetch(`/api/items/${currentSingleCmd.itemId}/workflow/execute`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '<%= csrfToken %>'
        },
        body: JSON.stringify({
          lang: currentSingleCmd.lang,
          version: currentSingleCmd.version,
          command: currentSingleCmd.commandName,
          comment: comment
        })
      });

      const res = await resp.json();
      if (!resp.ok || !res.success) {
        throw new Error(res.message || 'Lỗi khi thực thi lệnh duyệt');
      }

      window.location.reload();
    } catch (err) {
      alert(err.message);
      btn.disabled = false;
      btn.textContent = 'Xác nhận thực hiện';
    }
  }

  function openBulkCommandModal(commandName, displayName, requireComment) {
    const checked = document.querySelectorAll('.item-checkbox:checked');
    if (checked.length === 0) return;

    currentBulkCmd = { commandName, displayName, requireComment };
    document.getElementById('bulkCommandNameLabel').textContent = displayName;
    document.getElementById('bulkItemsCountLabel').textContent = checked.length;
    document.getElementById('bulkCommentInput').value = '';
    document.getElementById('bulkCommentErrorMsg').classList.add('d-none');

    const star = document.getElementById('bulkCommentRequiredStar');
    if (star) {
      if (requireComment) star.classList.remove('d-none');
      else star.classList.add('d-none');
    }

    const modal = new bootstrap.Modal(document.getElementById('bulkCommandModal'));
    modal.show();
  }

  async function submitBulkCommand() {
    if (!currentBulkCmd) return;
    const comment = document.getElementById('bulkCommentInput').value.trim();
    if (currentBulkCmd.requireComment && !comment) {
      document.getElementById('bulkCommentErrorMsg').classList.remove('d-none');
      return;
    }

    const checked = Array.from(document.querySelectorAll('.item-checkbox:checked')).map(cb => ({
      itemId: cb.getAttribute('data-item-id'),
      lang: cb.getAttribute('data-lang'),
      version: parseInt(cb.getAttribute('data-version'), 10)
    }));

    const btn = document.getElementById('confirmBulkCommandBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status"></span> Đang xử lý hàng loạt...';

    try {
      const resp = await fetch('/api/workbox/bulk', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '<%= csrfToken %>'
        },
        body: JSON.stringify({
          stateId: '<%= selectedStateId %>',
          command: currentBulkCmd.commandName,
          comment: comment,
          items: checked
        })
      });

      const res = await resp.json();
      if (!resp.ok || !res.success) {
        throw new Error(res.message || 'Lỗi khi thực thi lệnh hàng loạt');
      }

      const d = res.data;
      alert(`Đã hoàn tất thao tác hàng loạt:\n- Thành công: ${d.successCount}/${d.total}\n- Lỗi: ${d.failCount}/${d.total}`);
      window.location.reload();
    } catch (err) {
      alert(err.message);
      btn.disabled = false;
      btn.textContent = 'Chạy tác vụ hàng loạt';
    }
  }

  async function openHistoryModal(itemId, lang, version, itemName) {
    document.getElementById('historyItemTitle').textContent = itemName;
    const container = document.getElementById('historyTimelineContainer');
    container.innerHTML = '<div class="text-center py-4"><span class="spinner-border spinner-border-sm text-indigo-600"></span> Đang tải lịch sử...</div>';

    const modal = new bootstrap.Modal(document.getElementById('workflowHistoryModal'));
    modal.show();

    try {
      const resp = await fetch(`/api/items/${itemId}/workflow/history?lang=${lang}&version=${version}`);
      const res = await resp.json();
      if (!res.success || !res.data || res.data.length === 0) {
        container.innerHTML = '<div class="text-center text-xs text-slate-400 py-4">Chưa có lịch sử chuyển bước nào cho phiên bản này.</div>';
        return;
      }

      let html = '<div class="space-y-3">';
      res.data.forEach(h => {
        html += `
          <div class="border-l-2 border-indigo-400 pl-3 py-1 text-xs">
            <div class="flex items-center justify-between text-slate-700 font-medium">
              <span>Lệnh: <strong>${h.command?.name || h.command || 'Action'}</strong> (${h.fromState?.name || h.fromState || 'Start'} &rarr; <span class="text-indigo-600 font-bold">${h.toState?.name || h.toState}</span>)</span>
              <span class="text-[11px] text-slate-400">${new Date(h.at).toLocaleString('vi-VN')}</span>
            </div>
            <div class="text-slate-500 mt-0.5">Bởi: <strong>${h.username || 'System'}</strong></div>
            ${h.comment ? `<div class="mt-1 bg-slate-50 p-2 rounded text-slate-600 italic border border-slate-100">"${h.comment}"</div>` : ''}
          </div>
        `;
      });
      html += '</div>';
      container.innerHTML = html;
    } catch (err) {
      container.innerHTML = `<div class="text-rose-500 text-xs">Lỗi khi tải lịch sử: ${err.message}</div>`;
    }
  }
</script>

