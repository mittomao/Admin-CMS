<div class="card shadow-2xl border-0 rounded-2xl overflow-hidden bg-white dark:bg-slate-900 border border-slate-800/40">
  <!-- Header Bar -->
  <div class="p-6 text-center bg-slate-900 border-b-2 border-sc-red">
    <div class="w-12 h-12 mx-auto mb-3 bg-sc-red rounded-xl text-white font-extrabold text-2xl flex items-center justify-center shadow-md">
      <i class="ti ti-shield-lock text-2xl"></i>
    </div>
    <h1 class="text-xl font-bold text-white tracking-tight mb-1">Đổi Mật Khẩu Khởi Tạo</h1>
    <div class="text-xs text-slate-400 font-medium">Bắt buộc cập nhật mật khẩu ở lần đăng nhập đầu tiên</div>
  </div>

  <!-- Form Body -->
  <div class="p-6 sm:p-8 bg-white dark:bg-slate-900">
    <div class="alert alert-warning flex items-center gap-2.5 p-3 rounded-lg mb-5 bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-200 border border-amber-200 dark:border-amber-900/50 text-xs">
      <i class="ti ti-alert-triangle text-lg flex-shrink-0"></i>
      <div>Vì lý do an toàn, bạn bắt buộc phải thiết lập mật khẩu mới (tối thiểu 8 ký tự) trước khi tiếp tục vào trang quản trị.</div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger flex items-center gap-2.5 p-3 rounded-lg mb-5 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-900/50 text-xs" role="alert">
        <i class="ti ti-alert-circle text-lg flex-shrink-0"></i>
        <div class="font-medium"><%= error %></div>
      </div>
    <% } %>

    <form action="/admin/change-password" method="POST" autocomplete="off" class="space-y-5">
      <!-- New Password -->
      <div>
        <label for="newPassword" class="form-label block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5 required">Mật khẩu mới</label>
        <div class="input-icon relative">
          <span class="input-icon-addon">
            <i class="ti ti-lock text-slate-400"></i>
          </span>
          <input 
            type="password" 
            id="newPassword" 
            name="newPassword" 
            class="form-control form-control-md w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm transition-all duration-150 hover:border-slate-400 dark:hover:border-slate-600 focus:border-sc-red focus:ring-2 focus:ring-sc-red/20 focus:outline-none" 
            placeholder="Nhập mật khẩu mới (tối thiểu 8 ký tự)..." 
            required 
            minlength="8"
            autofocus
          >
        </div>
      </div>

      <!-- Confirm Password -->
      <div>
        <label for="confirmPassword" class="form-label block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5 required">Xác nhận mật khẩu mới</label>
        <div class="input-icon relative">
          <span class="input-icon-addon">
            <i class="ti ti-lock-check text-slate-400"></i>
          </span>
          <input 
            type="password" 
            id="confirmPassword" 
            name="confirmPassword" 
            class="form-control form-control-md w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm transition-all duration-150 hover:border-slate-400 dark:hover:border-slate-600 focus:border-sc-red focus:ring-2 focus:ring-sc-red/20 focus:outline-none" 
            placeholder="Nhập lại mật khẩu mới..." 
            required
            minlength="8"
          >
        </div>
      </div>

      <!-- Submit Button -->
      <div class="pt-2">
        <button type="submit" class="btn btn-primary w-full py-2.5 bg-sc-red hover:bg-sc-red-hover active:bg-red-800 border-none font-bold text-white rounded-lg shadow-md hover:shadow-lg active:scale-[0.98] focus:outline-none focus:ring-4 focus:ring-sc-red/30 transition-all duration-150 inline-flex items-center justify-center gap-2 cursor-pointer">
          <i class="ti ti-check text-lg"></i>
          <span>Xác nhận & Vào trang quản trị</span>
        </button>
      </div>
    </form>
  </div>
</div>

