<div class="card shadow-2xl border-0 rounded-2xl overflow-hidden bg-white dark:bg-slate-900 border border-slate-800/40">
  <!-- Header Bar -->
  <div class="p-6 text-center bg-slate-900 border-b-2 border-sc-red">
    <div class="w-12 h-12 mx-auto mb-3 bg-sc-red rounded-xl text-white font-extrabold text-2xl flex items-center justify-center shadow-md">
      <i class="ti ti-trees text-2xl"></i>
    </div>
    <h1 class="text-xl font-bold text-white tracking-tight mb-1">Treecraft Content Management</h1>
    <div class="text-xs text-slate-400 font-medium">Content Management System</div>
  </div>

  <!-- Form Body -->
  <div class="p-6 sm:p-8 bg-white dark:bg-slate-900">
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger flex items-center gap-2.5 p-3 rounded-lg mb-5 bg-red-50 dark:bg-red-950/40 text-red-700 dark:text-red-300 border border-red-200 dark:border-red-900/50 text-xs" role="alert">
        <i class="ti ti-alert-circle text-lg flex-shrink-0"></i>
        <div class="font-medium"><%= error %></div>
      </div>
    <% } %>

    <form action="/admin/login" method="POST" autocomplete="off" class="space-y-5">
      <input type="hidden" name="returnUrl" value="<%= typeof returnUrl !== 'undefined' ? returnUrl : '/admin/launchpad' %>">

      <!-- Username -->
      <div>
        <label for="username" class="form-label block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5 required">User name</label>
        <div class="input-icon relative">
          <span class="input-icon-addon">
            <i class="ti ti-user text-slate-400"></i>
          </span>
          <input 
            type="text" 
            id="username" 
            name="username" 
            class="form-control form-control-md w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm transition-all duration-150 hover:border-slate-400 dark:hover:border-slate-600 focus:border-sc-red focus:ring-2 focus:ring-sc-red/20 focus:outline-none" 
            value="<%= typeof username !== 'undefined' ? username : '' %>" 
            placeholder="Nhập tên tài khoản..." 
            required 
            autofocus
          >
          <div class="invalid-feedback text-xs mt-1">Vui lòng nhập tên tài khoản.</div>
        </div>
      </div>

      <!-- Password -->
      <div>
        <label for="password" class="form-label block text-xs font-bold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-1.5 required">Password</label>
        <div class="input-icon relative">
          <span class="input-icon-addon">
            <i class="ti ti-lock text-slate-400"></i>
          </span>
          <input 
            type="password" 
            id="password" 
            name="password" 
            class="form-control form-control-md w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm transition-all duration-150 hover:border-slate-400 dark:hover:border-slate-600 focus:border-sc-red focus:ring-2 focus:ring-sc-red/20 focus:outline-none" 
            placeholder="Nhập mật khẩu..." 
            required
          >
          <div class="invalid-feedback text-xs mt-1">Vui lòng nhập mật khẩu.</div>
        </div>
      </div>

      <!-- Submit Button -->
      <div class="pt-2">
        <button type="submit" class="btn btn-primary w-full py-2.5 bg-sc-red hover:bg-sc-red-hover active:bg-red-800 border-none font-bold text-white rounded-lg shadow-md hover:shadow-lg active:scale-[0.98] focus:outline-none focus:ring-4 focus:ring-sc-red/30 transition-all duration-150 inline-flex items-center justify-center gap-2 cursor-pointer">
          <i class="ti ti-login text-lg"></i>
          <span>Log in</span>
        </button>
      </div>
    </form>
  </div>

  <!-- Footer Info -->
  <div class="p-3 bg-slate-50 dark:bg-slate-800/80 text-center text-xs text-slate-500 dark:text-slate-400 border-t border-slate-100 dark:border-slate-800">
    Tài khoản quản trị mặc định: <code class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-800 dark:text-slate-200 font-mono">admin</code> / <code class="px-1.5 py-0.5 rounded bg-slate-200 dark:bg-slate-700 text-slate-800 dark:text-slate-200 font-mono">admin123</code>
  </div>
</div>
