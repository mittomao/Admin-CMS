<div class="modal-overlay media-picker-modal-overlay js-media-picker-modal d-none" id="mediaPickerModal" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="mediaPickerTitle">
  <div class="modal-dialog modal-xl modal-media-picker" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="mediaPickerTitle">
          <span class="modal-title-icon">🖼️</span> Select Media Asset
        </h5>
        <button type="button" class="btn-close js-media-picker-close" aria-label="Close"></button>
      </div>

      <div class="modal-body p-0">
        <%- include('../partials/media-browser-core', { browserId: 'modalMediaBrowser', isPicker: true }) %>
      </div>

      <div class="modal-footer">
        <div class="picker-selected-summary js-picker-selected-summary">
          <span class="text-muted">No asset selected</span>
        </div>
        <div class="d-flex align-items-center gap-2">
          <button type="button" class="btn btn-outline-secondary js-media-picker-cancel">Cancel</button>
          <button type="button" class="btn btn-primary js-media-picker-confirm" disabled>
            <span>✓</span> Select Asset
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

