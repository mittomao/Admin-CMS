<div class="desktop-window publish-manager-window flex flex-col h-[calc(100vh-120px)] bg-slate-50 border border-slate-200 shadow-md rounded-lg overflow-hidden">
  <!-- Window Header -->
  <div class="window-header bg-gradient-to-r from-slate-100 via-slate-50 to-slate-100 border-b border-slate-200 px-4 py-2.5 flex items-center justify-between select-none">
    <div class="window-title flex items-center gap-2.5 text-slate-800 font-semibold text-sm">
      <span class="inline-flex items-center justify-center w-6 h-6 rounded bg-emerald-100 text-emerald-700">
        <i class="ti ti-cloud-upload text-base"></i>
      </span>
      <span class="window-name tracking-tight font-medium">Publish Manager</span>
      <span class="text-xs px-2 py-0.5 rounded-full bg-slate-200/70 text-slate-600 font-mono">Master &rarr; Web Synchronization</span>
    </div>
    <div class="window-actions flex items-center gap-2">
      <a href="/admin/launchpad" class="inline-flex items-center justify-center w-7 h-7 rounded text-slate-400 hover:text-slate-700 hover:bg-slate-200 transition" title="Đóng">✕</a>
    </div>
  </div>

  <!-- Body -->
  <div class="window-body flex-1 overflow-auto p-5 space-y-6">
    <!-- Quick Actions Card -->
    <div class="grid grid-cols-3 gap-4">
      <div class="bg-white p-4 rounded-lg border border-slate-200 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-2 text-indigo-600 font-bold text-sm mb-1">
            <i class="ti ti-world text-lg"></i>
            <span>Site Publish</span>
          </div>
          <p class="text-xs text-slate-500 mb-4">
            Đồng bộ toàn bộ website công khai sang kho Web. Kiểm tra toàn bộ item, template, layout và media.
          </p>
        </div>
        <button type="button" class="btn btn-sm btn-primary w-full" onclick="triggerQuickPublish('Site')">
          <i class="ti ti-cloud-upload me-1"></i> Xuất bản Toàn bộ Site
        </button>
      </div>

      <div class="bg-white p-4 rounded-lg border border-slate-200 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-2 text-emerald-600 font-bold text-sm mb-1">
            <i class="ti ti-bolt text-lg"></i>
            <span>Smart Publish Toàn Site</span>
          </div>
          <p class="text-xs text-slate-500 mb-4">
            Chỉ xuất bản những mục có thay đổi so với bản Web gần nhất. Tối ưu thời gian và hiệu năng.
          </p>
        </div>
        <button type="button" class="btn btn-sm btn-outline-success w-full" onclick="triggerQuickPublish('Smart')">
          <i class="ti ti-bolt me-1"></i> Chạy Smart Publish
        </button>
      </div>

      <div class="bg-white p-4 rounded-lg border border-slate-200 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-2 text-slate-700 font-bold text-sm mb-1">
            <i class="ti ti-brush text-lg"></i>
            <span>Dọn dẹp Web (Cleanup)</span>
          </div>
          <p class="text-xs text-slate-500 mb-4">
            Gỡ bỏ khỏi kho Web những mục đã bị xóa hoặc đổi đường dẫn trên Master mà Web chưa kịp đồng bộ.
          </p>
        </div>
        <button type="button" class="btn btn-sm btn-outline-secondary w-full" onclick="triggerCleanupWeb()">
          <i class="ti ti-trash me-1"></i> Dọn dẹp Web Store
        </button>
      </div>
    </div>

    <!-- Active Jobs Section -->
    <div class="bg-white border border-slate-200 rounded-lg shadow-xs overflow-hidden">
      <div class="px-4 py-3 border-b border-slate-200 bg-slate-50/50 flex items-center justify-between">
        <h6 class="text-xs font-semibold text-slate-700 uppercase tracking-wider mb-0 flex items-center gap-2">
          <i class="ti ti-list text-indigo-600"></i> Hàng đợi tác vụ xuất bản (Publish Queue)
        </h6>
        <button type="button" class="btn btn-xs btn-outline-secondary" onclick="window.location.reload()">
          <i class="ti ti-refresh"></i> Làm mới
        </button>
      </div>

      <% if (activeJobs.length === 0) { %>
        <div class="p-6 text-center text-xs text-slate-400">
          <i class="ti ti-circle-check text-emerald-500 text-xl block mb-1"></i>
          Hàng đợi đang trống. Không có tác vụ xuất bản nào đang chạy.
        </div>
      <% } else { %>
        <table class="table table-vcenter text-xs mb-0">
          <thead class="bg-slate-50 text-slate-600">
            <tr>
              <th class="py-2">Mã tác vụ</th>
              <th class="py-2">Chế độ</th>
              <th class="py-2">Trạng thái</th>
              <th class="py-2">Tiến trình</th>
              <th class="py-2">Thời gian tạo</th>
              <th class="py-2 text-end">Hành động</th>
            </tr>
          </thead>
          <tbody>
            <% activeJobs.forEach(job => { %>
              <tr>
                <td class="font-mono text-slate-600"><%= job._id %></td>
                <td><span class="badge bg-indigo-50 text-indigo-700"><%= job.mode %></span></td>
                <td>
                  <span class="badge <%= job.status === 'Processing' ? 'bg-amber-100 text-amber-800' : 'bg-slate-100 text-slate-700' %>">
                    <%= job.status %>
                  </span>
                </td>
                <td><%= job.currentStep %> (<%= job.processed %> / <%= job.total %>)</td>
                <td><%= new Date(job.createdAt).toLocaleString('vi-VN') %></td>
                <td class="text-end">
                  <% if (job.status === 'Pending') { %>
                    <button class="btn btn-xs btn-outline-danger" onclick="cancelPublishJob('<%= job._id %>')">Hủy</button>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>

    <!-- Publish History Section -->
    <div class="bg-white border border-slate-200 rounded-lg shadow-xs overflow-hidden">
      <div class="px-4 py-3 border-b border-slate-200 bg-slate-50/50">
        <h6 class="text-xs font-semibold text-slate-700 uppercase tracking-wider mb-0 flex items-center gap-2">
          <i class="ti ti-history text-emerald-600"></i> Lịch sử xuất bản gần đây (Recent Publish Logs)
        </h6>
      </div>

      <div class="overflow-x-auto">
        <table class="table table-hover table-vcenter text-xs mb-0">
          <thead class="bg-slate-50 text-slate-600">
            <tr>
              <th class="py-2">Thời gian</th>
              <th class="py-2">Chế độ</th>
              <th class="py-2">Mục tiêu</th>
              <th class="py-2">Số lượng xử lý / Đã xuất bản</th>
              <th class="py-2">Người thực hiện</th>
              <th class="py-2">Trạng thái</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% histories.forEach(h => { %>
              <tr>
                <td><%= new Date(h.startedAt).toLocaleString('vi-VN') %></td>
                <td><span class="badge bg-slate-100 text-slate-700"><%= h.publishType %></span></td>
                <td>
                  <% if (h.rootItemId) { %>
                    <span class="font-medium text-slate-800"><%= h.rootItemId.name %></span>
                    <span class="text-[11px] text-slate-400 font-mono block"><%= h.rootItemId.path %></span>
                  <% } else { %>
                    <span class="font-medium text-indigo-700">Toàn bộ Website</span>
                  <% } %>
                </td>
                <td>
                  <strong class="text-emerald-700"><%= h.totalItemsPublished %></strong> / <%= h.totalItemsProcessed %> items
                </td>
                <td><%= h.publishedBy?.fullName || h.publishedBy?.username || 'System' %></td>
                <td>
                  <span class="badge <%= h.status === 'Success' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
                    <%= h.status %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  async function triggerQuickPublish(mode) {
    if (!confirm(`Bạn có chắc chắn muốn bắt đầu ${mode} Publish không?`)) return;

    try {
      const resp = await fetch('/api/publish', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': '<%= csrfToken %>'
        },
        body: JSON.stringify({
          mode,
          includeSubitems: true,
          includeRelated: true,
          languages: ['vi', 'en']
        })
      });

      const res = await resp.json();
      if (!resp.ok || !res.success) {
        throw new Error(res.message || 'Lỗi khi bắt đầu xuất bản');
      }

      alert('Đã thêm tác vụ xuất bản vào hàng đợi.');
      window.location.reload();
    } catch (err) {
      alert(err.message);
    }
  }

  async function triggerCleanupWeb() {
    if (!confirm('Bạn có chắc chắn muốn dọn dẹp các bản ghi mồ côi trên Web Store không?')) return;

    try {
      const resp = await fetch('/api/publish/cleanup', {
        method: 'POST',
        headers: {
          'X-CSRF-Token': '<%= csrfToken %>'
        }
      });
      const res = await resp.json();
      alert(`Dọn dẹp hoàn tất. Đã gỡ bỏ ${res.removedCount || 0} mục.`);
      window.location.reload();
    } catch (err) {
      alert(err.message);
    }
  }

  async function cancelPublishJob(jobId) {
    try {
      const resp = await fetch(`/api/publish/jobs/${jobId}/cancel`, {
        method: 'POST',
        headers: { 'X-CSRF-Token': '<%= csrfToken %>' }
      });
      const res = await resp.json();
      alert(res.message);
      window.location.reload();
    } catch (err) {
      alert(err.message);
    }
  }
</script>

