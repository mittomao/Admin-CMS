<div class="container-xl py-4">
  <!-- Page Header -->
  <div class="page-header d-print-none mb-4">
    <div class="row g-2 align-items-center">
      <div class="col">
        <div class="page-pretitle text-uppercase font-semibold text-slate-400">
          Treecraft An toàn Dữ liệu &bull; GĐ 9
        </div>
        <h2 class="page-title text-slate-900 dark:text-white d-flex align-items-center gap-2">
          <i class="ti ti-history text-primary"></i>
          <span>Nhật ký Kiểm toán (Audit Log)</span>
        </h2>
        <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 mb-0">
          Truy vết toàn diện biến động dữ liệu, vòng đời nội dung, thay đổi Presentation, phân quyền và xác thực hệ thống.
        </p>
      </div>
      <div class="col-auto ms-auto d-print-none d-flex gap-2">
        <a href="/admin/content-editor" class="btn btn-outline-secondary d-flex align-items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg shadow-2xs">
          <i class="ti ti-arrow-left"></i>
          <span>Content Editor</span>
        </a>
        <a href="/admin/recycle-bin" class="btn btn-outline-danger d-flex align-items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg shadow-2xs">
          <i class="ti ti-trash"></i>
          <span>Thùng rác</span>
        </a>
        <a href="/admin/audit-log/export?<%= new URLSearchParams(filters).toString() %>" class="btn btn-primary d-flex align-items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg shadow-2xs">
          <i class="ti ti-download"></i>
          <span>Xuất CSV</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Filter & Search Toolbar -->
  <div class="card mb-3 border-0 shadow-sm rounded-xl">
    <div class="card-body p-3">
      <form method="GET" action="/admin/audit-log" class="row g-2 align-items-center">
        <div class="col-md-3">
          <input type="text" name="q" class="form-control form-control-sm rounded-lg" placeholder="Tìm kiếm nội dung, đường dẫn..." value="<%= filters.q || '' %>">
        </div>
        <div class="col-md-2">
          <input type="text" name="action" class="form-control form-control-sm rounded-lg" placeholder="Hành động (VD: ITEM_UPDATE)" value="<%= filters.action || '' %>">
        </div>
        <div class="col-md-2">
          <input type="text" name="username" class="form-control form-control-sm rounded-lg" placeholder="Người dùng" value="<%= filters.username || '' %>">
        </div>
        <div class="col-md-2">
          <input type="date" name="from" class="form-control form-control-sm rounded-lg" title="Từ ngày" value="<%= filters.from || '' %>">
        </div>
        <div class="col-md-2">
          <input type="date" name="to" class="form-control form-control-sm rounded-lg" title="Đến ngày" value="<%= filters.to || '' %>">
        </div>
        <div class="col-md-1 d-flex gap-1">
          <button type="submit" class="btn btn-sm btn-primary w-100 rounded-lg" title="Lọc dữ liệu">
            <i class="ti ti-filter"></i>
          </button>
          <% if (filters.q || filters.action || filters.username || filters.from || filters.to) { %>
          <a href="/admin/audit-log" class="btn btn-sm btn-outline-secondary rounded-lg" title="Xóa bộ lọc">
            <i class="ti ti-x"></i>
          </a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <!-- Main Log Table -->
  <div class="card border-0 shadow-sm rounded-xl overflow-hidden">
    <div class="table-responsive">
      <table class="table table-vcenter table-hover card-table mb-0">
        <thead class="bg-slate-50 dark:bg-slate-800 text-slate-500 text-xs font-semibold text-uppercase">
          <tr>
            <th style="width: 15%;">Thời gian</th>
            <th style="width: 15%;">Hành động</th>
            <th style="width: 15%;">Người thực hiện</th>
            <th style="width: 25%;">Đối tượng</th>
            <th style="width: 20%;">Tóm tắt chi tiết</th>
            <th style="width: 10%;" class="text-end">Chi tiết</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-sm">
          <% if (!logs || logs.length === 0) { %>
          <tr>
            <td colspan="6" class="text-center py-5 text-slate-400">
              <i class="ti ti-history-off fs-1 d-block mb-2 text-slate-300"></i>
              <span>Không tìm thấy bản ghi kiểm toán phù hợp.</span>
            </td>
          </tr>
          <% } else { %>
            <% logs.forEach(function(log) { %>
            <tr>
              <td class="text-slate-500 dark:text-slate-400 text-xs font-mono">
                <%= log.at ? new Date(log.at).toLocaleString('vi-VN') : '-' %>
              </td>
              <td>
                <% 
                  let badgeClass = 'bg-secondary-lt';
                  if (log.action.includes('CREATE') || log.action.includes('RESTORE')) badgeClass = 'bg-success-lt';
                  else if (log.action.includes('DELETE') || log.action.includes('PURGE')) badgeClass = 'bg-danger-lt';
                  else if (log.action.includes('UPDATE') || log.action.includes('PRESENTATION')) badgeClass = 'bg-primary-lt';
                  else if (log.action.includes('AUTH')) badgeClass = 'bg-purple-lt';
                  else if (log.action.includes('PUBLISH')) badgeClass = 'bg-cyan-lt';
                %>
                <span class="badge <%= badgeClass %> font-mono text-xs">
                  <%= log.action %>
                </span>
                <% if (log.result === 'denied') { %>
                  <span class="badge bg-warning-lt text-xs ms-1">Denied</span>
                <% } else if (log.result === 'error') { %>
                  <span class="badge bg-danger-lt text-xs ms-1">Error</span>
                <% } %>
              </td>
              <td>
                <div class="d-flex align-items-center gap-1.5">
                  <i class="ti ti-user text-slate-400 text-xs"></i>
                  <span class="font-semibold text-xs text-slate-900 dark:text-white"><%= log.username || '[system]' %></span>
                </div>
                <div class="text-2xs text-slate-400 font-mono"><%= log.ip || '127.0.0.1' %></div>
              </td>
              <td>
                <% if (log.itemPath) { %>
                  <div class="font-mono text-xs text-slate-800 dark:text-slate-200 text-truncate" style="max-width: 260px;" title="<%= log.itemPath %>">
                    <%= log.itemPath %>
                  </div>
                <% } %>
                <% if (log.itemId) { %>
                  <div class="text-2xs text-slate-400 font-mono">ID: <%= log.itemId %></div>
                <% } %>
              </td>
              <td class="text-xs text-slate-600 dark:text-slate-300">
                <% 
                  const summary = log.details?.summary || (log.details?.fields ? `Fields: ${log.details.fields.join(', ')}` : (log.details ? JSON.stringify(log.details).slice(0, 80) : '-'));
                %>
                <span class="text-truncate d-inline-block" style="max-width: 250px;" title="<%= summary %>">
                  <%= summary %>
                </span>
              </td>
              <td class="text-end">
                <button type="button" class="btn btn-sm btn-ghost-secondary btn-view-log" data-log='<%- JSON.stringify(log).replace(/'/g, "&#39;") %>' title="Xem toàn bộ JSON chi tiết">
                  <i class="ti ti-eye"></i>
                </button>
              </td>
            </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination Footer -->
    <% if (pagination && pagination.totalPages > 1) { %>
    <div class="card-footer d-flex align-items-center justify-content-between p-3 bg-slate-50 dark:bg-slate-800 border-top">
      <div class="text-xs text-slate-500">
        Hiển thị trang <strong><%= pagination.page %></strong> / <strong><%= pagination.totalPages %></strong> (Tổng cộng <strong><%= pagination.total %></strong> bản ghi)
      </div>
      <ul class="pagination pagination-sm m-0">
        <% if (pagination.page > 1) { %>
        <li class="page-item">
          <a class="page-link" href="?page=<%= pagination.page - 1 %>&q=<%= filters.q %>&action=<%= filters.action %>&username=<%= filters.username %>&from=<%= filters.from %>&to=<%= filters.to %>">
            <i class="ti ti-chevron-left"></i>
          </a>
        </li>
        <% } %>
        <% for (let p = 1; p <= pagination.totalPages; p++) { %>
          <% if (p === pagination.page || p === 1 || p === pagination.totalPages || (p >= pagination.page - 2 && p <= pagination.page + 2)) { %>
          <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
            <a class="page-link" href="?page=<%= p %>&q=<%= filters.q %>&action=<%= filters.action %>&username=<%= filters.username %>&from=<%= filters.from %>&to=<%= filters.to %>"><%= p %></a>
          </li>
          <% } else if (p === pagination.page - 3 || p === pagination.page + 3) { %>
          <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
          <% } %>
        <% } %>
        <% if (pagination.page < pagination.totalPages) { %>
        <li class="page-item">
          <a class="page-link" href="?page=<%= pagination.page + 1 %>&q=<%= filters.q %>&action=<%= filters.action %>&username=<%= filters.username %>&from=<%= filters.from %>&to=<%= filters.to %>">
            <i class="ti ti-chevron-right"></i>
          </a>
        </li>
        <% } %>
      </ul>
    </div>
    <% } %>
  </div>
</div>

<!-- Modal Log Details -->
<div class="modal modal-blur fade" id="modal-log-details" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title d-flex align-items-center gap-2">
          <i class="ti ti-file-text text-primary"></i>
          <span>Chi tiết Bản ghi Kiểm toán</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body p-0">
        <pre id="log-json-content" class="bg-slate-900 text-slate-100 p-3 m-0 font-mono text-xs overflow-auto" style="max-height: 450px;"></pre>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary ms-auto" data-bs-dismiss="modal">Đóng</button>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const detailModalEl = document.getElementById('modal-log-details');
  const detailModal = detailModalEl ? new bootstrap.Modal(detailModalEl) : null;
  const jsonContent = document.getElementById('log-json-content');

  document.querySelectorAll('.btn-view-log').forEach(btn => {
    btn.addEventListener('click', () => {
      try {
        const raw = btn.getAttribute('data-log');
        const obj = JSON.parse(raw);
        jsonContent.textContent = JSON.stringify(obj, null, 2);
        detailModal.show();
      } catch (err) {
        console.error('Cannot parse log data', err);
      }
    });
  });
});
</script>

