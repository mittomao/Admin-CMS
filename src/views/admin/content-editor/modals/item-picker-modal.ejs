<div class="modal fade" id="itemPickerModal" tabindex="-1" aria-labelledby="itemPickerModalLabel" aria-hidden="true" style="z-index: 1060;">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content rounded-xl shadow-2xl border border-slate-200 overflow-hidden">
      <div class="modal-header py-3 px-4 bg-slate-50/80 border-b border-slate-200 flex items-center justify-between">
        <h5 class="modal-title d-flex align-items-center gap-2 text-sm font-bold text-slate-800 m-0 flex items-center gap-2" id="itemPickerModalLabel">
          <i class="ti ti-sitemap text-primary text-base"></i>
          <span id="itemPickerTitle">Chọn Item Dữ Liệu (Datasource)</span>
        </h5>
        <button type="button" class="btn-close text-slate-400 hover:text-slate-600 transition-colors p-1" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-4 text-xs">
        <!-- Search and Filter Bar -->
        <div class="row g-2 mb-3">
          <div class="col">
            <div class="input-icon relative">
              <span class="input-icon-addon absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none">
                <i class="ti ti-search text-slate-400 text-sm"></i>
              </span>
              <input type="text" class="form-control form-control-sm pl-8 pr-3 py-1.5 text-xs rounded-md border-slate-300 shadow-2xs focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-150 w-full" id="itemPickerSearchInput" placeholder="Tìm kiếm theo tên item hoặc đường dẫn..." autocomplete="off">
            </div>
          </div>
        </div>

        <!-- Tree View Container -->
        <div class="border border-slate-200 rounded-xl p-3 bg-white shadow-2xs" style="height: 340px; overflow-y: auto;">
          <div id="itemPickerTreeContainer" class="item-picker-tree">
            <!-- Dynamically populated hierarchical tree list -->
            <div class="text-center py-8 text-slate-400 flex flex-col items-center justify-center">
              <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
              <div class="text-xs">Đang tải cây thư mục...</div>
            </div>
          </div>
        </div>

        <!-- Selected Item Info Bar -->
        <div class="mt-3.5 p-2.5 bg-slate-50 border border-slate-200 rounded-lg d-flex align-items-center justify-content-between flex items-center justify-between">
          <div class="d-flex align-items-center gap-2 flex items-center gap-2">
            <span class="text-slate-500 text-xs">Đã chọn:</span>
            <span class="badge bg-primary text-white font-mono text-xs px-2.5 py-0.5 rounded" id="itemPickerSelectedBadge">Chưa chọn item</span>
            <span class="text-slate-400 font-mono text-[11px] text-truncate truncate" id="itemPickerSelectedPath" style="max-width: 350px;"></span>
          </div>
          <button type="button" class="btn btn-link btn-sm text-slate-400 hover:text-slate-600 p-0 text-xs text-decoration-none" id="itemPickerClearBtn">Bỏ chọn</button>
        </div>
      </div>

      <div class="modal-footer py-3 px-4 bg-slate-50/70 border-t border-slate-200 flex items-center justify-end gap-2">
        <button type="button" class="btn btn-secondary btn-sm px-3.5 py-1.5 text-xs font-medium rounded-md border border-slate-300 hover:bg-slate-100 transition-all duration-150 active:scale-95" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1.5 inline-flex items-center px-4 py-1.5 text-xs font-semibold rounded-md shadow-xs transition-all duration-150 active:scale-95 disabled:opacity-50 disabled:pointer-events-none" id="itemPickerConfirmBtn" disabled>
          <i class="ti ti-check text-xs"></i> Xác Nhận
        </button>
      </div>
    </div>
  </div>
</div>

