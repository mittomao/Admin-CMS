<div class="modal fade" id="itemPickerModal" tabindex="-1" aria-labelledby="itemPickerModalLabel" aria-hidden="true" style="z-index: 1060;">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header py-2 px-3 bg-light border-bottom">
        <h5 class="modal-title d-flex align-items-center gap-2" id="itemPickerModalLabel">
          <i class="ti ti-sitemap text-primary fs-3"></i>
          <span id="itemPickerTitle">Chọn Item Dữ Liệu (Datasource)</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-3">
        <!-- Search and Filter Bar -->
        <div class="row g-2 mb-3">
          <div class="col">
            <div class="input-icon">
              <span class="input-icon-addon">
                <i class="ti ti-search"></i>
              </span>
              <input type="text" class="form-control form-control-sm" id="itemPickerSearchInput" placeholder="Tìm kiếm theo tên item hoặc đường dẫn..." autocomplete="off">
            </div>
          </div>
        </div>

        <!-- Tree View Container -->
        <div class="border rounded p-2 bg-white" style="height: 340px; overflow-y: auto;">
          <div id="itemPickerTreeContainer" class="item-picker-tree">
            <!-- Dynamically populated hierarchical tree list -->
            <div class="text-center py-4 text-muted">
              <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
              <div>Đang tải cây thư mục...</div>
            </div>
          </div>
        </div>

        <!-- Selected Item Info Bar -->
        <div class="mt-3 p-2 bg-light border rounded d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">Đã chọn:</span>
            <span class="badge bg-blue text-white" id="itemPickerSelectedBadge">Chưa chọn item</span>
            <span class="text-muted small text-truncate" id="itemPickerSelectedPath" style="max-width: 350px;"></span>
          </div>
          <button type="button" class="btn btn-link btn-sm text-muted p-0" id="itemPickerClearBtn">Bỏ chọn</button>
        </div>
      </div>

      <div class="modal-footer py-2 px-3 bg-light">
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
        <button type="button" class="btn btn-primary btn-sm d-flex align-items-center gap-1" id="itemPickerConfirmBtn" disabled>
          <i class="ti ti-check"></i> Xác Nhận
        </button>
      </div>
    </div>
  </div>
</div>

