<div class="modal fade" id="selectRenderingModal" tabindex="-1" aria-labelledby="selectRenderingModalLabel" aria-hidden="true" style="z-index: 1055;">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header py-2 px-3 bg-light border-bottom">
        <h5 class="modal-title d-flex align-items-center gap-2" id="selectRenderingModalLabel">
          <i class="ti ti-components text-primary fs-3"></i>
          <span>Thêm Component vào Placeholder: <span class="text-primary font-monospace" id="selectRenderingPlaceholderTitle"></span></span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <div class="modal-body p-3">
        <!-- Search and Folder Filter Bar -->
        <div class="row g-2 mb-2 align-items-center">
          <div class="col-sm-7">
            <div class="input-icon">
              <span class="input-icon-addon">
                <i class="ti ti-search"></i>
              </span>
              <input type="text" class="form-control form-control-sm" id="searchRenderingInput" placeholder="Tìm component theo tên, viewPath hoặc template..." autocomplete="off">
            </div>
          </div>
          <div class="col-sm-5">
            <div class="input-group input-group-sm">
              <span class="input-group-text"><i class="ti ti-folder text-muted"></i></span>
              <select class="form-select form-select-sm" id="renderingFolderFilter">
                <option value="all">Tất cả thư mục</option>
              </select>
            </div>
          </div>
        </div>

        <!-- Scope Switcher Pills & Source Indicator -->
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2 pt-1 border-top" id="renderingScopeBar">
          <div class="btn-group btn-group-sm" role="group" id="renderingScopeBtnGroup">
            <button type="button" class="btn btn-sm btn-primary active" id="btnFilterAllRenderings">
              Tất cả (<span id="countAllRenderings">0</span>)
            </button>
            <button type="button" class="btn btn-sm btn-outline-purple" id="btnFilterRecommendedRenderings" style="display: none;">
              <i class="ti ti-star me-1"></i>Khuyên dùng (<span id="countRecommendedRenderings">0</span>)
            </button>
          </div>
          <div class="text-muted small d-flex align-items-center gap-1 font-monospace">
            <i class="ti ti-folder-check text-success"></i>
            <span>/sitecore/layout/Renderings/</span>
          </div>
        </div>

        <!-- Renderings Grid -->
        <div class="row g-2 overflow-auto" id="renderingsGridContainer" style="max-height: 400px; min-height: 180px;">
          <div class="col-12 text-center py-4 text-muted">
            <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
            <div>Đang tải danh sách components từ /sitecore/layout/Renderings/...</div>
          </div>
        </div>
      </div>

      <div class="modal-footer py-2 px-3 bg-light d-flex justify-content-between align-items-center">
        <span class="text-muted small" id="renderingSelectedStats">Đang tải components...</span>
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
      </div>
    </div>
  </div>
</div>

