<div class="modal fade" id="presentationDetailsModal" tabindex="-1" aria-labelledby="presentationDetailsModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl modal-dialog-scrollable">
    <div class="modal-content shadow-2xl rounded-xl border border-slate-200 overflow-hidden">
      <!-- Modal Header -->
      <div class="modal-header py-3 px-4 bg-slate-50/80 border-b border-slate-200 d-flex align-items-center justify-content-between flex items-center justify-between">
        <div class="d-flex align-items-center gap-2.5 flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-indigo-50 border border-indigo-100 flex items-center justify-center text-primary">
            <i class="ti ti-layout-grid text-lg"></i>
          </div>
          <div>
            <h5 class="modal-title m-0 fw-bold fs-3 text-slate-800 text-sm font-bold tracking-tight" id="presentationDetailsModalLabel">
              Presentation Details: <span class="text-primary font-semibold"><%= item.displayName || item.name %></span>
            </h5>
            <div class="text-muted small font-mono text-[11px] text-slate-400 mt-0.5"><%= item.path %></div>
          </div>
        </div>

        <div class="d-flex align-items-center gap-3 flex items-center gap-3">
          <!-- Scope Selector (Shared vs Final) -->
          <div class="btn-group btn-group-sm inline-flex rounded-lg p-0.5 bg-slate-200/60 border border-slate-200 shadow-2xs" role="group" id="presentationScopeGroup">
            <input type="radio" class="btn-check" name="presentationScope" id="scopeShared" value="shared" <%= activeScope === 'shared' || activeScope === 'standard' ? 'checked' : '' %>>
            <label class="btn btn-outline-secondary px-3 py-1 text-xs font-semibold rounded-md transition-all duration-150 cursor-pointer" for="scopeShared" title="Áp dụng cho mọi ngôn ngữ và phiên bản">
              <i class="ti ti-world me-1"></i> Shared Layout
            </label>

            <input type="radio" class="btn-check" name="presentationScope" id="scopeFinal" value="final" <%= activeScope === 'final' ? 'checked' : '' %>>
            <label class="btn btn-outline-secondary px-3 py-1 text-xs font-semibold rounded-md transition-all duration-150 cursor-pointer" for="scopeFinal" title="Ghi đè riêng cho phiên bản hiện hành">
              <i class="ti ti-layers-subtract me-1"></i> Final Layout [<%= (language || 'vi').toUpperCase() %> / v<%= version || 1 %>]
            </label>
          </div>

          <button type="button" class="btn-close text-slate-400 hover:text-slate-600 transition-colors p-1" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
      </div>

      <!-- Modal Body -->
      <div class="modal-body p-4 bg-slate-50/50">
        <!-- Layout Selection Card -->
        <div class="card border border-slate-200/80 rounded-xl bg-white shadow-2xs mb-4">
          <div class="card-body p-3.5">
            <div class="row g-3 align-items-center">
              <div class="col-md-12">
                <label class="form-label small fw-bold text-slate-700 font-semibold text-xs mb-1.5 required block">Layout Trang (EJS View):</label>
                <div class="input-group input-group-sm flex rounded-md overflow-hidden shadow-2xs">
                  <select class="form-select text-xs py-2 px-3 border border-slate-300 rounded-md focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-150 w-full" id="presentationLayoutSelect">
                    <option value="">-- Chưa gán Layout --</option>
                    <% (allLayouts || []).forEach(function(l) { %>
                      <option value="<%= l._id %>" <%= merged && merged.layoutId && merged.layoutId.toString() === l._id.toString() ? 'selected' : '' %>>
                        <%= l.displayName || l.name %> (<%= l.viewPath %>)
                      </option>
                    <% }); %>
                  </select>
                </div>
                <div class="form-hint small text-slate-400 text-[11px] mt-1.5">
                  Layout xác định khung HTML tổng thể và các khối placeholder <code>&lt;%- placeholder('key') %&gt;</code>.
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Placeholders & Renderings List -->
        <div id="placeholdersContainer" class="d-flex flex-column gap-3.5 flex flex-col space-y-3.5">
          <% 
            const definedPlaceholders = (allPlaceholders && allPlaceholders.length > 0)
              ? allPlaceholders.map(p => p.placeholderKey)
              : ['header', 'maincontent', 'footer'];

            const existingKeys = Object.keys(merged ? (merged.placeholders || {}) : {});
            const allKeys = Array.from(new Set([...definedPlaceholders, ...existingKeys]));
          %>

          <% allKeys.forEach(function(phKey) { 
               const phRenderings = (merged && merged.placeholders && merged.placeholders[phKey]) ? merged.placeholders[phKey] : [];
               const phMeta = (allPlaceholders || []).find(p => p.placeholderKey === phKey);
          %>
            <div class="card border border-slate-200/90 rounded-xl bg-white placeholder-card shadow-2xs overflow-hidden" data-placeholder="<%= phKey %>">
              <div class="card-header py-2.5 px-3.5 bg-slate-50/80 border-b border-slate-200 d-flex align-items-center justify-content-between flex items-center justify-between">
                <div class="d-flex align-items-center gap-2 flex items-center gap-2">
                  <span class="badge bg-slate-800 text-white font-mono px-2 py-0.5 text-xs rounded-md flex items-center gap-1">
                    <i class="ti ti-brackets"></i><%= phKey %>
                  </span>
                  <% if (phMeta && phMeta.description) { %>
                    <span class="text-slate-400 text-xs">(<%= phMeta.description %>)</span>
                  <% } %>
                  <span class="badge bg-slate-200/80 text-slate-600 font-mono rounded-full text-[10px] px-2 py-0.5 count-badge"><%= phRenderings.length %> component</span>
                </div>
                <div>
                  <button type="button" class="btn btn-sm btn-outline-primary py-1 px-2.5 text-xs font-semibold rounded-md border border-primary/30 text-primary bg-primary/5 hover:bg-primary/10 transition-all duration-150 active:scale-95 d-flex align-items-center gap-1.5 btn-add-rendering inline-flex items-center" data-placeholder="<%= phKey %>">
                    <i class="ti ti-plus text-xs"></i> Thêm Component
                  </button>
                </div>
              </div>

              <div class="card-body p-2.5 bg-slate-50/30 renderings-dropzone space-y-2" data-placeholder="<%= phKey %>" style="min-height: 70px;">
                <% if (phRenderings.length === 0) { %>
                  <div class="empty-dropzone text-center py-4 text-slate-400 text-xs border-2 border-dashed border-slate-200 rounded-lg bg-white">
                    <i class="ti ti-drag-drop text-2xl text-slate-300 block mb-1"></i>
                    <div>Chưa có component nào trong placeholder <strong class="text-slate-600"><%= phKey %></strong>. Nhấn "Thêm Component" để bắt đầu.</div>
                  </div>
                <% } %>

                <% phRenderings.forEach(function(r) { %>
                  <div class="card mb-2 rendering-item shadow-2xs border border-slate-200 rounded-lg cursor-move bg-white hover:border-slate-300 transition-all duration-150" 
                       data-uid="<%= r.uid %>"
                       data-rendering-id="<%= r.renderingId %>"
                       data-placeholder="<%= r.placeholderKey || r.placeholder %>"
                       data-sort-order="<%= r.sortOrder %>"
                       data-datasource-id="<%= r.datasourceId || '' %>"
                       data-parameters='<%= JSON.stringify(r.parameters || {}) %>'
                       data-origin="<%= r.origin %>"
                       data-hidden="<%= r.hidden ? 'true' : 'false' %>">
                    <div class="card-body p-2.5 d-flex align-items-center justify-content-between gap-2.5 flex items-center justify-between">
                      <div class="d-flex align-items-center gap-2.5 flex-fill text-truncate flex items-center gap-2.5 flex-1 min-w-0">
                        <span class="drag-handle text-slate-400 hover:text-slate-600 cursor-move px-1 py-0.5 rounded transition-colors" title="Kéo để sắp xếp">
                          <i class="ti ti-grip-vertical text-base"></i>
                        </span>

                        <span class="avatar avatar-xs rounded-lg bg-indigo-50 border border-indigo-100 text-primary w-7 h-7 flex items-center justify-center">
                          <i class="<%= r.icon || 'ti ti-box' %> text-sm"></i>
                        </span>

                        <div class="text-truncate min-w-0 flex-1">
                          <div class="d-flex align-items-center gap-2 flex items-center gap-2">
                            <span class="fw-bold small text-slate-800 text-xs font-semibold truncate"><%= r.displayName || r.name %></span>
                            <span class="badge bg-slate-100 text-slate-500 font-mono text-[10px] px-1.5 py-0.2 rounded border border-slate-200"><%= r.viewPath %></span>

                            <% if (r.origin === 'standard') { %>
                              <span class="badge bg-slate-100 text-slate-600 font-mono text-[9px] px-1.5 py-0.2 rounded border" title="Kế thừa từ Standard Presentation của Template">
                                <i class="ti ti-file-symlink me-0.5"></i>Standard
                              </span>
                            <% } else if (r.origin === 'shared') { %>
                              <span class="badge bg-blue-50 text-blue-700 font-mono text-[9px] px-1.5 py-0.2 rounded border border-blue-200" title="Ghi đè ở cấp độ Shared Layout">
                                <i class="ti ti-world me-0.5"></i>Shared
                              </span>
                            <% } else if (r.origin === 'final') { %>
                              <span class="badge bg-emerald-50 text-emerald-700 font-mono text-[9px] px-1.5 py-0.2 rounded border border-emerald-200" title="Ghi đè riêng cho phiên bản ngôn ngữ này">
                                <i class="ti ti-layers-subtract me-0.5"></i>Final
                              </span>
                            <% } %>
                          </div>

                          <div class="text-muted small d-flex align-items-center gap-2 mt-0.5 text-[11px] text-slate-400 flex items-center gap-2">
                            <% if (r.datasourceId) { %>
                              <span class="text-truncate text-sky-700 font-medium" title="Datasource ID: <%= r.datasourceId %>">
                                <i class="ti ti-database me-1"></i>Datasource riêng: <%= r.datasourceId %>
                              </span>
                            <% } else { %>
                              <span class="text-slate-400 italic">
                                <i class="ti ti-arrow-guide me-1"></i>Đọc trường trực tiếp từ Page Item
                              </span>
                            <% } %>

                            <% if (r.parameters && Object.keys(r.parameters).length > 0) { %>
                              <span class="badge bg-amber-50 text-amber-700 border border-amber-200 font-mono text-[9px] px-1.5 py-0.2 rounded" title="Có cấu hình parameters">
                                <i class="ti ti-adjustments me-0.5"></i><%= Object.keys(r.parameters).length %> params
                              </span>
                            <% } %>
                          </div>
                        </div>
                      </div>

                      <div class="d-flex align-items-center gap-1.5 flex items-center">
                        <button type="button" class="btn btn-sm btn-ghost-secondary p-1.5 rounded-md hover:bg-slate-100 text-slate-500 hover:text-slate-800 transition-all duration-150 active:scale-95 btn-edit-rendering" title="Chỉnh sửa datasource và parameters">
                          <i class="ti ti-pencil text-sm"></i>
                        </button>
                        <button type="button" class="btn btn-sm btn-ghost-danger p-1.5 rounded-md hover:bg-rose-50 text-rose-500 hover:text-rose-600 transition-all duration-150 active:scale-95 btn-remove-rendering" title="Xóa component này">
                          <i class="ti ti-trash text-sm"></i>
                        </button>
                      </div>
                    </div>
                  </div>
                <% }); %>
              </div>
            </div>
          <% }); %>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="modal-footer py-3 px-4 bg-white border-t border-slate-200 d-flex align-items-center justify-content-between flex items-center justify-between">
        <div class="d-flex align-items-center gap-2 flex items-center gap-2">
          <button type="button" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1.5 inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-md border border-rose-200 text-rose-600 hover:bg-rose-50 transition-all duration-150 active:scale-95" id="btnResetToStandard">
            <i class="ti ti-rotate-clockwise text-xs"></i> Reset về Standard
          </button>
          <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1.5 inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-md border border-slate-300 text-slate-700 hover:bg-slate-50 transition-all duration-150 active:scale-95" id="btnPreviewPresentationJson">
            <i class="ti ti-code text-xs"></i> Xem Cấu Trúc Bố Cục
          </button>
        </div>

        <div class="d-flex align-items-center gap-2 flex items-center gap-2">
          <button type="button" class="btn btn-sm btn-secondary px-3.5 py-1.5 text-xs font-medium rounded-md border border-slate-300 hover:bg-slate-100 transition-all duration-150 active:scale-95" data-bs-dismiss="modal">Đóng</button>
          <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-1.5 inline-flex items-center px-4 py-1.5 text-xs font-semibold rounded-md shadow-xs transition-all duration-150 active:scale-95 hover:shadow-sm focus:ring-2 focus:ring-primary/40 focus:outline-none" id="btnSavePresentation">
            <i class="ti ti-device-floppy text-sm"></i> Lưu Cấu Hình
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
