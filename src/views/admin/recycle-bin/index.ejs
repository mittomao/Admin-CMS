<div class="container-xl py-4">
  <!-- Page Header -->
  <div class="page-header d-print-none mb-4">
    <div class="row g-2 align-items-center">
      <div class="col">
        <div class="page-pretitle text-uppercase font-semibold text-slate-400">
          Treecraft An toàn Dữ liệu &bull; GĐ 9
        </div>
        <h2 class="page-title text-slate-900 dark:text-white d-flex align-items-center gap-2">
          <i class="ti ti-trash text-danger"></i>
          <span>Thùng rác (Recycle Bin)</span>
        </h2>
        <p class="text-slate-500 dark:text-slate-400 text-xs mt-1 mb-0">
          Quản lý các đối tượng nội dung đã xóa mềm, kiểm tra tham chiếu an toàn, khôi phục nguyên trạng hoặc dọn dẹp vĩnh viễn.
        </p>
      </div>
      <div class="col-auto ms-auto d-print-none d-flex gap-2">
        <a href="/admin/content-editor" class="btn btn-outline-secondary d-flex align-items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg shadow-2xs">
          <i class="ti ti-arrow-left"></i>
          <span>Content Editor</span>
        </a>
        <a href="/admin/audit-log" class="btn btn-outline-primary d-flex align-items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg shadow-2xs">
          <i class="ti ti-history"></i>
          <span>Nhật ký Kiểm toán</span>
        </a>
        <% if (permissions.canPurge && items.length > 0) { %>
        <button type="button" class="btn btn-danger d-flex align-items-center gap-1.5 text-xs font-semibold px-3 py-1.5 rounded-lg shadow-2xs" id="btn-purge-all">
          <i class="ti ti-flame"></i>
          <span>Dọn sạch Thùng rác</span>
        </button>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Filter & Search Toolbar -->
  <div class="card mb-3 border-0 shadow-sm rounded-xl">
    <div class="card-body p-3">
      <form method="GET" action="/admin/recycle-bin" class="row g-2 align-items-center">
        <div class="col-md-5">
          <div class="input-icon">
            <span class="input-icon-addon"><i class="ti ti-search"></i></span>
            <input type="text" name="q" class="form-control form-control-sm rounded-lg" placeholder="Tìm theo tên item, đường dẫn cũ..." value="<%= filters.q || '' %>">
          </div>
        </div>
        <div class="col-md-3">
          <input type="date" name="from" class="form-control form-control-sm rounded-lg" title="Từ ngày" value="<%= filters.from || '' %>">
        </div>
        <div class="col-md-3">
          <input type="date" name="to" class="form-control form-control-sm rounded-lg" title="Đến ngày" value="<%= filters.to || '' %>">
        </div>
        <div class="col-md-1 d-flex gap-1">
          <button type="submit" class="btn btn-sm btn-primary w-100 rounded-lg" title="Lọc dữ liệu">
            <i class="ti ti-filter"></i>
          </button>
          <% if (filters.q || filters.from || filters.to) { %>
          <a href="/admin/recycle-bin" class="btn btn-sm btn-outline-secondary rounded-lg" title="Xóa bộ lọc">
            <i class="ti ti-x"></i>
          </a>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <!-- Main Content Table -->
  <div class="card border-0 shadow-sm rounded-xl overflow-hidden">
    <div class="table-responsive">
      <table class="table table-vcenter table-hover card-table mb-0">
        <thead class="bg-slate-50 dark:bg-slate-800 text-slate-500 text-xs font-semibold text-uppercase">
          <tr>
            <th style="width: 35%;">Đối tượng</th>
            <th style="width: 25%;">Đường dẫn ban đầu</th>
            <th style="width: 15%;">Người xoá</th>
            <th style="width: 15%;">Thời gian xoá</th>
            <th style="width: 10%;" class="text-end">Hành động</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800 text-sm">
          <% if (!items || items.length === 0) { %>
          <tr>
            <td colspan="5" class="text-center py-5 text-slate-400">
              <i class="ti ti-trash-off fs-1 d-block mb-2 text-slate-300"></i>
              <span>Thùng rác trống. Không có mục nào đã bị xóa.</span>
            </td>
          </tr>
          <% } else { %>
            <% items.forEach(function(item) { %>
            <tr id="row-<%= item._id %>">
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="avatar avatar-xs rounded bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-200">
                    <i class="<%= item.templateId?.icon || 'ti ti-file' %>"></i>
                  </div>
                  <div>
                    <div class="font-semibold text-slate-900 dark:text-white">
                      <%= item.displayName || item.name %>
                    </div>
                    <div class="text-xs text-slate-400">
                      Template: <%= item.templateId?.displayName || item.templateId?.name || 'Item' %> &bull; ID: <code><%= item._id %></code>
                    </div>
                  </div>
                </div>
              </td>
              <td class="text-slate-600 dark:text-slate-300 font-mono text-xs">
                <%= item.deletedFromPath || item.path || '-' %>
              </td>
              <td class="text-slate-600 dark:text-slate-300 text-xs">
                <%= item.deletedBy?.fullName || item.deletedBy?.username || '[Hệ thống]' %>
              </td>
              <td class="text-slate-500 dark:text-slate-400 text-xs font-mono">
                <%= item.deletedAt ? new Date(item.deletedAt).toLocaleString('vi-VN') : '-' %>
              </td>
              <td class="text-end">
                <div class="btn-group btn-group-sm">
                  <% if (permissions.canRestore) { %>
                  <button type="button" class="btn btn-outline-success btn-restore" data-id="<%= item._id %>" data-name="<%= item.displayName || item.name %>" title="Khôi phục về vị trí ban đầu">
                    <i class="ti ti-arrow-back-up"></i>
                  </button>
                  <% } %>
                  <% if (permissions.canPurge) { %>
                  <button type="button" class="btn btn-outline-danger btn-purge" data-id="<%= item._id %>" data-name="<%= item.displayName || item.name %>" title="Xoá vĩnh viễn (Hard Delete)">
                    <i class="ti ti-trash-x"></i>
                  </button>
                  <% } %>
                </div>
              </td>
            </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination Footer -->
    <% if (pagination && pagination.totalPages > 1) { %>
    <div class="card-footer d-flex align-items-center justify-content-between p-3 bg-slate-50 dark:bg-slate-800 border-top">
      <div class="text-xs text-slate-500">
        Hiển thị trang <strong><%= pagination.page %></strong> / <strong><%= pagination.totalPages %></strong> (Tổng cộng <strong><%= pagination.total %></strong> mục)
      </div>
      <ul class="pagination pagination-sm m-0">
        <% if (pagination.page > 1) { %>
        <li class="page-item">
          <a class="page-link" href="?page=<%= pagination.page - 1 %>&q=<%= filters.q %>&from=<%= filters.from %>&to=<%= filters.to %>">
            <i class="ti ti-chevron-left"></i>
          </a>
        </li>
        <% } %>
        <% for (let p = 1; p <= pagination.totalPages; p++) { %>
          <% if (p === pagination.page || p === 1 || p === pagination.totalPages || (p >= pagination.page - 2 && p <= pagination.page + 2)) { %>
          <li class="page-item <%= p === pagination.page ? 'active' : '' %>">
            <a class="page-link" href="?page=<%= p %>&q=<%= filters.q %>&from=<%= filters.from %>&to=<%= filters.to %>"><%= p %></a>
          </li>
          <% } else if (p === pagination.page - 3 || p === pagination.page + 3) { %>
          <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
          <% } %>
        <% } %>
        <% if (pagination.page < pagination.totalPages) { %>
        <li class="page-item">
          <a class="page-link" href="?page=<%= pagination.page + 1 %>&q=<%= filters.q %>&from=<%= filters.from %>&to=<%= filters.to %>">
            <i class="ti ti-chevron-right"></i>
          </a>
        </li>
        <% } %>
      </ul>
    </div>
    <% } %>
  </div>
</div>

<!-- Modal Restore Confirmation -->
<div class="modal modal-blur fade" id="modal-restore" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title d-flex align-items-center gap-2">
          <i class="ti ti-arrow-back-up text-success"></i>
          <span>Khôi phục Item</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="mb-3">Bạn đang chuẩn bị khôi phục mục: <strong id="restore-item-name" class="text-slate-900"></strong></p>
        <div id="restore-parent-info" class="p-3 bg-slate-50 dark:bg-slate-800 rounded-lg text-xs mb-3 font-mono">
          Đang kiểm tra vị trí cha ban đầu...
        </div>
        <div id="restore-parent-selector-container" class="mb-3" style="display: none;">
          <label class="form-label text-xs font-semibold text-danger">Node cha ban đầu không tồn tại. Vui lòng nhập ID cha đích:</label>
          <input type="text" id="restore-target-parent-id" class="form-control form-control-sm" placeholder="ObjectId của node cha đích (VD: root hoặc content ID)">
        </div>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" id="restore-rename-duplicate" checked>
          <label class="form-check-label text-xs" for="restore-rename-duplicate">
            Tự động đổi tên hậu tố <code>(Restored)</code> nếu bị trùng tên tại vị trí cha.
          </label>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-link link-secondary me-auto" data-bs-dismiss="modal">Hủy bỏ</button>
        <button type="button" class="btn btn-success" id="btn-confirm-restore">
          <i class="ti ti-check me-1"></i> Xác nhận Khôi phục
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal Purge Confirmation -->
<div class="modal modal-blur fade" id="modal-purge" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title d-flex align-items-center gap-2 text-danger">
          <i class="ti ti-alert-triangle"></i>
          <span>Xác nhận Xóa vĩnh viễn (Hard Delete)</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="mb-2">Hành động này sẽ <strong>xóa vĩnh viễn</strong> mục: <strong id="purge-item-name" class="text-danger"></strong> và tất cả các mục con.</p>
        <div class="alert alert-danger text-xs mb-3">
          <i class="ti ti-flame me-1"></i>
          Dữ liệu sẽ bị gỡ bỏ triệt để khỏi MongoDB Master, kho xuất bản Web Store và tài nguyên Media liên quan. Không thể hoàn tác!
        </div>
        <div id="purge-references-container" class="text-xs"></div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-link link-secondary me-auto" data-bs-dismiss="modal">Hủy bỏ</button>
        <button type="button" class="btn btn-danger" id="btn-confirm-purge">
          <i class="ti ti-trash-x me-1"></i> Xóa Vĩnh Viễn
        </button>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const csrfToken = '<%= csrfToken %>';
  let activeItemId = null;

  // Restore flow
  const restoreModalEl = document.getElementById('modal-restore');
  const restoreModal = restoreModalEl ? new bootstrap.Modal(restoreModalEl) : null;
  const restoreParentInfo = document.getElementById('restore-parent-info');
  const restoreParentSelector = document.getElementById('restore-parent-selector-container');
  const restoreTargetParentInput = document.getElementById('restore-target-parent-id');

  document.querySelectorAll('.btn-restore').forEach(btn => {
    btn.addEventListener('click', async () => {
      activeItemId = btn.dataset.id;
      document.getElementById('restore-item-name').textContent = btn.dataset.name;
      restoreParentInfo.textContent = 'Đang kiểm tra vị trí cha ban đầu...';
      restoreParentSelector.style.display = 'none';
      restoreTargetParentInput.value = '';
      restoreModal.show();

      try {
        const res = await fetch(`/api/recycle-bin/${activeItemId}`);
        const data = await res.json();
        if (data.success) {
          const { parentStatus } = data.data;
          if (parentStatus.originalParentExists && !parentStatus.isOriginalParentDeleted) {
            restoreParentInfo.innerHTML = `<span class="text-success"><i class="ti ti-check"></i> Node cha gốc hợp lệ:</span> <strong>${parentStatus.originalParentName}</strong> (ID: <code>${parentStatus.originalParentId}</code>)`;
          } else {
            restoreParentInfo.innerHTML = `<span class="text-warning"><i class="ti ti-alert-triangle"></i> Node cha gốc không còn tồn tại hoặc đang trong Thùng rác.</span> Vui lòng nhập ID cha đích bên dưới.`;
            restoreParentSelector.style.display = 'block';
          }
        }
      } catch (err) {
        restoreParentInfo.textContent = 'Không thể kiểm tra node cha gốc.';
      }
    });
  });

  document.getElementById('btn-confirm-restore')?.addEventListener('click', async () => {
    if (!activeItemId) return;
    const targetParentId = restoreTargetParentInput.value.trim() || undefined;
    const renameIfDuplicate = document.getElementById('restore-rename-duplicate').checked;

    try {
      const res = await fetch(`/api/recycle-bin/restore/${activeItemId}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-CSRF-Token': csrfToken,
          'CSRF-Token': csrfToken,
        },
        body: JSON.stringify({ targetParentId, renameIfDuplicate }),
      });
      const data = await res.json().catch(() => null);
      if (res.ok && data?.success) {
        restoreModal.hide();
        window.location.reload();
      } else {
        alert(data?.message || `Lỗi khi khôi phục item (Mã: ${res.status}).`);
      }
    } catch (err) {
      console.error(err);
      alert('Lỗi kết nối máy chủ khi khôi phục: ' + (err.message || err));
    }
  });

  // Purge flow
  const purgeModalEl = document.getElementById('modal-purge');
  const purgeModal = purgeModalEl ? new bootstrap.Modal(purgeModalEl) : null;
  const purgeRefsContainer = document.getElementById('purge-references-container');

  document.querySelectorAll('.btn-purge').forEach(btn => {
    btn.addEventListener('click', async () => {
      activeItemId = btn.dataset.id;
      document.getElementById('purge-item-name').textContent = btn.dataset.name;
      purgeRefsContainer.innerHTML = 'Đang kiểm tra toàn vẹn tham chiếu...';
      purgeModal.show();

      try {
        const res = await fetch(`/api/recycle-bin/${activeItemId}`, {
          headers: { 'Accept': 'application/json' },
        });
        const data = await res.json().catch(() => null);
        if (data && data.success && data.data.references) {
          const refs = data.data.references;
          if (refs.blockingCount > 0) {
            purgeRefsContainer.innerHTML = `<div class="alert alert-danger p-2 mb-0"><strong>Chặn xóa:</strong> Có ${refs.blockingCount} thành phần đang phụ thuộc vào item này.</div>`;
          } else {
            purgeRefsContainer.innerHTML = `<div class="text-success"><i class="ti ti-check"></i> Không có ràng buộc phụ thuộc chặn xoá.</div>`;
          }
        }
      } catch (err) {
        purgeRefsContainer.innerHTML = '';
      }
    });
  });

  document.getElementById('btn-confirm-purge')?.addEventListener('click', async () => {
    if (!activeItemId) return;

    try {
      const res = await fetch(`/api/recycle-bin/purge/${activeItemId}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-CSRF-Token': csrfToken,
          'CSRF-Token': csrfToken,
        },
      });
      const data = await res.json().catch(() => null);
      if (res.ok && data?.success) {
        purgeModal.hide();
        window.location.reload();
      } else {
        alert(data?.message || `Lỗi khi xóa vĩnh viễn item (Mã: ${res.status}).`);
      }
    } catch (err) {
      console.error(err);
      alert('Lỗi kết nối máy chủ khi xóa vĩnh viễn: ' + (err.message || err));
    }
  });

  // Purge All
  document.getElementById('btn-purge-all')?.addEventListener('click', async () => {
    if (!confirm('Bạn có chắc chắn muốn DỌN SẠCH toàn bộ Thùng rác? Toàn bộ các mục trong thùng rác sẽ bị xóa vĩnh viễn không thể khôi phục.')) {
      return;
    }
    try {
      const res = await fetch('/api/recycle-bin/purge-all', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-CSRF-Token': csrfToken,
          'CSRF-Token': csrfToken,
        },
      });
      const data = await res.json().catch(() => null);
      if (res.ok && data?.success) {
        window.location.reload();
      } else {
        alert(data?.message || `Lỗi khi dọn sạch Thùng rác (Mã: ${res.status}).`);
      }
    } catch (err) {
      console.error(err);
      alert('Lỗi kết nối khi dọn sạch Thùng rác: ' + (err.message || err));
    }
  });
});
</script>

