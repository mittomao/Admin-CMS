<%
  const u = typeof usage !== 'undefined' && usage ? usage : { itemsCount: 0, sampleItems: [], inheritingTemplates: [], canDelete: true };
%>
<div class="card shadow-sm border border-slate-200/80 rounded-xl bg-white overflow-hidden">
  <div class="card-header bg-slate-50/70 py-3 px-4 d-flex align-items-center justify-content-between flex items-center justify-between border-b border-slate-200">
    <div>
      <h4 class="card-title m-0 fw-bold fs-3 text-slate-900 font-bold text-base tracking-tight">Template Usage & Dependencies</h4>
      <p class="text-muted small m-0 text-xs text-slate-500 mt-0.5">Audit which content items and child templates depend on this template.</p>
    </div>
    <div>
      <% if (template.isSystem) { %>
        <span class="badge bg-sky-50 text-sky-700 border border-sky-200 text-xs px-2.5 py-1 rounded-md font-mono flex items-center gap-1"><i class="ti ti-lock me-1"></i>Protected System Template</span>
      <% } else if (u.canDelete) { %>
        <span class="badge bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs px-2.5 py-1 rounded-md font-mono flex items-center gap-1"><i class="ti ti-check me-1"></i>Safe to Delete (0 Dependencies)</span>
      <% } else { %>
        <span class="badge bg-amber-50 text-amber-700 border border-amber-200 text-xs px-2.5 py-1 rounded-md font-mono flex items-center gap-1"><i class="ti ti-alert-triangle me-1"></i>In Use (Cannot Delete)</span>
      <% } %>
    </div>
  </div>

  <div class="card-body p-4">
    <div class="row g-3 mb-5">
      <div class="col-sm-6">
        <div class="card card-sm bg-slate-50/70 border border-slate-200 rounded-xl p-3.5">
          <div class="d-flex align-items-center gap-3 flex items-center gap-3">
            <span class="avatar rounded-xl bg-blue-50 text-primary border border-blue-100 w-10 h-10 flex items-center justify-center"><i class="ti ti-files text-xl"></i></span>
            <div>
              <div class="text-muted small font-mono text-[11px] text-slate-400">Content Items Using Template</div>
              <div class="h2 m-0 fw-bold text-slate-900 text-2xl font-bold"><%= u.itemsCount %></div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-sm-6">
        <div class="card card-sm bg-slate-50/70 border border-slate-200 rounded-xl p-3.5">
          <div class="d-flex align-items-center gap-3 flex items-center gap-3">
            <span class="avatar rounded-xl bg-purple-50 text-purple-600 border border-purple-100 w-10 h-10 flex items-center justify-center"><i class="ti ti-git-fork text-xl"></i></span>
            <div>
              <div class="text-muted small font-mono text-[11px] text-slate-400">Templates Inheriting This Base</div>
              <div class="h2 m-0 fw-bold text-slate-900 text-2xl font-bold"><%= u.inheritingTemplates ? u.inheritingTemplates.length : 0 %></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Items List -->
    <h5 class="fw-bold mb-2.5 text-slate-800 text-sm font-bold">Sample Content Items</h5>
    <% if (!u.sampleItems || u.sampleItems.length === 0) { %>
      <div class="p-3 bg-slate-50 rounded-lg border border-slate-200 text-slate-400 text-xs italic mb-5">
        No content items are currently based on this template.
      </div>
    <% } else { %>
      <div class="table-responsive mb-5 border border-slate-200 rounded-xl overflow-hidden shadow-2xs">
        <table class="table table-vcenter card-table table-striped w-full text-left text-xs">
          <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 font-mono text-[11px]">
            <tr>
              <th class="py-2.5 px-3 font-semibold">Item Name</th>
              <th class="py-2.5 px-3 font-semibold">Materialized Path</th>
              <th class="py-2.5 px-3 font-semibold">Last Modified</th>
              <th class="py-2.5 px-3 font-semibold w-1 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% u.sampleItems.forEach(item => { %>
              <tr class="hover:bg-slate-50/80 transition-colors">
                <td class="py-2 px-3 fw-bold font-semibold text-slate-800"><%= item.displayName || item.name %></td>
                <td class="py-2 px-3 font-mono text-slate-400 text-[11px]"><%= item.path %></td>
                <td class="py-2 px-3 text-slate-500"><%= item.updatedAt ? new Date(item.updatedAt).toLocaleString() : 'N/A' %></td>
                <td class="py-2 px-3 text-right">
                  <a href="/admin/content-editor/<%= item._id %>" class="btn btn-sm btn-outline-secondary p-1 rounded hover:bg-slate-100 text-slate-600 transition-all duration-150 active:scale-95 inline-flex items-center" target="_blank" title="Open in Content Editor">
                    <i class="ti ti-external-link text-xs"></i>
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>

    <!-- Inheriting Templates List -->
    <h5 class="fw-bold mb-2.5 text-slate-800 text-sm font-bold">Inheriting Templates</h5>
    <% if (!u.inheritingTemplates || u.inheritingTemplates.length === 0) { %>
      <div class="p-3 bg-slate-50 rounded-lg border border-slate-200 text-slate-400 text-xs italic">
        No other templates inherit from this template.
      </div>
    <% } else { %>
      <div class="d-flex flex-wrap gap-2 flex flex-wrap">
        <% u.inheritingTemplates.forEach(t => { %>
          <a href="/admin/template-manager/<%= t._id %>" class="badge bg-purple-50 text-purple-700 hover:bg-purple-100 p-2 d-flex align-items-center gap-2 border border-purple-200 rounded-lg text-decoration-none transition-all duration-150 active:scale-95 flex items-center gap-2">
            <i class="<%= t.icon || 'ti ti-file-text' %> text-base"></i>
            <span class="fs-3 fw-semibold text-xs font-semibold"><%= t.displayName || t.name %></span>
          </a>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

