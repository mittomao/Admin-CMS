<%
  const currentBaseIds = (template.baseTemplates || []).map(b => (b._id ? b._id.toString() : b.toString()));
  const allTpls = typeof allTemplates !== 'undefined' ? allTemplates.filter(t => t._id.toString() !== template._id.toString()) : [];
  const resolvedBaseTemplates = resolved && resolved.baseTemplates ? resolved.baseTemplates : [];
  const compTemplates = locals.componentTemplates || resolved?.componentTemplates || [];
%>
<form id="templateInheritanceForm">
  <div class="card shadow-sm border border-slate-200/80 rounded-xl bg-white overflow-hidden">
    <div class="card-header bg-slate-50/70 py-3 px-4 d-flex align-items-center justify-content-between flex items-center justify-between border-b border-slate-200">
      <div>
        <h4 class="card-title m-0 fw-bold fs-3 text-slate-900 font-bold text-base tracking-tight">Template Inheritance</h4>
        <p class="text-muted small m-0 text-xs text-slate-500 mt-0.5">
          Inherit sections and fields from one or more Base Templates (e.g., SEO, Page Metadata).
        </p>
      </div>
      <button type="submit" class="btn btn-sm btn-primary d-flex align-items-center gap-1.5 inline-flex items-center px-3.5 py-1.5 text-xs font-semibold rounded-md shadow-xs transition-all duration-150 active:scale-95 hover:shadow-sm focus:ring-2 focus:ring-primary/40 focus:outline-none" id="btnSaveBaseTemplates">
        <i class="ti ti-device-floppy text-sm"></i>
        <span>Save Base Templates</span>
      </button>
    </div>

    <div class="card-body p-4">
      <!-- Active Base Templates Summary -->
      <h5 class="fw-bold mb-2.5 text-slate-800 text-sm font-bold">Active Base Templates</h5>
      <% if (resolvedBaseTemplates.length === 0) { %>
        <div class="p-3 bg-slate-50 rounded-lg border border-slate-200 text-slate-500 text-xs mb-5 flex items-center gap-2">
          <i class="ti ti-info-circle text-sky-600 text-sm"></i>
          <span>This template does not inherit from any base templates. Select one or more below.</span>
        </div>
      <% } else { %>
        <div class="d-flex flex-wrap gap-2 mb-5 flex flex-wrap">
          <% resolvedBaseTemplates.forEach(b => { %>
            <div class="badge bg-purple-50 text-purple-700 p-2 d-flex align-items-center gap-2 border border-purple-200 rounded-lg flex items-center gap-2">
              <i class="<%= b.icon || 'ti ti-template' %> text-base"></i>
              <span class="fs-3 fw-semibold text-xs font-semibold"><%= b.displayName || b.name %></span>
              <span class="font-mono opacity-75 text-[10px]">(<%= b.name %>)</span>
            </div>
          <% }) %>
        </div>
      <% } %>

      <!-- Component Templates from Standard Presentation (DEC-036) -->
      <div class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-2 flex items-center justify-between">
          <h5 class="fw-bold mb-0 text-slate-800 d-flex align-items-center gap-2 flex items-center gap-2 text-sm font-bold">
            <i class="ti ti-puzzle text-purple-600 text-base"></i>
            <span>Component Templates (từ Standard Presentation)</span>
            <span class="badge bg-purple-50 text-purple-700 border border-purple-200 text-[10px] font-mono px-2 py-0.5 rounded">DEC-036: Effective Inherited</span>
          </h5>
          <span class="text-muted small text-xs text-slate-400 font-mono">Tự động liên kết qua Renderings</span>
        </div>

        <% if (compTemplates.length === 0) { %>
          <div class="p-3 bg-slate-50 rounded-lg border border-slate-200 text-slate-400 text-xs italic flex items-center gap-2">
            <i class="ti ti-info-circle text-slate-400"></i>
            <span>Chưa có rendering nào trong Standard Presentation liên kết với Component Template.</span>
          </div>
        <% } else { %>
          <div class="alert alert-info py-2.5 px-3.5 rounded-lg bg-sky-50 border border-sky-200 text-sky-800 text-xs d-flex align-items-center gap-2.5 mb-3 flex items-center gap-2.5">
            <i class="ti ti-info-circle text-lg text-sky-600 flex-shrink-0"></i>
            <div>
              Theo quyết định kiến trúc <strong class="font-semibold">DEC-036</strong>, các Component Template này được <strong class="font-semibold">liên kết tự động qua Standard Presentation</strong> (không cần chọn làm Base Template). Khi tạo hoặc mở trang từ template này, các trường của component sẽ tự động xuất hiện trên form nhập liệu.
            </div>
          </div>
          <div class="d-flex flex-wrap gap-2.5 flex flex-wrap">
            <% compTemplates.forEach(ct => { %>
              <div class="badge bg-purple-50 p-2.5 d-flex align-items-center gap-2.5 border border-purple-200 rounded-xl flex items-center justify-between shadow-2xs hover:border-purple-300 transition-all duration-150">
                <div class="flex items-center gap-2.5">
                  <i class="<%= ct.icon || 'ti ti-puzzle' %> text-lg text-purple-600"></i>
                  <div class="text-start text-left">
                    <div class="fs-4 fw-semibold text-slate-800 text-xs font-semibold"><%= ct.displayName || ct.name %></div>
                    <div class="text-slate-400 font-mono text-[10px]">
                      Component: <%= ct.renderingDisplayName || ct.renderingName %> · <%= ct.fieldsCount || 0 %> fields
                    </div>
                  </div>
                </div>
                <a href="/admin/template-manager/<%= ct._id %>" class="btn btn-sm btn-ghost-purple p-1 ms-2 rounded hover:bg-purple-100 text-purple-700 transition-all duration-150 active:scale-95" title="Mở Component Template" target="_blank">
                  <i class="ti ti-external-link text-xs"></i>
                </a>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>

      <!-- Base Templates Selector Grid -->
      <h5 class="fw-bold mb-2.5 text-slate-800 text-sm font-bold">Select Base Templates</h5>
      <div class="row row-cards g-2.5 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5">
        <% allTpls.forEach(t => { %>
          <%
            const isBase = currentBaseIds.includes(t._id.toString());
            const isComponentTemplate = (t.path && t.path.toLowerCase().includes('/feature/components')) ||
              ['herobanner', 'introduction', 'imagetext'].includes(t.name.toLowerCase());
          %>
          <div class="col-sm-6 col-md-4">
            <label class="card card-sm card-link-pop h-100 p-2.5 cursor-pointer rounded-lg border transition-all duration-150 block <%= isBase ? 'border-purple-400 bg-purple-50/70 shadow-xs' : 'border-slate-200 bg-white hover:border-slate-300 hover:bg-slate-50' %>">
              <div class="d-flex align-items-center gap-2 flex items-center gap-2.5">
                <input
                  type="checkbox"
                  name="baseTemplateIds[]"
                  value="<%= t._id %>"
                  class="form-check-input m-0 base-tpl-checkbox rounded text-primary focus:ring-primary cursor-pointer"
                  <%= isBase ? 'checked' : '' %>
                />
                <i class="<%= t.icon || 'ti ti-file-text' %> fs-2 text-base <%= isBase ? 'text-purple-600' : 'text-slate-500' %>"></i>
                <div class="overflow-hidden min-w-0">
                  <div class="fw-semibold text-truncate small text-slate-800 text-xs font-medium truncate"><%= t.displayName || t.name %></div>
                    <% if (isComponentTemplate) { %>
                      <span class="badge bg-amber-50 text-amber-700 border border-amber-200 text-[9px] px-1.5 py-0.2 rounded font-mono" title="Component Template - Trường sẽ được tự động suy ra khi gắn vào Presentation. Không khuyến khích kế thừa trực tiếp làm Base Template">
                        <i class="ti ti-alert-triangle"></i> Comp
                      </span>
                    <% } %>
                  </div>
                  <div class="text-muted font-monospace font-mono text-[10px] text-slate-400 truncate"><%= t.name %></div>
                </div>
              </div>
            </label>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="card-footer bg-slate-50/70 py-3 px-4 border-t border-slate-200 d-flex justify-content-end flex justify-end">
      <button type="submit" class="btn btn-sm btn-primary d-flex align-items-center gap-1.5 inline-flex items-center px-3.5 py-1.5 text-xs font-semibold rounded-md shadow-xs transition-all duration-150 active:scale-95 hover:shadow-sm focus:ring-2 focus:ring-primary/40 focus:outline-none">
        <i class="ti ti-device-floppy text-sm"></i>
        <span>Save Base Templates</span>
      </button>
    </div>
  </div>
</form>

