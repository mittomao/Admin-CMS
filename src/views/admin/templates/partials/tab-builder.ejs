<%
  const sections = resolved && resolved.sections ? resolved.sections : (template && template.sections ? template.sections : []);
  const compSections = locals.componentSections || resolved?.componentSections || [];
  const compTemplates = locals.componentTemplates || resolved?.componentTemplates || [];
  const hasPresentationRenderings = (template && template.presentation && Array.isArray(template.presentation.renderings) && template.presentation.renderings.length > 0) || compSections.length > 0;
%>
<!-- Quick Info Section (DEC-037 / GĐ 6.3) -->
<%- include('../../../partials/quick-info', { quickInfo: locals.quickInfo, item: template, template: resolved }) %>

<div class="card shadow-sm border-0">
  <div class="card-header bg-white py-2 px-3 d-flex align-items-center justify-content-between">
    <div>
      <h4 class="card-title m-0 fw-bold fs-3 text-dark">Data Schema Builder</h4>
      <p class="text-muted small m-0">Define sections and fields for this template. Drag handles to reorder.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
      <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1" id="builderAddSectionBtn">
        <i class="ti ti-plus"></i>
        <span>Add Section</span>
      </button>
    </div>
  </div>

  <div class="card-body p-3">
    <% if (sections.length === 0) { %>
      <% if (compSections.length > 0) { %>
        <div class="alert alert-info d-flex align-items-center gap-2 mb-3">
          <i class="ti ti-info-circle fs-2 text-info"></i>
          <div>
            <strong>Chưa có Section riêng:</strong> Template này hiện chưa tạo các section trường dữ liệu riêng. Tuy nhiên, template đang sử dụng <strong><%= compTemplates.length %> Component Template(s)</strong> gắn với Standard Presentation bên dưới. Khi tạo trang từ template này, các trường của component sẽ tự động xuất hiện trên form nhập liệu.
          </div>
        </div>
      <% } else { %>
        <div class="empty py-4 text-center">
          <div class="empty-icon text-muted"><i class="ti ti-layout-navbar-expand fs-1"></i></div>
          <p class="empty-title">No Sections Defined</p>
          <p class="empty-subtitle text-muted">Click "Add Section" above to organize fields for this template.</p>
        </div>
      <% } %>
    <% } else { %>
      <!-- Sections Sortable Container -->
      <div class="accordion" id="builderSectionsContainer">
        <% sections.forEach((section, sIdx) => { %>
          <%
            const isSectionInherited = section.origin && section.origin.isInherited;
          %>
          <div
            class="accordion-item mb-3 border rounded shadow-2xs builder-section-item"
            data-section-id="<%= section._id %>"
          >
            <!-- Section Header -->
            <div class="accordion-header bg-light-subtle d-flex align-items-center justify-content-between p-2 border-bottom">
              <div class="d-flex align-items-center gap-2 flex-fill">
                <span class="section-drag-handle cursor-grab text-muted px-1" title="Drag to reorder section">
                  <i class="ti ti-grip-vertical fs-3"></i>
                </span>
                <button
                  class="accordion-button py-1 px-2 fw-bold text-dark bg-transparent border-0 shadow-none d-flex align-items-center gap-2 flex-fill"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#sec-collapse-<%= section._id %>"
                  aria-expanded="true"
                >
                  <i class="ti ti-folder text-primary"></i>
                  <span><%= section.name %></span>
                  <span class="badge bg-secondary-lt ms-2 font-monospace" style="font-size: 0.65rem;">
                    <%= section.fields ? section.fields.length : 0 %> <%= section.fields && section.fields.length === 1 ? 'field' : 'fields' %>
                  </span>
                  <% if (isSectionInherited) { %>
                    <span class="badge bg-purple-lt" title="Section originated from base template">
                      <i class="ti ti-git-fork me-1"></i>Inherited: <%= section.origin.templateName %>
                    </span>
                  <% } %>
                </button>
              </div>

              <!-- Section Operations -->
              <div class="d-flex align-items-center gap-1 pe-2">
                <button
                  type="button"
                  class="btn btn-sm btn-ghost-primary p-1 btn-add-field-to-section"
                  data-section-id="<%= section._id %>"
                  data-section-name="<%= section.name %>"
                  title="Add Field to <%= section.name %>"
                >
                  <i class="ti ti-plus fs-3"></i>
                </button>
                <% if (!isSectionInherited) { %>
                  <button
                    type="button"
                    class="btn btn-sm btn-ghost-secondary p-1 btn-edit-section"
                    data-section-id="<%= section._id %>"
                    data-section-name="<%= section.name %>"
                    data-section-sort="<%= section.sortOrder %>"
                    title="Edit Section Name"
                  >
                    <i class="ti ti-pencil fs-3"></i>
                  </button>
                  <button
                    type="button"
                    class="btn btn-sm btn-ghost-danger p-1 btn-delete-section"
                    data-section-id="<%= section._id %>"
                    data-section-name="<%= section.name %>"
                    title="Delete Section"
                  >
                    <i class="ti ti-trash fs-3"></i>
                  </button>
                <% } %>
              </div>
            </div>

            <!-- Section Fields List -->
            <div id="sec-collapse-<%= section._id %>" class="accordion-collapse collapse show">
              <div class="accordion-body p-2">
                <div
                  class="builder-fields-list list-group list-group-flush"
                  data-section-id="<%= section._id %>"
                  style="min-height: 48px;"
                >
                  <% if (!section.fields || section.fields.length === 0) { %>
                    <div class="text-center py-2 text-muted small empty-fields-placeholder">
                      No fields in this section. Click <i class="ti ti-plus text-primary"></i> above to add a field.
                    </div>
                  <% } else { %>
                    <% section.fields.forEach(field => { %>
                      <%
                        const isFieldInherited = field.origin && field.origin.isInherited;
                      %>
                      <div
                        class="list-group-item d-flex align-items-center justify-content-between p-2 rounded border mb-1 bg-white builder-field-item shadow-2xs"
                        data-field-id="<%= field._id %>"
                        data-field-name="<%= field.name %>"
                        data-section-id="<%= section._id %>"
                      >
                        <div class="d-flex align-items-center gap-2 overflow-hidden flex-fill">
                          <% if (!isFieldInherited) { %>
                            <span class="field-drag-handle cursor-grab text-muted px-1" title="Drag to reorder field">
                              <i class="ti ti-grip-vertical"></i>
                            </span>
                          <% } else { %>
                            <span class="text-muted px-1" title="Inherited from base template (cannot drag)">
                              <i class="ti ti-lock" style="font-size: 0.8rem;"></i>
                            </span>
                          <% } %>

                          <span class="badge bg-blue-lt font-monospace text-uppercase" style="font-size: 0.65rem; min-width: 90px;">
                            <%= field.type %>
                          </span>

                          <div class="text-truncate">
                            <span class="fw-bold text-dark"><%= field.title || field.name %></span>
                            <span class="font-monospace text-muted small ms-1">(<%= field.name %>)</span>
                            <% if (field.required) { %>
                              <span class="badge bg-red-lt ms-1" style="font-size: 0.6rem;">Required</span>
                            <% } %>
                            <% if (field.shared) { %>
                              <span class="badge bg-cyan-lt ms-1" style="font-size: 0.6rem;">Shared</span>
                            <% } %>
                            <% if (isFieldInherited) { %>
                              <span class="badge bg-purple-lt ms-1" style="font-size: 0.6rem;">
                                <i class="ti ti-git-fork me-1"></i>From: <%= field.origin.templateName %>
                              </span>
                            <% } %>
                          </div>
                        </div>

                        <!-- Field Actions -->
                        <div class="d-flex align-items-center gap-1 ms-2">
                          <% if (isFieldInherited) { %>
                            <button
                              type="button"
                              class="btn btn-sm btn-outline-purple py-0 px-2 btn-override-field"
                              data-field-name="<%= field.name %>"
                              data-field-title="<%= field.title %>"
                              data-field-type="<%= field.type %>"
                              data-section-id="<%= section._id %>"
                              title="Override this field definition in current template"
                              style="font-size: 0.72rem;"
                            >
                              <i class="ti ti-replace me-1"></i>Override
                            </button>
                          <% } else { %>
                            <button
                              type="button"
                              class="btn btn-sm btn-ghost-secondary p-1 btn-edit-field"
                              data-field-id="<%= field._id %>"
                              data-field-name="<%= field.name %>"
                              data-field-title="<%= field.title %>"
                              data-field-type="<%= field.type %>"
                              data-field-required="<%= field.required %>"
                              data-field-default="<%= field.defaultValue %>"
                              data-field-source="<%= field.source %>"
                              data-field-shared="<%= field.shared %>"
                              data-field-help="<%= field.helpText %>"
                              data-section-id="<%= section._id %>"
                              title="Edit Field"
                            >
                              <i class="ti ti-pencil"></i>
                            </button>
                            <button
                              type="button"
                              class="btn btn-sm btn-ghost-danger p-1 btn-delete-field"
                              data-field-id="<%= field._id %>"
                              data-field-name="<%= field.name %>"
                              data-section-id="<%= section._id %>"
                              title="Delete Field"
                            >
                              <i class="ti ti-trash"></i>
                            </button>
                          <% } %>
                        </div>
                      </div>
                    <% }) %>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (hasPresentationRenderings) { %>
      <div class="mt-4 pt-3 border-top">
        <div class="d-flex align-items-center justify-content-between mb-2">
          <h5 class="fw-bold mb-0 text-dark d-flex align-items-center gap-2">
            <i class="ti ti-components text-purple fs-2"></i>
            <span>Fields từ Renderings (Standard Presentation)</span>
            <span class="badge bg-purple-lt text-purple small">DEC-036: Effective Fields</span>
          </h5>
          <span class="text-muted small">
            <%= compSections.length %> section(s) · <%= compTemplates.length %> component template(s)
          </span>
        </div>

        <div class="alert alert-info py-2 px-3 small d-flex align-items-center gap-2 mb-3">
          <i class="ti ti-info-circle fs-2 text-info"></i>
          <div>
            Các trường bên dưới được <strong>tự động suy ra từ Standard Presentation</strong> của Template. Chúng sẽ tự động xuất hiện trên Content Editor khi biên tập trang. Cấu trúc trường được quản lý tập trung tại Component Template gốc (chỉ đọc tại đây).
          </div>
        </div>

        <% if (compSections.length > 0) { %>
          <div class="accordion" id="builderComponentSectionsContainer">
            <% compSections.forEach((cSection, csIdx) => { %>
              <div class="accordion-item mb-3 border border-purple-subtle rounded shadow-2xs">
                <!-- Component Section Header -->
                <div class="accordion-header bg-purple-lt d-flex align-items-center justify-content-between p-2 border-bottom border-purple-subtle">
                  <div class="d-flex align-items-center gap-2 flex-fill">
                    <button
                      class="accordion-button py-1 px-2 fw-bold text-dark bg-transparent border-0 shadow-none d-flex align-items-center gap-2 flex-fill"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#csec-collapse-<%= csIdx %>"
                      aria-expanded="true"
                    >
                      <i class="<%= cSection.origin.icon || 'ti ti-box' %> text-purple fs-2"></i>
                      <span class="fw-bold text-purple"><%= cSection.displayName %></span>
                      <span class="badge bg-white text-purple border border-purple-subtle ms-2 font-monospace" style="font-size: 0.65rem;">
                        <%= cSection.fields ? cSection.fields.length : 0 %> <%= cSection.fields && cSection.fields.length === 1 ? 'field' : 'fields' %>
                      </span>
                      <span class="badge bg-purple text-white ms-1" style="font-size: 0.65rem;" title="Component Template">
                        <i class="ti ti-puzzle me-1"></i><%= cSection.origin.templateName %>
                      </span>
                    </button>
                  </div>

                  <div class="d-flex align-items-center gap-2 pe-2">
                    <span class="badge bg-secondary-lt text-muted small">Chỉ đọc</span>
                    <a
                      href="/admin/template-manager/<%= cSection.origin.templateId %>"
                      class="btn btn-sm btn-ghost-purple p-1 d-flex align-items-center gap-1 text-decoration-none"
                      title="Chuyển đến Component Template để chỉnh sửa cấu trúc trường"
                      target="_blank"
                    >
                      <i class="ti ti-external-link"></i>
                      <span class="small">Sửa Template gốc</span>
                    </a>
                  </div>
                </div>

                <!-- Component Section Fields List -->
                <div id="csec-collapse-<%= csIdx %>" class="accordion-collapse collapse show">
                  <div class="accordion-body p-2 bg-light-subtle">
                    <div class="list-group list-group-flush">
                      <% (cSection.fields || []).forEach(field => { %>
                        <div class="list-group-item d-flex align-items-center justify-content-between p-2 rounded border mb-1 bg-white shadow-2xs">
                          <div class="d-flex align-items-center gap-2">
                            <span class="text-purple opacity-75">
                              <i class="ti ti-columns-2 fs-3"></i>
                            </span>
                            <div>
                              <div class="fw-semibold text-dark small d-flex align-items-center gap-2">
                                <span><%= field.title || field.name %></span>
                                <span class="badge bg-light text-muted font-monospace border" style="font-size: 0.65rem;">
                                  <%= field.name %>
                                </span>
                                <% if (field.required) { %>
                                  <span class="badge bg-danger-lt text-danger" style="font-size: 0.6rem;">Required</span>
                                <% } %>
                                <% if (field.shared) { %>
                                  <span class="badge bg-azure-lt text-azure" style="font-size: 0.6rem;">Shared</span>
                                <% } %>
                              </div>
                              <div class="text-muted small" style="font-size: 0.7rem;">
                                Kiểu: <span class="fw-medium text-dark"><%= field.type %></span>
                                <% if (field.defaultValue) { %>
                                  · Mặc định: <code class="text-muted"><%= field.defaultValue %></code>
                                <% } %>
                                <% if (field.helpText) { %>
                                  · <span class="fst-italic"><%= field.helpText %></span>
                                <% } %>
                              </div>
                            </div>
                          </div>

                          <div class="d-flex align-items-center gap-1">
                            <span class="badge bg-purple-lt text-purple" style="font-size: 0.65rem;">
                              <i class="ti ti-lock me-1"></i>Từ Component
                            </span>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

