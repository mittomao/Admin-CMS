<%
  const sections = resolved && resolved.sections ? resolved.sections : (template && template.sections ? template.sections : []);
  const compSections = locals.componentSections || resolved?.componentSections || [];
  const compTemplates = locals.componentTemplates || resolved?.componentTemplates || [];
  const hasPresentationRenderings = (template && template.presentation && Array.isArray(template.presentation.renderings) && template.presentation.renderings.length > 0) || compSections.length > 0;
%>
<!-- Quick Info Section (DEC-037 / GĐ 6.3) -->
<%- include('../../../partials/quick-info', { quickInfo: locals.quickInfo, item: template, template: resolved }) %>

<div class="card shadow-sm border border-slate-200/80 rounded-xl bg-white overflow-hidden">
  <div class="card-header bg-slate-50/70 py-3 px-4 d-flex align-items-center justify-content-between flex items-center justify-between border-b border-slate-200">
    <div>
      <h4 class="card-title m-0 fw-bold fs-3 text-slate-900 font-bold text-base tracking-tight">Data Schema Builder</h4>
      <p class="text-muted small m-0 text-xs text-slate-500 mt-0.5">Define sections and fields for this template. Drag handles to reorder.</p>
    </div>
    <div class="d-flex align-items-center gap-2 flex items-center gap-2">
      <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1.5 inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-md border border-primary/30 text-primary bg-primary/5 hover:bg-primary/10 transition-all duration-150 active:scale-95" id="builderAddSectionBtn">
        <i class="ti ti-plus text-sm"></i>
        <span>Add Section</span>
      </button>
    </div>
  </div>

  <div class="card-body p-4">
    <% if (sections.length === 0) { %>
      <% if (compSections.length > 0) { %>
        <div class="alert alert-info d-flex align-items-center gap-3 mb-4 p-3.5 rounded-lg bg-sky-50 border border-sky-200 text-sky-800 text-xs">
          <i class="ti ti-info-circle text-xl text-sky-600 flex-shrink-0"></i>
          <div>
            <strong class="font-semibold">Chưa có Section riêng:</strong> Template này hiện chưa tạo các section trường dữ liệu riêng. Tuy nhiên, template đang sử dụng <strong class="font-semibold"><%= compTemplates.length %> Component Template(s)</strong> gắn với Standard Presentation bên dưới. Khi tạo trang từ template này, các trường của component sẽ tự động xuất hiện trên form nhập liệu.
          </div>
        </div>
      <% } else { %>
        <div class="empty py-8 text-center flex flex-col items-center justify-center">
          <div class="empty-icon text-slate-300 mb-2"><i class="ti ti-layout-navbar-expand text-4xl"></i></div>
          <p class="empty-title text-sm font-bold text-slate-700 m-0">No Sections Defined</p>
          <p class="empty-subtitle text-xs text-slate-500 mt-1 max-w-sm">Click "Add Section" above to organize fields for this template.</p>
        </div>
      <% } %>
    <% } else { %>
      <!-- Sections Sortable Container -->
      <div class="accordion space-y-3" id="builderSectionsContainer">
        <% sections.forEach((section, sIdx) => { %>
          <%
            const isSectionInherited = section.origin && section.origin.isInherited;
          %>
          <div
            class="accordion-item border border-slate-200/90 rounded-xl overflow-hidden shadow-2xs bg-white builder-section-item transition-shadow duration-150 hover:shadow-xs"
            data-section-id="<%= section._id %>"
          >
            <!-- Section Header -->
            <div class="accordion-header bg-slate-50/80 d-flex align-items-center justify-content-between p-2.5 border-bottom border-slate-200 flex items-center justify-between">
              <div class="d-flex align-items-center gap-2 flex-fill flex items-center gap-2 flex-1 min-w-0">
                <span class="section-drag-handle cursor-grab text-slate-400 hover:text-slate-600 px-1 py-0.5 rounded transition-colors" title="Drag to reorder section">
                  <i class="ti ti-grip-vertical text-base"></i>
                </span>
                <button
                  class="accordion-button py-1 px-2 fw-bold text-slate-800 bg-transparent border-0 shadow-none d-flex align-items-center gap-2 flex-fill flex items-center gap-2 flex-1 text-left cursor-pointer"
                  type="button"
                  data-bs-toggle="collapse"
                  data-bs-target="#sec-collapse-<%= section._id %>"
                  aria-expanded="true"
                >
                  <i class="ti ti-folder text-primary text-base"></i>
                  <span class="text-xs font-bold text-slate-800 tracking-tight"><%= section.name %></span>
                  <span class="badge bg-slate-200/70 text-slate-600 ms-2 font-mono text-[10px] px-2 py-0.5 rounded-full">
                    <%= section.fields ? section.fields.length : 0 %> <%= section.fields && section.fields.length === 1 ? 'field' : 'fields' %>
                  </span>
                  <% if (isSectionInherited) { %>
                    <span class="badge bg-purple-50 text-purple-700 border border-purple-200 font-mono text-[10px] px-2 py-0.5 rounded-full flex items-center gap-1" title="Section originated from base template">
                      <i class="ti ti-git-fork me-0.5"></i>Inherited: <%= section.origin.templateName %>
                    </span>
                  <% } %>
                </button>
              </div>

              <!-- Section Operations -->
              <div class="d-flex align-items-center gap-1.5 pe-1 flex items-center">
                <button
                  type="button"
                  class="btn btn-sm btn-ghost-primary p-1.5 rounded-md hover:bg-primary/10 text-primary transition-all duration-150 active:scale-95 btn-add-field-to-section"
                  data-section-id="<%= section._id %>"
                  data-section-name="<%= section.name %>"
                  title="Add Field to <%= section.name %>"
                >
                  <i class="ti ti-plus text-base"></i>
                </button>
                <% if (!isSectionInherited) { %>
                  <button
                    type="button"
                    class="btn btn-sm btn-ghost-secondary p-1.5 rounded-md hover:bg-slate-200/70 text-slate-600 transition-all duration-150 active:scale-95 btn-edit-section"
                    data-section-id="<%= section._id %>"
                    data-section-name="<%= section.name %>"
                    data-section-sort="<%= section.sortOrder %>"
                    title="Edit Section Name"
                  >
                    <i class="ti ti-pencil text-base"></i>
                  </button>
                  <button
                    type="button"
                    class="btn btn-sm btn-ghost-danger p-1.5 rounded-md hover:bg-rose-50 text-rose-500 hover:text-rose-600 transition-all duration-150 active:scale-95 btn-delete-section"
                    data-section-id="<%= section._id %>"
                    data-section-name="<%= section.name %>"
                    title="Delete Section"
                  >
                    <i class="ti ti-trash text-base"></i>
                  </button>
                <% } %>
              </div>
            </div>

            <!-- Section Fields List -->
            <div id="sec-collapse-<%= section._id %>" class="accordion-collapse collapse show">
              <div class="accordion-body p-2.5 bg-slate-50/30">
                <div
                  class="builder-fields-list list-group list-group-flush space-y-1.5"
                  data-section-id="<%= section._id %>"
                  style="min-height: 48px;"
                >
                  <% if (!section.fields || section.fields.length === 0) { %>
                    <div class="text-center py-4 text-slate-400 text-xs italic empty-fields-placeholder">
                      No fields in this section. Click <i class="ti ti-plus text-primary"></i> above to add a field.
                    </div>
                  <% } else { %>
                    <% section.fields.forEach(field => { %>
                      <%
                        const isFieldInherited = field.origin && field.origin.isInherited;
                      %>
                      <div
                        class="list-group-item d-flex align-items-center justify-content-between p-2 rounded-lg border border-slate-200/80 bg-white builder-field-item shadow-2xs hover:border-slate-300 transition-all duration-150 flex items-center justify-between"
                        data-field-id="<%= field._id %>"
                        data-field-name="<%= field.name %>"
                        data-section-id="<%= section._id %>"
                      >
                        <div class="d-flex align-items-center gap-2 overflow-hidden flex-fill flex items-center gap-2 flex-1 min-w-0">
                          <% if (!isFieldInherited) { %>
                            <span class="field-drag-handle cursor-grab text-slate-400 hover:text-slate-600 px-1 py-0.5 rounded transition-colors" title="Drag to reorder field">
                              <i class="ti ti-grip-vertical text-sm"></i>
                            </span>
                          <% } else { %>
                            <span class="text-slate-400 px-1" title="Inherited from base template (cannot drag)">
                              <i class="ti ti-lock text-xs"></i>
                            </span>
                          <% } %>

                          <span class="badge bg-blue-50 text-blue-700 border border-blue-200 font-mono uppercase text-[10px] px-2 py-0.5 rounded min-w-[85px] text-center">
                            <%= field.type %>
                          </span>

                          <div class="text-truncate truncate flex items-center gap-1.5">
                            <span class="fw-bold text-slate-800 text-xs font-semibold"><%= field.title || field.name %></span>
                            <span class="font-mono text-slate-400 text-[11px]">(<%= field.name %>)</span>
                            <% if (field.required) { %>
                              <span class="badge bg-rose-50 text-rose-600 border border-rose-200 text-[9px] px-1.5 py-0.2 rounded font-mono">Required</span>
                            <% } %>
                            <% if (field.shared) { %>
                              <span class="badge bg-cyan-50 text-cyan-700 border border-cyan-200 text-[9px] px-1.5 py-0.2 rounded font-mono">Shared</span>
                            <% } %>
                            <% if (isFieldInherited) { %>
                              <span class="badge bg-purple-50 text-purple-700 border border-purple-200 text-[9px] px-1.5 py-0.2 rounded font-mono flex items-center gap-0.5">
                                <i class="ti ti-git-fork"></i>From: <%= field.origin.templateName %>
                              </span>
                            <% } %>
                          </div>
                        </div>

                        <!-- Field Actions -->
                        <div class="d-flex align-items-center gap-1.5 ms-2 flex items-center">
                          <% if (isFieldInherited) { %>
                            <button
                              type="button"
                              class="btn btn-sm btn-outline-purple py-0.5 px-2 rounded text-[11px] font-medium border border-purple-300 text-purple-700 hover:bg-purple-50 transition-all duration-150 active:scale-95 btn-override-field"
                              data-field-name="<%= field.name %>"
                              data-field-title="<%= field.title %>"
                              data-field-type="<%= field.type %>"
                              data-section-id="<%= section._id %>"
                              title="Override this field definition in current template"
                            >
                              <i class="ti ti-replace me-1"></i>Override
                            </button>
                          <% } else { %>
                            <button
                              type="button"
                              class="btn btn-sm btn-ghost-secondary p-1 rounded hover:bg-slate-100 text-slate-500 hover:text-slate-800 transition-all duration-150 active:scale-95 btn-edit-field"
                              data-field-id="<%= field._id %>"
                              data-field-name="<%= field.name %>"
                              data-field-title="<%= field.title %>"
                              data-field-type="<%= field.type %>"
                              data-field-required="<%= field.required %>"
                              data-field-default="<%= field.defaultValue %>"
                              data-field-source="<%= field.source %>"
                              data-field-shared="<%= field.shared %>"
                              data-field-help="<%= field.helpText %>"
                              data-section-id="<%= section._id %>"
                              title="Edit Field"
                            >
                              <i class="ti ti-pencil text-sm"></i>
                            </button>
                            <button
                              type="button"
                              class="btn btn-sm btn-ghost-danger p-1 rounded hover:bg-rose-50 text-rose-500 hover:text-rose-600 transition-all duration-150 active:scale-95 btn-delete-field"
                              data-field-id="<%= field._id %>"
                              data-field-name="<%= field.name %>"
                              data-section-id="<%= section._id %>"
                              title="Delete Field"
                            >
                              <i class="ti ti-trash text-sm"></i>
                            </button>
                          <% } %>
                        </div>
                      </div>
                    <% }) %>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (hasPresentationRenderings) { %>
      <div class="mt-6 pt-4 border-t border-slate-200">
        <div class="d-flex align-items-center justify-content-between mb-2 flex items-center justify-between">
          <h5 class="fw-bold mb-0 text-slate-800 d-flex align-items-center gap-2 flex items-center gap-2 text-sm font-bold">
            <i class="ti ti-components text-purple-600 text-base"></i>
            <span>Fields từ Renderings (Standard Presentation)</span>
            <span class="badge bg-purple-50 text-purple-700 border border-purple-200 text-[10px] font-mono px-2 py-0.5 rounded">DEC-036: Effective Fields</span>
          </h5>
          <span class="text-muted small text-xs text-slate-400 font-mono">
            <%= compSections.length %> section(s) · <%= compTemplates.length %> component template(s)
          </span>
        </div>

        <div class="alert alert-info py-2.5 px-3.5 rounded-lg bg-sky-50 border border-sky-200 text-sky-800 text-xs d-flex align-items-center gap-2.5 mb-3 flex items-center gap-2.5">
          <i class="ti ti-info-circle text-lg text-sky-600 flex-shrink-0"></i>
          <div>
            Các trường bên dưới được <strong class="font-semibold">tự động suy ra từ Standard Presentation</strong> của Template. Chúng sẽ tự động xuất hiện trên Content Editor khi biên tập trang. Cấu trúc trường được quản lý tập trung tại Component Template gốc (chỉ đọc tại đây).
          </div>
        </div>

        <% if (compSections.length > 0) { %>
          <div class="accordion space-y-3" id="builderComponentSectionsContainer">
            <% compSections.forEach((cSection, csIdx) => { %>
              <div class="accordion-item border border-purple-200 rounded-xl overflow-hidden shadow-2xs bg-white">
                <!-- Component Section Header -->
                <div class="accordion-header bg-purple-50/70 d-flex align-items-center justify-content-between p-2.5 border-bottom border-purple-200 flex items-center justify-between">
                  <div class="d-flex align-items-center gap-2 flex-fill flex items-center gap-2 flex-1 min-w-0">
                    <button
                      class="accordion-button py-1 px-2 fw-bold text-dark bg-transparent border-0 shadow-none d-flex align-items-center gap-2 flex-fill flex items-center gap-2 flex-1 text-left cursor-pointer"
                      type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#csec-collapse-<%= csIdx %>"
                      aria-expanded="true"
                    >
                      <i class="<%= cSection.origin.icon || 'ti ti-box' %> text-purple-600 text-base"></i>
                      <span class="fw-bold text-purple-900 text-xs"><%= cSection.displayName %></span>
                      <span class="badge bg-white text-purple-700 border border-purple-200 ms-2 font-mono text-[10px] px-2 py-0.5 rounded-full">
                        <%= cSection.fields ? cSection.fields.length : 0 %> <%= cSection.fields && cSection.fields.length === 1 ? 'field' : 'fields' %>
                      </span>
                      <span class="badge bg-purple-600 text-white ms-1 text-[10px] px-2 py-0.5 rounded-full font-medium" title="Component Template">
                        <i class="ti ti-puzzle me-1"></i><%= cSection.origin.templateName %>
                      </span>
                    </button>
                  </div>

                  <div class="d-flex align-items-center gap-2 pe-2 flex items-center gap-2">
                    <span class="badge bg-slate-100 text-slate-500 font-mono text-[10px] px-2 py-0.5 rounded">Chỉ đọc</span>
                    <a
                      href="/admin/template-manager/<%= cSection.origin.templateId %>"
                      class="btn btn-sm btn-ghost-purple p-1 rounded hover:bg-purple-100/60 text-purple-700 transition-all duration-150 active:scale-95 d-flex align-items-center gap-1 text-decoration-none inline-flex items-center"
                      title="Chuyển đến Component Template để chỉnh sửa cấu trúc trường"
                      target="_blank"
                    >
                      <i class="ti ti-external-link text-xs"></i>
                      <span class="text-[11px] font-medium">Sửa Template gốc</span>
                    </a>
                  </div>
                </div>

                <!-- Component Section Fields List -->
                <div id="csec-collapse-<%= csIdx %>" class="accordion-collapse collapse show">
                  <div class="accordion-body p-2.5 bg-slate-50/50">
                    <div class="list-group list-group-flush space-y-1.5">
                      <% (cSection.fields || []).forEach(field => { %>
                        <div class="list-group-item d-flex align-items-center justify-content-between p-2 rounded-lg border border-slate-200/80 bg-white shadow-2xs flex items-center justify-between">
                          <div class="d-flex align-items-center gap-2.5 flex items-center gap-2.5">
                            <span class="text-purple-500">
                              <i class="ti ti-columns-2 text-base"></i>
                            </span>
                            <div>
                              <div class="fw-semibold text-slate-800 text-xs d-flex align-items-center gap-2 flex items-center gap-2">
                                <span><%= field.title || field.name %></span>
                                <span class="badge bg-slate-100 text-slate-500 font-mono border border-slate-200 text-[10px] px-1.5 py-0.2 rounded">
                                  <%= field.name %>
                                </span>
                                <% if (field.required) { %>
                                  <span class="badge bg-rose-50 text-rose-600 border border-rose-200 text-[9px] px-1.5 py-0.2 rounded font-mono">Required</span>
                                <% } %>
                                <% if (field.shared) { %>
                                  <span class="badge bg-cyan-50 text-cyan-700 border border-cyan-200 text-[9px] px-1.5 py-0.2 rounded font-mono">Shared</span>
                                <% } %>
                              </div>
                              <div class="text-slate-400 text-[11px] mt-0.5">
                                Kiểu: <span class="fw-medium text-slate-700"><%= field.type %></span>
                                <% if (field.defaultValue) { %>
                                  · Mặc định: <code class="text-slate-500 font-mono bg-slate-100 px-1 py-0.2 rounded"><%= field.defaultValue %></code>
                                <% } %>
                                <% if (field.helpText) { %>
                                  · <span class="italic text-slate-500"><%= field.helpText %></span>
                                <% } %>
                              </div>
                            </div>
                          </div>

                          <div class="d-flex align-items-center gap-1 flex items-center">
                            <span class="badge bg-purple-50 text-purple-700 border border-purple-200 text-[10px] px-2 py-0.5 rounded font-mono flex items-center gap-1">
                              <i class="ti ti-lock text-[10px]"></i>Từ Component
                            </span>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</div>

