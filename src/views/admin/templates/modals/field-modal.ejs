<div class="modal fade" id="fieldModal" tabindex="-1" aria-labelledby="fieldModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title d-flex align-items-center gap-2" id="fieldModalLabel">
          <i class="ti ti-forms text-primary"></i>
          <span id="fieldModalTitle">Field Details</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="fieldForm">
        <input type="hidden" id="fieldModalSectionId" name="sectionId" />
        <input type="hidden" id="fieldModalId" name="fieldId" />
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label required" for="fieldModalName">Technical Name</label>
              <input
                type="text"
                class="form-control font-monospace"
                id="fieldModalName"
                name="name"
                required
                placeholder="e.g. title, heroImage, isFeatured"
                pattern="^[a-zA-Z0-9_-]+$"
              />
              <div class="form-text small text-muted">Field identifier used in schema and templates.</div>
            </div>

            <div class="col-md-6">
              <label class="form-label required" for="fieldModalTitle">Display Title</label>
              <input
                type="text"
                class="form-control"
                id="fieldModalTitle"
                name="title"
                required
                placeholder="e.g. Article Title, Main Hero Image"
              />
              <div class="form-text small text-muted">Human-readable label shown on editing form.</div>
            </div>

            <div class="col-md-6">
              <label class="form-label required" for="fieldModalType">Field Type</label>
              <select class="form-select" id="fieldModalType" name="type" required>
                <option value="Single-Line Text">Single-Line Text</option>
                <option value="Multi-Line Text">Multi-Line Text</option>
                <option value="Rich Text">Rich Text (HTML WYSIWYG)</option>
                <option value="Checkbox">Checkbox (Boolean)</option>
                <option value="Date">Date</option>
                <option value="Number">Number</option>
                <option value="Droplist">Droplist (Select)</option>
                <option value="Image">Image</option>
              </select>
            </div>

            <div class="col-md-6" id="fieldSourceContainer" style="display: none;">
              <label class="form-label" for="fieldModalSource">Options Source (one per line)</label>
              <textarea
                class="form-control font-monospace"
                id="fieldModalSource"
                name="source"
                rows="2"
                placeholder="Option 1&#10;Option 2&#10;Option 3"
              ></textarea>
            </div>

            <div class="col-md-12">
              <label class="form-label" for="fieldModalHelpText">Help Text</label>
              <input
                type="text"
                class="form-control"
                id="fieldModalHelpText"
                name="helpText"
                placeholder="Guidance or instructions shown to content authors..."
              />
            </div>

            <div class="col-md-12">
              <div class="d-flex gap-4">
                <label class="form-check form-switch m-0">
                  <input type="checkbox" class="form-check-input" id="fieldModalRequired" name="required" value="true" />
                  <span class="form-check-label fw-semibold">Required Field</span>
                </label>
                <label class="form-check form-switch m-0">
                  <input type="checkbox" class="form-check-input" id="fieldModalShared" name="shared" value="true" />
                  <span class="form-check-label fw-semibold" title="Value is shared across all language versions (GĐ 4)">Shared</span>
                </label>
                <label class="form-check form-switch m-0">
                  <input type="checkbox" class="form-check-input" id="fieldModalUnversioned" name="unversioned" value="true" />
                  <span class="form-check-label fw-semibold" title="Value is shared across all numbered versions within language (GĐ 4)">Unversioned</span>
                </label>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary d-flex align-items-center gap-1" id="btnSubmitField">
            <i class="ti ti-check"></i>
            <span>Save Field</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

