<div class="modal fade" id="sectionModal" tabindex="-1" aria-labelledby="sectionModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title d-flex align-items-center gap-2" id="sectionModalLabel">
          <i class="ti ti-layout-navbar-expand text-primary"></i>
          <span id="sectionModalTitle">Section Details</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="sectionForm">
        <input type="hidden" id="sectionModalId" name="sectionId" />
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label required" for="sectionModalName">Section Name</label>
            <input
              type="text"
              class="form-control"
              id="sectionModalName"
              name="name"
              required
              placeholder="e.g. Content, Page Settings, SEO & Metadata"
            />
            <div class="form-text small text-muted">
              Sections with the same name across base and child templates will be merged together.
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary d-flex align-items-center gap-1" id="btnSubmitSection">
            <i class="ti ti-check"></i>
            <span>Save Section</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

