<%
  const activeTemplate = typeof selectedTemplate !== 'undefined' ? selectedTemplate : null;
  const tplList = typeof templates !== 'undefined' ? templates : [];
%>
<div class="template-manager-container d-flex flex-column h-100" style="min-height: calc(100vh - 120px);">
  <!-- 1. Template Manager Ribbon Toolbar -->
  <div class="ribbon-container border-bottom bg-white shadow-xs">
    <div class="d-flex align-items-center justify-content-between px-3 py-1 bg-light-subtle border-bottom">
      <div class="d-flex align-items-center gap-2">
        <i class="ti ti-layout-grid-add text-primary fs-2"></i>
        <span class="fw-bold text-uppercase font-monospace text-dark" style="letter-spacing: 0.5px;">
          Template Manager
        </span>
      </div>
      <div class="d-flex align-items-center gap-2">
        <span id="tplDirtyIndicator" class="badge bg-warning-lt d-none">
          <i class="ti ti-pencil me-1"></i>Unsaved Changes
        </span>
        <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-1" id="btnSaveTemplate">
          <i class="ti ti-device-floppy"></i>
          <span>Save (Ctrl+S)</span>
        </button>
      </div>
    </div>

    <!-- Ribbon Action Toolbar -->
    <div class="d-flex align-items-stretch flex-wrap gap-2 p-2 bg-light-subtle">
      <!-- Group: Template Operations -->
      <div class="ribbon-group d-flex flex-column justify-content-between px-2 py-1 bg-white border rounded shadow-2xs">
        <div class="d-flex align-items-center gap-1">
          <button
            type="button"
            class="btn btn-outline-secondary ribbon-btn-large d-flex flex-column align-items-center justify-content-center p-1"
            id="btnNewTemplate"
            title="Create a new template"
            style="min-width: 58px; height: 54px; font-size: 0.75rem;"
          >
            <i class="ti ti-plus fs-2 mb-1 text-primary"></i>
            <span>New</span>
          </button>
          <button
            type="button"
            class="btn btn-outline-secondary ribbon-btn-large d-flex flex-column align-items-center justify-content-center p-1"
            id="btnDuplicateTemplate"
            <%= !activeTemplate ? 'disabled' : '' %>
            title="Duplicate current template"
            style="min-width: 58px; height: 54px; font-size: 0.75rem;"
          >
            <i class="ti ti-copy fs-2 mb-1 text-azure"></i>
            <span>Duplicate</span>
          </button>
          <button
            type="button"
            class="btn btn-outline-secondary ribbon-btn-large d-flex flex-column align-items-center justify-content-center p-1 hover-danger text-danger"
            id="btnDeleteTemplate"
            <%= (!activeTemplate || activeTemplate.isSystem) ? 'disabled' : '' %>
            title="<%= activeTemplate && activeTemplate.isSystem ? 'System templates cannot be deleted' : 'Delete template' %>"
            style="min-width: 58px; height: 54px; font-size: 0.75rem;"
          >
            <i class="ti ti-trash fs-2 mb-1"></i>
            <span>Delete</span>
          </button>
        </div>
        <div class="ribbon-group-title text-center text-muted border-top mt-1 pt-1" style="font-size: 0.65rem; text-transform: uppercase;">
          Template
        </div>
      </div>

      <!-- Group: Schema Elements -->
      <div class="ribbon-group d-flex flex-column justify-content-between px-2 py-1 bg-white border rounded shadow-2xs">
        <div class="d-flex align-items-center gap-1">
          <button
            type="button"
            class="btn btn-outline-secondary ribbon-btn-large d-flex flex-column align-items-center justify-content-center p-1"
            id="btnAddSection"
            <%= !activeTemplate ? 'disabled' : '' %>
            title="Add section to current template"
            style="min-width: 58px; height: 54px; font-size: 0.75rem;"
          >
            <i class="ti ti-layout-navbar-expand fs-2 mb-1 text-indigo"></i>
            <span>Add Section</span>
          </button>
          <button
            type="button"
            class="btn btn-outline-secondary ribbon-btn-large d-flex flex-column align-items-center justify-content-center p-1"
            id="btnAddField"
            <%= !activeTemplate ? 'disabled' : '' %>
            title="Add field to current template"
            style="min-width: 58px; height: 54px; font-size: 0.75rem;"
          >
            <i class="ti ti-forms fs-2 mb-1 text-teal"></i>
            <span>Add Field</span>
          </button>
        </div>
        <div class="ribbon-group-title text-center text-muted border-top mt-1 pt-1" style="font-size: 0.65rem; text-transform: uppercase;">
          Elements
        </div>
      </div>

      <!-- Group: View & Preview -->
      <div class="ribbon-group d-flex flex-column justify-content-between px-2 py-1 bg-white border rounded shadow-2xs">
        <div class="d-flex align-items-center gap-1">
          <button
            type="button"
            class="btn btn-outline-secondary ribbon-btn-large d-flex flex-column align-items-center justify-content-center p-1"
            id="btnPreviewForm"
            <%= !activeTemplate ? 'disabled' : '' %>
            title="Preview how items of this template render in Content Editor"
            style="min-width: 58px; height: 54px; font-size: 0.75rem;"
          >
            <i class="ti ti-eye fs-2 mb-1 text-purple"></i>
            <span>Preview</span>
          </button>
        </div>
        <div class="ribbon-group-title text-center text-muted border-top mt-1 pt-1" style="font-size: 0.65rem; text-transform: uppercase;">
          Validation
        </div>
      </div>
    </div>
  </div>

  <!-- 2. Main 3-Pane Layout (Left Templates List + Center Workspace Tabs) -->
  <div class="d-flex flex-fill overflow-hidden border-top">
    <!-- Left Pane: Templates Tree / Directory -->
    <aside
      class="template-sidebar bg-white border-end d-flex flex-column flex-shrink-0"
      style="width: 300px; min-width: 250px; max-width: 450px;"
    >
      <div class="p-2 border-bottom bg-light-subtle">
        <div class="input-icon">
          <span class="input-icon-addon">
            <i class="ti ti-search text-muted"></i>
          </span>
          <input
            type="text"
            class="form-control form-control-sm"
            id="templateSearchInput"
            placeholder="Search templates..."
            autocomplete="off"
          />
        </div>
      </div>

      <div class="px-3 py-2 border-bottom bg-white d-flex align-items-center justify-content-between text-muted small">
        <span class="fw-semibold text-uppercase font-monospace" style="font-size: 0.68rem;">Templates (<%= tplList.length %>)</span>
        <span class="badge bg-secondary-lt font-monospace" style="font-size: 0.65rem;">System & Custom</span>
      </div>

      <div class="list-group list-group-flush overflow-auto flex-fill p-2" id="templateListContainer">
        <% tplList.forEach(t => { %>
          <%
            const isSelected = activeTemplate && activeTemplate._id.toString() === t._id.toString();
          %>
          <a
            href="/admin/template-manager/<%= t._id %>"
            class="list-group-item list-group-item-action py-2 px-3 rounded mb-1 border <%= isSelected ? 'active' : '' %> template-nav-item"
            data-template-id="<%= t._id %>"
            data-template-name="<%= t.name.toLowerCase() %>"
            data-template-display="<%= (t.displayName || '').toLowerCase() %>"
          >
            <div class="d-flex align-items-center justify-content-between">
              <div class="d-flex align-items-center gap-2 text-truncate">
                <i class="<%= t.icon || 'ti ti-file-text' %> fs-2 <%= isSelected ? 'text-white' : 'text-primary' %>"></i>
                <div class="text-truncate">
                  <div class="fw-semibold text-truncate"><%= t.displayName || t.name %></div>
                  <div class="small font-monospace opacity-75" style="font-size: 0.7rem;"><%= t.name %></div>
                </div>
              </div>
              <% if (t.isSystem) { %>
                <span class="badge <%= isSelected ? 'bg-white text-dark' : 'bg-secondary-lt' %>" style="font-size: 0.6rem;">System</span>
              <% } %>
            </div>
          </a>
        <% }) %>
      </div>
    </aside>

    <!-- Center Workspace Pane: Tabs (Builder, Standard Values, Insert Options, Inheritance, Usage) -->
    <main class="template-workspace flex-fill d-flex flex-column bg-light-subtle overflow-hidden">
      <% if (activeTemplate) { %>
        <!-- Header: Template Overview & Tab Switcher -->
        <div class="bg-white border-bottom px-3 pt-2 pb-0">
          <div class="d-flex align-items-center justify-content-between mb-2">
            <div class="d-flex align-items-center gap-2">
              <span class="avatar avatar-md bg-blue-lt rounded">
                <i class="<%= activeTemplate.icon || 'ti ti-file-text' %> fs-2"></i>
              </span>
              <div>
                <div class="d-flex align-items-center gap-2">
                  <h3 class="m-0 fw-bold fs-2 text-dark"><%= activeTemplate.displayName || activeTemplate.name %></h3>
                  <span class="badge bg-secondary-lt font-monospace"><%= activeTemplate.name %></span>
                  <% if (activeTemplate.isSystem) { %>
                    <span class="badge bg-azure-lt"><i class="ti ti-lock me-1"></i>System</span>
                  <% } %>
                </div>
                <div class="text-muted small mt-1"><%= activeTemplate.description || 'No description provided.' %></div>
              </div>
            </div>

            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnEditTemplateMeta">
              <i class="ti ti-pencil me-1"></i>Edit Details
            </button>
          </div>

          <!-- Tab Navigation -->
          <ul class="nav nav-tabs border-0" id="templateWorkspaceTabs" role="tablist">
            <li class="nav-item">
              <button class="nav-link active fw-semibold" id="tab-builder-btn" data-tab="builder" type="button">
                <i class="ti ti-layout-grid me-1"></i>Builder
              </button>
            </li>
            <li class="nav-item">
              <button class="nav-link fw-semibold" id="tab-standard-values-btn" data-tab="standard-values" type="button">
                <i class="ti ti-forms me-1"></i>Standard Values
              </button>
            </li>
            <li class="nav-item">
              <button class="nav-link fw-semibold" id="tab-insert-options-btn" data-tab="insert-options" type="button">
                <i class="ti ti-file-plus me-1"></i>Insert Options
              </button>
            </li>
            <li class="nav-item">
              <button class="nav-link fw-semibold" id="tab-inheritance-btn" data-tab="inheritance" type="button">
                <i class="ti ti-git-fork me-1"></i>Inheritance
              </button>
            </li>
            <li class="nav-item">
              <button class="nav-link fw-semibold" id="tab-usage-btn" data-tab="usage" type="button">
                <i class="ti ti-chart-bar me-1"></i>Usage
              </button>
            </li>
          </ul>
        </div>

        <!-- Dynamic Tab Body Container -->
        <div class="flex-fill overflow-auto p-3" id="templateTabContent">
          <%- include('./partials/tab-builder', { template: activeTemplate, resolved: resolvedTemplate }) %>
        </div>
      <% } else { %>
        <div class="empty py-5 text-center">
          <div class="empty-icon text-muted"><i class="ti ti-layout-grid fs-1"></i></div>
          <p class="empty-title">No Template Selected</p>
          <p class="empty-subtitle text-muted">Select a template from the list on the left or create a new one.</p>
        </div>
      <% } %>
    </main>
  </div>
</div>

<!-- Modals -->
<%- include('./modals/template-modal', { activeTemplate }) %>
<%- include('./modals/section-modal') %>
<%- include('./modals/field-modal') %>
<%- include('./modals/preview-modal') %>

<script>
  window.__ACTIVE_TEMPLATE_ID__ = "<%= activeTemplate ? activeTemplate._id : '' %>";
  window.__ACTIVE_TEMPLATE_UPDATED_AT__ = "<%= activeTemplate && activeTemplate.updatedAt ? new Date(activeTemplate.updatedAt).toISOString() : '' %>";
</script>

<!-- SortableJS via CDN for Drag & Drop -->
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<!-- Template Manager Client Controller -->
<script type="module" src="/js/admin/template-manager.js"></script>

