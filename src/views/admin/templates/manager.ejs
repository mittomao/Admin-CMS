<%
  const activeTemplate = typeof selectedTemplate !== 'undefined' ? selectedTemplate : null;
  const tplList = typeof templates !== 'undefined' ? templates : [];
%>
<div class="template-manager-container d-flex flex-column flex flex-col h-100 h-full" style="min-height: calc(100vh - 120px);">
  <!-- 1. Template Manager Ribbon Toolbar -->
  <div class="ribbon-container border-bottom border-slate-200 bg-white shadow-xs select-none">
    <div class="d-flex align-items-center justify-content-between px-3 py-1.5 bg-slate-50/80 border-b border-slate-200 flex items-center justify-between">
      <div class="d-flex align-items-center gap-2 flex items-center gap-2">
        <div class="w-7 h-7 rounded-md bg-indigo-50 border border-indigo-100 flex items-center justify-center text-primary">
          <i class="ti ti-layout-grid-add text-base"></i>
        </div>
        <span class="fw-bold text-uppercase font-monospace text-slate-800 text-xs font-semibold tracking-wider">
          Template Manager
        </span>
      </div>
      <div class="d-flex align-items-center gap-2 flex items-center gap-2">
        <span id="tplDirtyIndicator" class="badge bg-amber-50 text-amber-700 border border-amber-200/80 font-mono text-xs px-2.5 py-1 rounded-md d-none flex items-center gap-1">
          <i class="ti ti-pencil me-1"></i>Unsaved Changes
        </span>
        <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-1.5 inline-flex items-center px-3.5 py-1.5 text-xs font-semibold rounded-md shadow-xs transition-all duration-150 active:scale-95 hover:shadow-sm focus:ring-2 focus:ring-primary/40 focus:outline-none cursor-pointer" id="btnSaveTemplate">
          <i class="ti ti-device-floppy text-sm"></i>
          <span>Save (Ctrl+S)</span>
        </button>
      </div>
    </div>

    <!-- Ribbon Action Toolbar -->
    <div class="d-flex align-items-stretch flex-wrap gap-2.5 p-2 bg-slate-50/50 flex items-stretch">
      <!-- Group: Template Operations -->
      <div class="ribbon-group d-flex flex-column justify-content-between px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg shadow-2xs">
        <div class="d-flex align-items-center gap-1.5 flex items-center">
          <button
            type="button"
            class="btn btn-outline-secondary ribbon-btn-large d-flex flex-column align-items-center justify-content-center p-1.5 rounded-md border border-slate-200 bg-white hover:bg-slate-50 hover:border-slate-300 text-slate-700 transition-all duration-150 active:scale-95"
            id="btnNewTemplate"
            title="Create a new template"
            style="min-width: 58px; height: 54px; font-size: 0.75rem;"
          >
            <i class="ti ti-plus fs-2 mb-0.5 text-primary"></i>
            <span class="font-medium text-[11px]">New</span>
          </button>
          <button
            type="button"
            class="btn btn-outline-secondary ribbon-btn-large d-flex flex-column align-items-center justify-content-center p-1.5 rounded-md border border-slate-200 bg-white hover:bg-slate-50 hover:border-slate-300 text-slate-700 transition-all duration-150 active:scale-95 disabled:opacity-40 disabled:pointer-events-none"
            id="btnDuplicateTemplate"
            <%= !activeTemplate ? 'disabled' : '' %>
            title="Duplicate current template"
            style="min-width: 58px; height: 54px; font-size: 0.75rem;"
          >
            <i class="ti ti-copy fs-2 mb-0.5 text-sky-600"></i>
            <span class="font-medium text-[11px]">Duplicate</span>
          </button>
          <button
            type="button"
            class="btn btn-outline-secondary ribbon-btn-large d-flex flex-column align-items-center justify-content-center p-1.5 rounded-md border border-slate-200 bg-white hover:bg-rose-50 hover:border-rose-200 hover:text-rose-600 text-slate-700 transition-all duration-150 active:scale-95 disabled:opacity-40 disabled:pointer-events-none"
            id="btnDeleteTemplate"
            <%= (!activeTemplate || activeTemplate.isSystem) ? 'disabled' : '' %>
            title="<%= activeTemplate && activeTemplate.isSystem ? 'System templates cannot be deleted' : 'Delete template' %>"
            style="min-width: 58px; height: 54px; font-size: 0.75rem;"
          >
            <i class="ti ti-trash fs-2 mb-0.5 text-rose-500"></i>
            <span class="font-medium text-[11px]">Delete</span>
          </button>
        </div>
        <div class="ribbon-group-title text-center text-slate-400 border-top border-slate-100 mt-1 pt-0.5 text-[10px] uppercase font-mono tracking-wider">
          Template
        </div>
      </div>

      <!-- Group: Schema Elements -->
      <div class="ribbon-group d-flex flex-column justify-content-between px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg shadow-2xs">
        <div class="d-flex align-items-center gap-1.5 flex items-center">
          <button
            type="button"
            class="btn btn-outline-secondary ribbon-btn-large d-flex flex-column align-items-center justify-content-center p-1.5 rounded-md border border-slate-200 bg-white hover:bg-slate-50 hover:border-slate-300 text-slate-700 transition-all duration-150 active:scale-95 disabled:opacity-40 disabled:pointer-events-none"
            id="btnAddSection"
            <%= !activeTemplate ? 'disabled' : '' %>
            title="Add section to current template"
            style="min-width: 58px; height: 54px; font-size: 0.75rem;"
          >
            <i class="ti ti-layout-navbar-expand fs-2 mb-0.5 text-indigo-600"></i>
            <span class="font-medium text-[11px]">Add Section</span>
          </button>
          <button
            type="button"
            class="btn btn-outline-secondary ribbon-btn-large d-flex flex-column align-items-center justify-content-center p-1.5 rounded-md border border-slate-200 bg-white hover:bg-slate-50 hover:border-slate-300 text-slate-700 transition-all duration-150 active:scale-95 disabled:opacity-40 disabled:pointer-events-none"
            id="btnAddField"
            <%= !activeTemplate ? 'disabled' : '' %>
            title="Add field to current template"
            style="min-width: 58px; height: 54px; font-size: 0.75rem;"
          >
            <i class="ti ti-forms fs-2 mb-0.5 text-emerald-600"></i>
            <span class="font-medium text-[11px]">Add Field</span>
          </button>
        </div>
        <div class="ribbon-group-title text-center text-slate-400 border-top border-slate-100 mt-1 pt-0.5 text-[10px] uppercase font-mono tracking-wider">
          Elements
        </div>
      </div>

      <!-- Group: View & Preview -->
      <div class="ribbon-group d-flex flex-column justify-content-between px-2.5 py-1.5 bg-white border border-slate-200 rounded-lg shadow-2xs">
        <div class="d-flex align-items-center gap-1.5 flex items-center">
          <button
            type="button"
            class="btn btn-outline-secondary ribbon-btn-large d-flex flex-column align-items-center justify-content-center p-1.5 rounded-md border border-slate-200 bg-white hover:bg-slate-50 hover:border-slate-300 text-slate-700 transition-all duration-150 active:scale-95 disabled:opacity-40 disabled:pointer-events-none"
            id="btnPreviewForm"
            <%= !activeTemplate ? 'disabled' : '' %>
            title="Preview how items of this template render in Content Editor"
            style="min-width: 58px; height: 54px; font-size: 0.75rem;"
          >
            <i class="ti ti-eye fs-2 mb-0.5 text-purple-600"></i>
            <span class="font-medium text-[11px]">Preview</span>
          </button>
        </div>
        <div class="ribbon-group-title text-center text-slate-400 border-top border-slate-100 mt-1 pt-0.5 text-[10px] uppercase font-mono tracking-wider">
          Validation
        </div>
      </div>
    </div>
  </div>

  <!-- 2. Main 3-Pane Layout (Left Templates List + Center Workspace Tabs) -->
  <div class="d-flex flex-fill overflow-hidden border-top border-slate-200 flex-1 flex">
    <!-- Left Pane: Templates Tree / Directory -->
    <aside
      class="template-sidebar bg-white border-end border-slate-200 d-flex flex-column flex-shrink-0 flex flex-col w-[300px] min-w-[250px] max-w-[450px]"
    >
      <div class="p-2.5 border-bottom border-slate-200 bg-slate-50/60">
        <div class="input-icon relative">
          <span class="input-icon-addon absolute inset-y-0 left-0 pl-2.5 flex items-center pointer-events-none">
            <i class="ti ti-search text-slate-400 text-sm"></i>
          </span>
          <input
            type="text"
            class="form-control form-control-sm pl-8 pr-3 py-1.5 text-xs rounded-md border-slate-200 shadow-2xs focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-150 w-full"
            id="templateSearchInput"
            placeholder="Search templates..."
            autocomplete="off"
          />
        </div>
      </div>

      <div class="px-3 py-2 border-bottom border-slate-200 bg-white d-flex align-items-center justify-content-between flex items-center justify-between text-muted small">
        <span class="fw-semibold text-uppercase font-mono text-[11px] text-slate-500 font-bold tracking-wider">Templates (<%= tplList.length %>)</span>
        <span class="badge bg-slate-100 text-slate-600 border border-slate-200 font-mono text-[10px] px-2 py-0.5 rounded">System & Custom</span>
      </div>

      <div class="list-group list-group-flush overflow-auto flex-fill p-2 space-y-1" id="templateListContainer">
        <% tplList.forEach(t => { %>
          <%
            const isSelected = activeTemplate && activeTemplate._id.toString() === t._id.toString();
          %>
          <a
            href="/admin/template-manager/<%= t._id %>"
            class="list-group-item list-group-item-action py-2 px-2.5 rounded-lg border transition-all duration-150 template-nav-item block text-decoration-none <%= isSelected ? 'active bg-primary/10 border-primary/40 text-primary shadow-xs font-semibold' : 'border-transparent hover:bg-slate-100/70 hover:border-slate-200 text-slate-700' %>"
            data-template-id="<%= t._id %>"
            data-template-name="<%= t.name.toLowerCase() %>"
            data-template-display="<%= (t.displayName || '').toLowerCase() %>"
          >
            <div class="d-flex align-items-center justify-content-between flex items-center justify-between gap-2">
              <div class="d-flex align-items-center gap-2 text-truncate flex items-center gap-2 truncate">
                <i class="<%= t.icon || 'ti ti-file-text' %> fs-2 text-base <%= isSelected ? 'text-primary' : 'text-slate-500' %>"></i>
                <div class="text-truncate truncate">
                  <div class="fw-semibold text-truncate text-xs truncate leading-snug"><%= t.displayName || t.name %></div>
                  <div class="small font-monospace opacity-75 font-mono text-[10px] text-slate-400 truncate"><%= t.name %></div>
                </div>
              </div>
              <% if (t.isSystem) { %>
                <span class="badge font-mono text-[10px] px-1.5 py-0.5 rounded <%= isSelected ? 'bg-primary text-white' : 'bg-slate-100 text-slate-500' %>">Sys</span>
              <% } %>
            </div>
          </a>
        <% }) %>
      </div>
    </aside>

    <!-- Center Workspace Pane: Tabs (Builder, Standard Values, Insert Options, Inheritance, Usage) -->
    <main class="template-workspace flex-fill d-flex flex-column bg-slate-50 overflow-hidden flex-1 flex flex-col">
      <% if (activeTemplate) { %>
        <!-- Header: Template Overview & Tab Switcher -->
        <div class="bg-white border-bottom border-slate-200 px-4 pt-3 pb-0 shadow-2xs">
          <div class="d-flex align-items-center justify-content-between mb-3 flex items-center justify-between">
            <div class="d-flex align-items-center gap-3 flex items-center gap-3">
              <span class="avatar avatar-md rounded-xl bg-indigo-50 border border-indigo-100 text-primary w-11 h-11 flex items-center justify-center">
                <i class="<%= activeTemplate.icon || 'ti ti-file-text' %> text-xl"></i>
              </span>
              <div>
                <div class="d-flex align-items-center gap-2 flex items-center gap-2">
                  <h3 class="m-0 fw-bold fs-2 text-slate-900 text-lg tracking-tight"><%= activeTemplate.displayName || activeTemplate.name %></h3>
                  <span class="badge bg-slate-100 text-slate-600 border border-slate-200 font-mono text-xs px-2 py-0.5 rounded"><%= activeTemplate.name %></span>
                  <% if (activeTemplate.isSystem) { %>
                    <span class="badge bg-sky-50 text-sky-700 border border-sky-200 font-medium text-xs px-2 py-0.5 rounded flex items-center gap-1"><i class="ti ti-lock me-1"></i>System</span>
                  <% } %>
                </div>
                <div class="text-muted small mt-0.5 text-xs text-slate-500"><%= activeTemplate.description || 'No description provided.' %></div>
              </div>
            </div>

            <button type="button" class="btn btn-sm btn-outline-secondary inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-md border border-slate-300 hover:bg-slate-50 transition-all duration-150 active:scale-95" id="btnEditTemplateMeta">
              <i class="ti ti-pencil me-1"></i>Edit Details
            </button>
          </div>

          <!-- Tab Navigation -->
          <ul class="nav nav-tabs border-0 flex items-center gap-1" id="templateWorkspaceTabs" role="tablist">
            <li class="nav-item">
              <button class="nav-link active fw-semibold px-3 py-2 text-xs font-semibold rounded-t-lg transition-all duration-150 hover:bg-slate-50 border-b-2" id="tab-builder-btn" data-tab="builder" type="button">
                <i class="ti ti-layout-grid me-1"></i>Builder
              </button>
            </li>
            <li class="nav-item">
              <button class="nav-link fw-semibold px-3 py-2 text-xs font-semibold rounded-t-lg transition-all duration-150 hover:bg-slate-50 border-b-2" id="tab-standard-values-btn" data-tab="standard-values" type="button">
                <i class="ti ti-forms me-1"></i>Standard Values
              </button>
            </li>
            <li class="nav-item">
              <button class="nav-link fw-semibold px-3 py-2 text-xs font-semibold rounded-t-lg transition-all duration-150 hover:bg-slate-50 border-b-2" id="tab-insert-options-btn" data-tab="insert-options" type="button">
                <i class="ti ti-file-plus me-1"></i>Insert Options
              </button>
            </li>
            <li class="nav-item">
              <button class="nav-link fw-semibold px-3 py-2 text-xs font-semibold rounded-t-lg transition-all duration-150 hover:bg-slate-50 border-b-2" id="tab-inheritance-btn" data-tab="inheritance" type="button">
                <i class="ti ti-git-fork me-1"></i>Inheritance
              </button>
            </li>
            <li class="nav-item">
              <button class="nav-link fw-semibold px-3 py-2 text-xs font-semibold rounded-t-lg transition-all duration-150 hover:bg-slate-50 border-b-2" id="tab-usage-btn" data-tab="usage" type="button">
                <i class="ti ti-chart-bar me-1"></i>Usage
              </button>
            </li>
          </ul>
        </div>

        <!-- Dynamic Tab Body Container -->
        <div class="flex-fill overflow-auto p-4 flex-1" id="templateTabContent">
          <%- include('./partials/tab-builder', { template: activeTemplate, resolved: resolvedTemplate }) %>
        </div>
      <% } else { %>
        <div class="empty py-16 text-center flex-1 flex flex-col items-center justify-center">
          <div class="empty-icon text-slate-300 mb-3"><i class="ti ti-layout-grid text-5xl"></i></div>
          <p class="empty-title text-base font-bold text-slate-700 m-0">No Template Selected</p>
          <p class="empty-subtitle text-xs text-slate-500 mt-1 max-w-sm">Select a template from the list on the left or create a new one.</p>
        </div>
      <% } %>
    </main>
  </div>
</div>

<!-- Modals -->
<%- include('./modals/template-modal', { activeTemplate }) %>
<%- include('./modals/section-modal') %>
<%- include('./modals/field-modal') %>
<%- include('./modals/preview-modal') %>

<script>
  window.__ACTIVE_TEMPLATE_ID__ = "<%= activeTemplate ? activeTemplate._id : '' %>";
  window.__ACTIVE_TEMPLATE_UPDATED_AT__ = "<%= activeTemplate && activeTemplate.updatedAt ? new Date(activeTemplate.updatedAt).toISOString() : '' %>";
</script>

<!-- SortableJS via CDN for Drag & Drop -->
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
<!-- Template Manager Client Controller -->
<script type="module" src="/js/admin/template-manager.js"></script>

