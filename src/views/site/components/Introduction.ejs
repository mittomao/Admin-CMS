<section class="intro-section" style="padding: 3rem 0; background: #fff;">
  <div class="container">
    <% if (fields && fields.IntroHeading) { %>
      <h2 class="intro-heading" style="font-size: 2rem; margin-bottom: 1.25rem; color: #1e293b;"><%= fields.IntroHeading %></h2>
    <% } %>
    <% if (fields && fields.IntroBody) { %>
      <div class="intro-body" style="font-size: 1.1rem; color: #334155; line-height: 1.8;">
        <%- fields.IntroBody %>
      </div>
    <% } %>
  </div>
</section>

