<!DOCTYPE html>
<html lang="vi" class="h-full">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>500 - Lỗi Máy Chủ | Treecraft</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/site/css/tailwind.css">
</head>
<body class="h-full bg-slate-50 flex items-center justify-center p-4 font-sans text-slate-800 antialiased">
  <div class="max-w-lg w-full bg-white rounded-2xl shadow-xl border border-slate-100 p-8 text-center">
    <div class="w-16 h-16 mx-auto mb-6 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center shadow-inner">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
    </div>
    <span class="text-xs font-bold uppercase tracking-wider text-amber-600">Lỗi 500</span>
    <h1 class="text-2xl font-extrabold text-slate-900 mt-2 mb-3">Lỗi Máy Chủ Nội Bộ</h1>
    <p class="text-sm text-slate-500 mb-6 leading-relaxed">
      <%= typeof message !== 'undefined' ? message : 'Đã xảy ra sự cố trong quá trình kết xuất trang web. Vui lòng thử lại sau.' %>
    </p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="text-left bg-slate-900 text-slate-200 p-4 rounded-xl text-xs font-mono mb-6 overflow-x-auto max-h-48 border border-slate-800">
        <p class="text-red-400 font-bold mb-1"><%= error.name %>: <%= error.message %></p>
        <pre class="text-[11px] text-slate-400 leading-normal"><%= error.stack %></pre>
      </div>
    <% } %>

    <a href="/" class="inline-flex items-center justify-center w-full px-5 py-3 text-sm font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-xl shadow transition duration-200">
      Quay về Trang chủ
    </a>
  </div>
</body>
</html>

