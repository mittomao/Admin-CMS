<!DOCTYPE html>
<html lang="<%= lang || 'vi' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= (fields && (fields.HeroTitle || fields.PageTitle)) || (item && (item.displayName || item.name)) || 'Sitecore CMS' %></title>
  <link rel="stylesheet" href="/site/css/style.css">
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; margin: 0; padding: 0; color: #333; line-height: 1.6; }
    .site-header { background: #206bc4; color: white; padding: 1rem 2rem; }
    .site-main { min-height: 60vh; }
    .site-footer { background: #1e293b; color: #94a3b8; padding: 2rem; text-align: center; }
    .container { max-width: 1140px; margin: 0 auto; padding: 0 15px; }
  </style>
</head>
<body>
  <header class="site-header">
    <div class="container">
      <%- placeholder('header') %>
    </div>
  </header>

  <main class="site-main">
    <%- placeholder('maincontent') %>
  </main>

  <footer class="site-footer">
    <div class="container">
      <%- placeholder('footer') %>
      <p class="copyright m-0 small">&copy; <%= new Date().getFullYear() %> Sitecore XM Monolithic CMS. Rendered with EJS SSR.</p>
    </div>
  </footer>
</body>
</html>

