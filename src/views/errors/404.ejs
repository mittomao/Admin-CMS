<div class="sc-error-container">
  <div class="sc-error-badge">404</div>
  <h1 class="sc-error-title">Item or Page Not Found</h1>
  <p class="sc-error-desc">
    The requested item or URL <code><%= currentPath %></code> could not be found in the current content database. It may have been moved, renamed, or deleted.
  </p>
  <div>
    <a href="/admin/launchpad" class="sc-btn sc-btn--primary">Return to Launchpad</a>
    <a href="/admin/content-editor" class="sc-btn sc-btn--secondary" style="margin-left: 8px;">Content Editor</a>
  </div>
</div>
