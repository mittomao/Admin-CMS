<div class="sc-launchpad-container">
  <!-- Group 1: Content Editing -->
  <div class="sc-launchpad-group">
    <h2 class="sc-launchpad-group-title">Content Editing</h2>
    <div class="sc-launchpad-grid">
      <a href="/admin/content-editor" class="sc-tile">
        <div class="sc-tile-icon-box sc-tile-icon-box--blue">📑</div>
        <div class="sc-tile-content">
          <div class="sc-tile-title">Content Editor</div>
          <div class="sc-tile-desc">Manage hierarchical content tree and item fields</div>
        </div>
      </a>
      
      <div class="sc-tile" onclick="alert('Experience Editor is planned for future phases');">
        <div class="sc-tile-icon-box sc-tile-icon-box--indigo">🖥️</div>
        <div class="sc-tile-content">
          <div class="sc-tile-title">Experience Editor</div>
          <div class="sc-tile-desc">WYSIWYG live page layout editing</div>
        </div>
      </div>

      <div class="sc-tile" onclick="alert('Media Library will be implemented in GĐ 5');">
        <div class="sc-tile-icon-box sc-tile-icon-box--green">🖼️</div>
        <div class="sc-tile-content">
          <div class="sc-tile-title">Media Library</div>
          <div class="sc-tile-desc">Upload, organize and manage digital assets</div>
        </div>
      </div>

      <div class="sc-tile" onclick="alert('Workbox will be implemented in GĐ 7');">
        <div class="sc-tile-icon-box sc-tile-icon-box--amber">📥</div>
        <div class="sc-tile-content">
          <div class="sc-tile-title">Workbox</div>
          <div class="sc-tile-desc">Review and approve workflow items</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Group 2: Access Management -->
  <div class="sc-launchpad-group">
    <h2 class="sc-launchpad-group-title">Access Management</h2>
    <div class="sc-launchpad-grid">
      <div class="sc-tile" onclick="alert('User Manager will be implemented in GĐ 6');">
        <div class="sc-tile-icon-box sc-tile-icon-box--purple">👥</div>
        <div class="sc-tile-content">
          <div class="sc-tile-title">User Manager</div>
          <div class="sc-tile-desc">Create and manage administrator and editor accounts</div>
        </div>
      </div>

      <div class="sc-tile" onclick="alert('Role Manager will be implemented in GĐ 6');">
        <div class="sc-tile-icon-box sc-tile-icon-box--purple">🛡️</div>
        <div class="sc-tile-content">
          <div class="sc-tile-title">Role Manager</div>
          <div class="sc-tile-desc">Define user roles and group permissions</div>
        </div>
      </div>

      <div class="sc-tile" onclick="alert('Access Viewer will be implemented in GĐ 6');">
        <div class="sc-tile-icon-box sc-tile-icon-box--purple">🔍</div>
        <div class="sc-tile-content">
          <div class="sc-tile-title">Access Viewer</div>
          <div class="sc-tile-desc">Inspect item-level security and permission inheritance</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Group 3: Control Panel & Tools -->
  <div class="sc-launchpad-group">
    <h2 class="sc-launchpad-group-title">Control Panel & Maintenance</h2>
    <div class="sc-launchpad-grid">
      <div class="sc-tile" onclick="alert('Control Panel will be implemented in GĐ 10');">
        <div class="sc-tile-icon-box sc-tile-icon-box--rose">⚙️</div>
        <div class="sc-tile-content">
          <div class="sc-tile-title">Control Panel</div>
          <div class="sc-tile-desc">Configure database, rebuild indexes, and system settings</div>
        </div>
      </div>

      <div class="sc-tile" onclick="alert('Recycle Bin will be implemented in GĐ 8');">
        <div class="sc-tile-icon-box sc-tile-icon-box--rose">🗑️</div>
        <div class="sc-tile-content">
          <div class="sc-tile-title">Recycle Bin</div>
          <div class="sc-tile-desc">Restore or permanently delete removed items</div>
        </div>
      </div>

      <div class="sc-tile" onclick="alert('Audit Log will be implemented in GĐ 8');">
        <div class="sc-tile-icon-box sc-tile-icon-box--amber">📜</div>
        <div class="sc-tile-content">
          <div class="sc-tile-title">Audit Log</div>
          <div class="sc-tile-desc">Track author actions, publish history, and changes</div>
        </div>
      </div>
    </div>
  </div>
</div>
