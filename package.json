{
  "name": "admin-cms",
  "version": "1.0.0",
  "description": "Sitecore-like Hierarchical XM Content Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "format": "prettier --write \"src/**/*.{js,json,ejs}\" \"public/**/*.{css,js}\"",
    "test": "jest --detectOpenHandles --forceExit",
    "seed": "node src/scripts/seed-initial-data.js",
    "seed:presentation": "node src/scripts/seed-presentation-data.js",
    "media:sync": "node scripts/sync-cloudinary-media.js",
    "migrate": "node src/scripts/migrate-to-versions-languages.js",
    "migrate:field-ids": "node src/scripts/migrate-to-field-ids.js"
  },
  "keywords": [
    "cms",
    "sitecore",
    "express",
    "ejs",
    "mongodb",
    "content-management"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.7.5",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sanitize-html": "2.13.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testTimeout": 60000
  }
}
