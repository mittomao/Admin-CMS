# Application Configuration
NODE_ENV=development
PORT=3000
APP_NAME="Sitecore XM CMS"
APP_URL=http://localhost:3000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/sitecore_cms_master

# Session Configuration (Will be used in GĐ 1)
SESSION_SECRET=sitecore_cms_super_secret_session_key_2026
SESSION_NAME=cms_session_id
SESSION_MAX_AGE=86400000

# Logging
LOG_LEVEL=debug

# Storage & Cloudinary Configuration (GĐ 5.1 & DEC-038)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_ROOT_FOLDER=AdminCMS

# Public Site Renderer & Cache Configuration (GĐ 10)
SITE_START_ITEM=/sitecore/content/Home
SITE_CACHE=true
SITE_CACHE_TTL=300
SITE_CACHE_MAX_ITEMS=500


