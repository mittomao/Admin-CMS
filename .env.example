# ==============================================================================
# TREECRAFT CMS - TỆP CẤU HÌNH MẪU CHUẨN HOÁ (.env.example)
#
# HƯỚNG DẪN SỬ DỤNG:
# 1. Sao chép tệp này thành .env:
#      cp .env.example .env
# 2. File .env là file cấu hình chính (Base Config) chứa toàn bộ thiết lập hệ thống.
#    Bạn có thể thay đổi môi trường trực tiếp trên file .env (ví dụ: APP_ENV=development).
# 3. GHI ĐÈ THEO MÔI TRƯỜNG (Tuỳ chọn):
#    Nếu cần cấu hình riêng cho môi trường khác (Staging / Production), bạn chỉ cần tạo
#    thêm tệp nhỏ tương ứng (ví dụ: .env.staging hoặc .env.production) và CHỈ KHAI BÁO
#    những biến cần ghi đè (như MONGO_URI, CLOUDINARY_ROOT_FOLDER...).
#    Hệ thống sẽ tự động nạp .env trước, sau đó nạp đè .env.${APP_ENV} lên.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Định danh và Môi trường Hệ thống
# ------------------------------------------------------------------------------
# APP_ENV chỉ nhận một trong 3 giá trị: development | staging | production
APP_ENV=development
NODE_ENV=development
PORT=3000
APP_NAME="Treecraft CMS"
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Cơ sở dữ liệu MongoDB (DEC-052 & dbGuard)
# ------------------------------------------------------------------------------
# QUY TẮC BẤT BIẾN: Tên database luôn là "admin_cms" ở mọi môi trường.
# - Môi trường development mặc định dùng MongoDB 8.0 Local Docker (rs0):
MONGO_URI=mongodb://127.0.0.1:27017/admin_cms?replicaSet=rs0
# - Để tạm thời kết nối Cloud trong dev (CÓ CẢNH BÁO VÀ CHỐT CHẶN):
ALLOW_REMOTE_DB_IN_DEV=false

# ------------------------------------------------------------------------------
# 3. Quản lý Phiên làm việc (Session Management)
# ------------------------------------------------------------------------------
SESSION_SECRET=treecraft_default_secret_session_key_2026
SESSION_NAME=treecraft_session_id
SESSION_MAX_AGE=86400000

# ------------------------------------------------------------------------------
# 4. Ghi Nhật ký (Logging)
# ------------------------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 5. Lưu trữ Tài nguyên Cloudinary (GĐ 5.1 & DEC-038)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Phân vùng thư mục: AdminCMS-dev (cho dev), AdminCMS-uat (cho staging), AdminCMS (cho prod)
CLOUDINARY_ROOT_FOLDER=AdminCMS-dev

# ------------------------------------------------------------------------------
# 6. Public Site Renderer & Bộ nhớ đệm (GĐ 10)
# ------------------------------------------------------------------------------
SITE_START_ITEM=/root/content/Home
# Ở local dev nên để false để thấy ngay thay đổi layout EJS; ở prod đặt true
SITE_CACHE=false
SITE_CACHE_TTL=300
SITE_CACHE_MAX_ITEMS=500

# ------------------------------------------------------------------------------
# 7. Chính sách Lưu trữ Thùng rác & Nhật ký Kiểm toán (GĐ 9)
# ------------------------------------------------------------------------------
RECYCLE_BIN_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# 8. Xác thực Cơ bản (Basic Auth - GĐ B1 & DEC-046/DEC-050)
# ------------------------------------------------------------------------------
# Đặt true để bật Basic Auth bảo vệ toàn bộ site
BASIC_AUTH_ENABLED=false
BASIC_AUTH_REALM="Treecraft CMS"
# Đặt true nếu chạy sau Reverse Proxy (Nginx, Cloudflare)
TRUST_PROXY=false

# ------------------------------------------------------------------------------
# 9. Sao lưu & Phục hồi Cơ sở dữ liệu (GĐ K1 / DEC-051)
# ------------------------------------------------------------------------------
BACKUP_DIR=./storage/backups
BACKUP_ENCRYPTION_KEY=your_secret_32_chars_backup_key
BACKUP_RETENTION_COUNT=7
BACKUP_RETENTION_DAYS=30
MONGODUMP_PATH=mongodump
MONGORESTORE_PATH=mongorestore
# Chế độ bảo trì khẩn cấp (true | false)
MAINTENANCE_MODE=false
