# Application Configuration
NODE_ENV=development
PORT=3000
APP_NAME="Treecraft"
APP_URL=http://localhost:3000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/cms_master

# Session Configuration (Will be used in GĐ 1)
SESSION_SECRET=cms_super_secret_session_key_2026
SESSION_NAME=cms_session_id
SESSION_MAX_AGE=86400000

# Logging
LOG_LEVEL=debug

# Storage & Cloudinary Configuration (GĐ 5.1 & DEC-038)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_ROOT_FOLDER=AdminCMS

# Public Site Renderer & Cache Configuration (GĐ 10)
SITE_START_ITEM=/root/content/Home
SITE_CACHE=true
SITE_CACHE_TTL=300
SITE_CACHE_MAX_ITEMS=500

# Basic Authentication Configuration (GĐ B1)
# Set to 'false' to emergency override and disable Basic Auth regardless of database
# BASIC_AUTH_ENABLED=false
# BASIC_AUTH_REALM="Treecraft"
# Set to 'true' or '1' if behind reverse proxy (Nginx, Cloudflare)
# TRUST_PROXY=false

# Backup & Restore Configuration (GĐ K1)
BACKUP_DIR=./storage/backups
BACKUP_ENCRYPTION_KEY=your_secret_32_chars_backup_key
BACKUP_RETENTION_COUNT=7
BACKUP_RETENTION_DAYS=30
MONGODUMP_PATH=mongodump
MONGORESTORE_PATH=mongorestore
# Emergency Maintenance Override (true / false)
MAINTENANCE_MODE=false




